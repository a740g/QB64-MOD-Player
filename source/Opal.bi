$INCLUDEONCE

CONST OPAL_OPL3_SAMPLE_RATE = 49716
CONST OPAL_CHANNEL_COUNT = 18
CONST OPAL_OPERATOR_COUNT = 36

CONST OPAL_WRITEBUF_SIZE = 4096
CONST OPAL_WRITEBUF_DELAY = 2

' Sentinel values
CONST OPAL_OP_NONE~%% = 255~%%
CONST OPAL_MOD_OWN_FB~%% = 254~%%
CONST OPAL_CH_NONE~%% = 255~%%

' Envelope stages
CONST OPAL_ENVELOPE_STAGE_OFF = -1
CONST OPAL_ENVELOPE_STAGE_ATTACK = 0
CONST OPAL_ENVELOPE_STAGE_DECAY = 1
CONST OPAL_ENVELOPE_STAGE_SUSTAIN = 2
CONST OPAL_ENVELOPE_STAGE_RELEASE = 3

' Channel types
CONST OPAL_CHANNEL_TYPE_2OP = 0
CONST OPAL_CHANNEL_TYPE_4OP = 1
CONST OPAL_CHANNEL_TYPE_4OP2 = 2
CONST OPAL_CHANNEL_TYPE_DRUM = 3

' Internal constants
CONST __OPAL_CHANNELS_PER_BANK = 9
CONST __OPAL_OPERATORS_PER_BANK = 18
CONST __OPAL_PAIRS_PER_BANK = 3
CONST __OPAL_VOICE_STRIDE = 3
CONST __OPAL_LEFT_SUM_SLOT = 14
CONST __OPAL_RIGHT_SUM_SLOT = 32
CONST __OPAL_BASS_DRUM_CHANNEL = 6
CONST __OPAL_RHYTHM_FIRST_SLOT = 12
CONST __OPAL_HI_HAT_SLOT = 13
CONST __OPAL_SNARE_SLOT = 16
CONST __OPAL_CYMBAL_SLOT = 17
CONST __OPAL_HI_HAT_PHASE_NOISY = &HD0~%
CONST __OPAL_HI_HAT_PHASE_QUIET = &H34~%
CONST __OPAL_CYMBAL_PHASE = &H80~%
CONST __OPAL_NEW_REGISTER = &H105~%
CONST __OPAL_FOUR_OP_REGISTER = &H104~%
CONST __OPAL_RHYTHM_REGISTER = &HBD~%
CONST __OPAL_PAIR_ENABLE_MASK = &H3F~%
CONST __OPAL_OUTPUT_BOTH_SIDES = 3
CONST __OPAL_WAVEFORM_MASK_NEW = 7
CONST __OPAL_WAVEFORM_MASK_OPL2 = 3
CONST __OPAL_ENVELOPE_SILENT = 511
CONST __OPAL_ENVELOPE_OFF_ZONE = 504
CONST __OPAL_ENVELOPE_PERIOD = 68719476735~&&
CONST __OPAL_RATE_FAST = 48
CONST __OPAL_RATE_INSTANT = 60
CONST __OPAL_TREMOLO_STEPS = 210
CONST __OPAL_TREMOLO_PEAK = 105
CONST __OPAL_AUDIBLE_LEVEL_LIMIT = 3072
CONST __OPAL_EXPONENT_IMPLICIT_ONE = 1024
CONST __OPAL_FULL_GAIN = 256

' Algorithm indices
CONST __OPAL_ALGORITHM_FM = 0
CONST __OPAL_ALGORITHM_ADDITIVE = 1
CONST __OPAL_ALGORITHM_CHAIN = 2
CONST __OPAL_ALGORITHM_TWO_PAIRS = 3
CONST __OPAL_ALGORITHM_SOLO_CHAIN = 4
CONST __OPAL_ALGORITHM_SOLO_PAIR = 5
CONST __OPAL_ALGORITHM_KICK_FM = 6
CONST __OPAL_ALGORITHM_KICK_DIRECT = 7
CONST __OPAL_ALGORITHM_PERCUSSION = 8
CONST __OPAL_ALGORITHM_COUNT = 9

TYPE __OpalOperator
    envelopeStage AS LONG
    egOut AS _UNSIGNED INTEGER
    key AS _UNSIGNED _BYTE
    modSource AS _UNSIGNED _BYTE
    out AS INTEGER
    prevOut AS INTEGER
    phase AS _UNSIGNED LONG
    envelope AS _UNSIGNED INTEGER
    tremolo AS _UNSIGNED _BYTE
    vibrato AS _UNSIGNED _BYTE
    sustainHold AS _UNSIGNED _BYTE
    keyScaleRate AS _UNSIGNED _BYTE
    multiple AS _UNSIGNED _BYTE
    keyScaleLevel AS _UNSIGNED _BYTE
    totalLevel AS _UNSIGNED _BYTE
    attackRate AS _UNSIGNED _BYTE
    decayRate AS _UNSIGNED _BYTE
    sustainLevel AS _UNSIGNED _BYTE
    releaseRate AS _UNSIGNED _BYTE
    waveform AS _UNSIGNED _BYTE
END TYPE

TYPE __OpalChannel
    opSlot(0 TO 3) AS _UNSIGNED _BYTE
    pairIndex AS _UNSIGNED _BYTE
    outSource(0 TO 3) AS _UNSIGNED _BYTE
    chanType AS LONG
    leftPan AS _UNSIGNED INTEGER
    rightPan AS _UNSIGNED INTEGER
    fNumber AS _UNSIGNED INTEGER
    block AS _UNSIGNED _BYTE
    latchedKeyScaleNumber AS _UNSIGNED _BYTE
    feedback AS _UNSIGNED _BYTE
    connection AS _UNSIGNED _BYTE
    outputEnable AS _UNSIGNED _BYTE
    algorithm AS _UNSIGNED _BYTE
END TYPE

TYPE __OpalQueuedWrite
    due AS _UNSIGNED _INTEGER64
    regNum AS _UNSIGNED INTEGER
    value AS _UNSIGNED _BYTE
END TYPE

TYPE __OpalEnvelopeTime
    odd AS _BYTE
    count AS _UNSIGNED _INTEGER64
END TYPE

TYPE __OpalAlgorithm
    operatorCount AS _UNSIGNED _BYTE
    chainMask AS _UNSIGNED _BYTE
    carrierMask AS _UNSIGNED _BYTE
    gain AS _UNSIGNED _BYTE
    selfFeedback AS _BYTE
END TYPE

TYPE __OpalWave
    attenuation AS _UNSIGNED INTEGER
    negative AS _BYTE
    silent AS _BYTE
END TYPE

TYPE __OpalVibratoStep
    halves AS _UNSIGNED _BYTE
    negative AS _BYTE
END TYPE

TYPE Opal
    sampleRate AS LONG
    sampleAccum AS LONG
    lastOutput(0 TO 1) AS INTEGER
    currOutput(0 TO 1) AS INTEGER
    chan(0 TO 17) AS __OpalChannel
    op(0 TO 35) AS __OpalOperator
    timer(0 TO 1) AS _UNSIGNED _BYTE
    timerControl AS _UNSIGNED _BYTE
    timerCount(0 TO 1) AS _UNSIGNED INTEGER
    status AS _UNSIGNED _BYTE
    newMode AS _UNSIGNED _BYTE
    pairEnable AS _UNSIGNED _BYTE
    rhythmMode AS _UNSIGNED _BYTE
    noteSelect AS _UNSIGNED _BYTE
    tremoloDepth AS _UNSIGNED _BYTE
    vibratoDepth AS _UNSIGNED _BYTE
    waveSelectEnable AS _UNSIGNED _BYTE
    compositeSine AS _UNSIGNED _BYTE
    tremoloPosition AS _UNSIGNED _BYTE
    tremoloLevel AS _UNSIGNED _BYTE
    sampleCounter AS _UNSIGNED INTEGER
    hiHatPhase AS _UNSIGNED INTEGER
    cymbalPhase AS _UNSIGNED INTEGER
    noise AS _UNSIGNED LONG
    pendingRight AS LONG
    chipSamples AS _UNSIGNED _INTEGER64
    lastDue AS _UNSIGNED _INTEGER64
    queueHead AS _UNSIGNED INTEGER
    queueCount AS _UNSIGNED INTEGER
    queue(0 TO 4095) AS __OpalQueuedWrite
END TYPE

' Module-level lookup tables (shared across instances)
DIM __Opal_LogSinTable(0 TO 255) AS _UNSIGNED INTEGER
DIM __Opal_ExponentRom(0 TO 255) AS _UNSIGNED INTEGER
DIM __Opal_MulTimes2(0 TO 15) AS _UNSIGNED INTEGER
DIM __Opal_OperatorOwner(0 TO 35) AS _UNSIGNED _BYTE
DIM __Opal_RhythmKeyBit(0 TO 5) AS _UNSIGNED _BYTE
DIM __Opal_VibratoSteps(0 TO 7) AS __OpalVibratoStep
DIM __Opal_Algorithms(0 TO 8) AS __OpalAlgorithm
DIM __Opal_KslRom(0 TO 15) AS _UNSIGNED _BYTE
DIM __Opal_TablesInitialized AS _BYTE
