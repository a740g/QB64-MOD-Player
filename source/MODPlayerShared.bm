$INCLUDEONCE

'$INCLUDE:'MODPlayer.bi'
'$INCLUDE:'Pathname.bi'

''' @brief Loads the period, sine, and invert loop speed tables into memory for use by the MOD player.
SUB __MODPlayer_LoadTables
    SHARED __MODPlayer_PeriodTable() AS _UNSIGNED INTEGER
    SHARED __MODPlayer_SineTable() AS _UNSIGNED _BYTE
    SHARED __MODPlayer_InvertLoopSpeedTable() AS _UNSIGNED _BYTE
    SHARED __MODPlayer_TablesInitialized AS _BYTE

    IF __MODPlayer_TablesInitialized THEN EXIT SUB

    ' Load the period table
    RESTORE __MODPlayer_PeriodTab
    DIM periodCount AS LONG: READ periodCount
    REDIM __MODPlayer_PeriodTable(0 TO periodCount - 1) AS _UNSIGNED INTEGER ' allocate size elements
    ' Now read size values
    DIM i AS LONG: FOR i = 0 TO periodCount - 1
        READ __MODPlayer_PeriodTable(i)
    NEXT

    ' Load the sine table
    RESTORE __MODPlayer_SineTab
    DIM s AS LONG: READ s
    REDIM __MODPlayer_SineTable(0 TO s - 1) AS _UNSIGNED _BYTE
    FOR i = 0 TO s - 1
        READ __MODPlayer_SineTable(i)
    NEXT

    ' Load the invert loop table
    RESTORE __MODPlayer_ILSpdTab
    READ s
    REDIM __MODPlayer_InvertLoopSpeedTable(0 TO s - 1) AS _UNSIGNED _BYTE
    FOR i = 0 TO s - 1
        READ __MODPlayer_InvertLoopSpeedTable(i)
    NEXT

    __MODPlayer_TablesInitialized = _TRUE
    EXIT SUB

    ' Amiga period table data for 11 octaves
    __MODPlayer_PeriodTab:
    DATA 134
    DATA 27392,25856,24384,23040,21696,20480,19328,18240,17216,16256,15360,14496
    DATA 13696,12928,12192,11520,10848,10240,9664,9120,8608,8128,7680,7248
    DATA 6848,6464,6096,5760,5424,5120,4832,4560,4304,4064,3840,3624
    DATA 3424,3232,3048,2880,2712,2560,2416,2280,2152,2032,1920,1812
    DATA 1712,1616,1524,1440,1356,1280,1208,1140,1076,1016,960,906
    DATA 856,808,762,720,678,640,604,570,538,508,480,453
    DATA 428,404,381,360,339,320,302,285,269,254,240,226
    DATA 214,202,190,180,170,160,151,143,135,127,120,113
    DATA 107,101,95,90,85,80,75,71,67,63,60,56
    DATA 53,50,47,45,42,40,37,35,33,31,30,28
    DATA 26,25,23,22,21,20,18,17,16,15,15,14
    DATA 0,0
    DATA NaN

    ' Sine table data for tremolo & vibrato
    __MODPlayer_SineTab:
    DATA 32
    DATA 0,24,49,74,97,120,141,161,180,197,212,224,235,244,250,253
    DATA 255,253,250,244,235,224,212,197,180,161,141,120,97,74,49,24
    DATA NaN

    ' Invert loop speed table data for EFx
    __MODPlayer_ILSpdTab:
    DATA 16
    DATA 0,5,6,7,8,10,11,13,16,19,22,26,32,43,64,128
    DATA NaN
END SUB

''' @brief Resets all song properties to default values for a clean load state.
SUB __MODPlayer_InitializeSong (player AS MODPlayer)
    player.song.caption = _STR_EMPTY
    player.song.subtype = _STR_EMPTY
    player.song.comment = _STR_EMPTY
    player.song.channels = 0
    player.song.instruments = 0
    player.song.orders = 0
    player.song.endJumpOrder = 0
    player.song.patterns = 0
    player.song.orderPosition = 0
    player.song.patternRow = 0
    player.song.tickPattern = 0
    player.song.tickPatternRow = 0
    player.song.isLooping = _FALSE
    player.song.isPlaying = _FALSE
    player.song.isPaused = _FALSE
    player.song.patternDelay = 0
    player.song.speed = 0
    player.song.BPM = 0
    player.song.defaultSpeed = __MODPLAYER_SONG_SPEED_DEFAULT ' set this to default MOD speed
    player.song.defaultBPM = __MODPLAYER_SONG_BPM_DEFAULT ' set this to default MOD BPM
    player.song.tick = 0
    player.song.rowTickDelay = 0
    player.song.globalVolume = __MODPLAYER_S3M_GLOBAL_VOLUME_MAX
    player.song.defaultGlobalVolume = __MODPLAYER_S3M_GLOBAL_VOLUME_MAX
    player.song.isS3M = _FALSE
    player.song.tempoTimerValue = 0
    player.song.framesPerTick = 0
    player.song.activeChannels = 0
    player.song.useAmigaLPF = _FALSE
    player.song.useST2Vibrato = _FALSE
    player.song.useST2Tempo = _FALSE
    player.song.useMTMTempoMode = _FALSE
    player.song.useAmigaSlides = _FALSE
    player.song.useVolumeOptimization = _FALSE
    player.song.useAmigaLimits = _FALSE
    player.song.useFilterSFX = _FALSE
    player.song.useST300VolumeSlides = _FALSE
    player.song.hasSpecialCustomData = _FALSE
    player.song.hasFMChannels = _FALSE
    player.song.isStereo = _FALSE
    player.song.pcmMasterGain = 1.0!
    player.song.fmMasterGain = 1.0!
    player.song.isRAD = _FALSE
    player.song.isULT = _FALSE
END SUB

''' @brief Calculates middle-C playback speed in Hertz for a ProTracker finetune nibble.
''' @param ft Signed finetune nibble (0-15).
''' @return C2 playback speed in Hertz.
FUNCTION __MODPlayer_GetC2Spd~& (ft AS _UNSIGNED _BYTE)
    SELECT CASE ft
        CASE 0
            __MODPlayer_GetC2Spd = 8363
        CASE 1
            __MODPlayer_GetC2Spd = 8413
        CASE 2
            __MODPlayer_GetC2Spd = 8463
        CASE 3
            __MODPlayer_GetC2Spd = 8529
        CASE 4
            __MODPlayer_GetC2Spd = 8581
        CASE 5
            __MODPlayer_GetC2Spd = 8651
        CASE 6
            __MODPlayer_GetC2Spd = 8723
        CASE 7
            __MODPlayer_GetC2Spd = 8757
        CASE 8
            __MODPlayer_GetC2Spd = 7895
        CASE 9
            __MODPlayer_GetC2Spd = 7941
        CASE 10
            __MODPlayer_GetC2Spd = 7985
        CASE 11
            __MODPlayer_GetC2Spd = 8046
        CASE 12
            __MODPlayer_GetC2Spd = 8107
        CASE 13
            __MODPlayer_GetC2Spd = 8169
        CASE 14
            __MODPlayer_GetC2Spd = 8232
        CASE 15
            __MODPlayer_GetC2Spd = 8280
        CASE ELSE
            __MODPlayer_GetC2Spd = 8363
    END SELECT
END FUNCTION

''' @brief Returns the S3M S2x finetune rate for the encoded nibble.
''' @param ft S3M finetune value (0-15).
''' @return Middle-C playback rate in Hertz.
FUNCTION __MODPlayer_GetS3MC2Spd~& (ft AS _UNSIGNED _BYTE)
    SELECT CASE ft AND &HF
        CASE 0: __MODPlayer_GetS3MC2Spd = 7895
        CASE 1: __MODPlayer_GetS3MC2Spd = 7941
        CASE 2: __MODPlayer_GetS3MC2Spd = 7985
        CASE 3: __MODPlayer_GetS3MC2Spd = 8046
        CASE 4: __MODPlayer_GetS3MC2Spd = 8107
        CASE 5: __MODPlayer_GetS3MC2Spd = 8169
        CASE 6: __MODPlayer_GetS3MC2Spd = 8232
        CASE 7: __MODPlayer_GetS3MC2Spd = 8280
        CASE 8: __MODPlayer_GetS3MC2Spd = 8363
        CASE 9: __MODPlayer_GetS3MC2Spd = 8413
        CASE 10: __MODPlayer_GetS3MC2Spd = 8463
        CASE 11: __MODPlayer_GetS3MC2Spd = 8529
        CASE 12: __MODPlayer_GetS3MC2Spd = 8581
        CASE 13: __MODPlayer_GetS3MC2Spd = 8651
        CASE 14: __MODPlayer_GetS3MC2Spd = 8723
        CASE 15: __MODPlayer_GetS3MC2Spd = 8757
    END SELECT
END FUNCTION

''' @brief Resolves a companion instrument file path (.nt / .as) for a module path if one exists.
''' @param fileName Path to the module file.
''' @return Path to the companion file, or empty string if none exists.
FUNCTION __MODPlayer_FindCompanionFile$ (fileName AS STRING)
    DIM candPath AS STRING

    candPath = fileName + ".nt"
    IF _FILEEXISTS(candPath) THEN
        __MODPlayer_FindCompanionFile = candPath
        EXIT FUNCTION
    END IF

    candPath = fileName + ".NT"
    IF _FILEEXISTS(candPath) THEN
        __MODPlayer_FindCompanionFile = candPath
        EXIT FUNCTION
    END IF

    candPath = fileName + ".as"
    IF _FILEEXISTS(candPath) THEN
        __MODPlayer_FindCompanionFile = candPath
        EXIT FUNCTION
    END IF

    candPath = fileName + ".AS"
    IF _FILEEXISTS(candPath) THEN
        __MODPlayer_FindCompanionFile = candPath
        EXIT FUNCTION
    END IF

    IF LCASE$(Pathname_GetFileExtension(fileName)) = ".mod" THEN
        DIM baseName AS STRING: baseName = Pathname_RemoveFileExtension(fileName)

        candPath = baseName + ".nt"
        IF _FILEEXISTS(candPath) THEN
            __MODPlayer_FindCompanionFile = candPath
            EXIT FUNCTION
        END IF

        candPath = baseName + ".NT"
        IF _FILEEXISTS(candPath) THEN
            __MODPlayer_FindCompanionFile = candPath
            EXIT FUNCTION
        END IF

        candPath = baseName + ".as"
        IF _FILEEXISTS(candPath) THEN
            __MODPlayer_FindCompanionFile = candPath
            EXIT FUNCTION
        END IF

        candPath = baseName + ".AS"
        IF _FILEEXISTS(candPath) THEN
            __MODPlayer_FindCompanionFile = candPath
            EXIT FUNCTION
        END IF
    END IF

    __MODPlayer_FindCompanionFile = _STR_EMPTY
END FUNCTION

''' @brief Determines if a channel or instrument subtype is an OPL FM synthesizer type.
''' @param subtype Subtype value to test.
''' @return _TRUE if FM type (melody or drum), _FALSE otherwise.
FUNCTION __MODPlayer_IsFMChannel%% (subtype AS _UNSIGNED _BYTE)
    __MODPlayer_IsFMChannel = (subtype >= __MODPLAYER_INSTRUMENT_FM_MELODY _ANDALSO subtype <= __MODPLAYER_INSTRUMENT_FM_HIHAT)
END FUNCTION

''' @brief Calculates BPM for a Scream Tracker 2 tempo byte (speed and tempo factor).
''' @param speed Ticks per row (high nibble of tempo byte, 1-15).
''' @param tempoMod Tempo modifier (low nibble of tempo byte, 0-15).
''' @return BPM value (clamped between 32 and 255).
FUNCTION __MODPlayer_CalculateST2BPM~% (speed AS _UNSIGNED _BYTE, tempoMod AS _UNSIGNED _BYTE)
    STATIC speedFactor(0 TO 15) AS _UNSIGNED _BYTE
    IF speedFactor(0) = 0 THEN
        speedFactor(0) = 140: speedFactor(1) = 50: speedFactor(2) = 25: speedFactor(3) = 15
        speedFactor(4) = 10: speedFactor(5) = 7: speedFactor(6) = 6: speedFactor(7) = 4
        speedFactor(8) = 3: speedFactor(9) = 3: speedFactor(10) = 2: speedFactor(11) = 2
        speedFactor(12) = 2: speedFactor(13) = 2: speedFactor(14) = 1: speedFactor(15) = 1
    END IF

    DIM spd AS LONG: spd = speed AND &H0F
    DIM tf AS LONG: tf = tempoMod AND &H0F
    DIM divisor AS LONG: divisor = 50 - ((CLNG(speedFactor(spd)) * tf) \ 16)
    IF divisor <= 0 THEN divisor = 1

    CONST STM_MIX_RATE = 23863&
    DIM tickFrames AS LONG: tickFrames = STM_MIX_RATE \ divisor
    IF tickFrames <= 0 THEN tickFrames = 1

    DIM bpm AS LONG: bpm = (STM_MIX_RATE * 5 + tickFrames) \ (tickFrames * 2)
    IF bpm < 32 THEN bpm = 32
    IF bpm > 255 THEN bpm = 255
    __MODPlayer_CalculateST2BPM = bpm
END FUNCTION
