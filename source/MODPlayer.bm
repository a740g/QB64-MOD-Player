''' @brief Loads a tracker module with optional companion data (e.g. StarTrekker .mod.nt).
''' @param player The MOD player instance.
''' @param buffer In-memory binary representation of the module file.
''' @param companionBuffer In-memory binary representation of companion data, or empty string.
''' @return _TRUE on success, _FALSE on failure.
FUNCTION MODPlayer_LoadWithCompanion%% (player AS MODPlayer, buffer AS STRING, companionBuffer AS STRING)
    IF NOT MODPlayer_IsInitialized(player) THEN
        IF NOT MODPlayer_Initialize(player) THEN EXIT FUNCTION
    END IF

    IF S3MLoader_LoadFromMemory(player, buffer) THEN
        MODPlayer_LoadWithCompanion = _TRUE
        EXIT FUNCTION
    END IF

    IF MTMLoader_LoadFromMemory(player, buffer) THEN
        MODPlayer_LoadWithCompanion = _TRUE
        EXIT FUNCTION
    END IF

    IF MODLoader_LoadWithCompanion(player, buffer, companionBuffer) THEN
        MODPlayer_LoadWithCompanion = _TRUE
        EXIT FUNCTION
    END IF
END FUNCTION

''' @brief Loads a tracker module from a memory buffer, auto-detecting the format across registered loaders.
''' @param player The MOD player instance.
''' @param buffer In-memory binary representation of the module file.
''' @return _TRUE on success, _FALSE on failure.
FUNCTION MODPlayer_LoadFromMemory%% (player AS MODPlayer, buffer AS STRING)
    MODPlayer_LoadFromMemory = MODPlayer_LoadWithCompanion(player, buffer, _STR_EMPTY)
END FUNCTION

''' @brief Loads a tracker module from a disk file, auto-detecting format and companion files.
''' @param player The MOD player instance.
''' @param fileName Path to the module file.
''' @return _TRUE on success, _FALSE on failure.
FUNCTION MODPlayer_LoadFromDisk%% (player AS MODPlayer, fileName AS STRING)
    DIM buffer AS STRING: buffer = File_LoadFromDisk(fileName)
    IF LEN(buffer) = 0 THEN EXIT FUNCTION

    DIM compBuf AS STRING: compBuf = _STR_EMPTY
    DIM compPath AS STRING: compPath = __MODPlayer_FindCompanionFile(fileName)
    IF LEN(compPath) > 0 THEN compBuf = File_LoadFromDisk(compPath)

    MODPlayer_LoadFromDisk = MODPlayer_LoadWithCompanion(player, buffer, compBuf)
END FUNCTION

''' @brief Resets all song properties to default values for a clean load state.
''' @brief Checks whether a player instance is initialized.
''' @param player The MOD player instance.
''' @return _TRUE if initialized, _FALSE otherwise.
FUNCTION MODPlayer_IsInitialized%% (player AS MODPlayer)
    MODPlayer_IsInitialized = player.initialized
END FUNCTION

''' @brief Initializes a MOD player instance and its software synthesizer.
''' @param player The MOD player instance.
''' @return _TRUE on success, _FALSE on failure.
FUNCTION MODPlayer_Initialize%% (player AS MODPlayer)
    IF player.initialized THEN
        MODPlayer_Initialize = _TRUE
        EXIT FUNCTION
    END IF

    __MODPlayer_LoadTables

    IF NOT SoftSynth_Initialize(player.synth) THEN EXIT FUNCTION

    Opal_Initialize player.opl, SoftSynth_GetSampleRate(player.synth)

    __MODPlayer_InitializeSong player

    player.initialized = _TRUE
    MODPlayer_Initialize = _TRUE
END FUNCTION

''' @brief Finalizes a MOD player instance, stopping playback and freeing resources.
''' @param player The MOD player instance.
SUB MODPlayer_Finalize (player AS MODPlayer)
    IF player.initialized THEN
        MODPlayer_Stop player
        SoftSynth_Finalize player.synth
        REDIM player.order(0 TO 0) AS _UNSIGNED INTEGER
        DIM p AS LONG
        FOR p = 0 TO UBOUND(player.pattern)
            REDIM player.pattern(p).note(0 TO 0, 0 TO 0) AS __MODPLAYERNOTE
            player.pattern(p).rows = 0
        NEXT
        REDIM player.pattern(0 TO 0) AS __MODPLAYERPATTERN
        REDIM player.instrument(0 TO 0) AS __MODPLAYERINSTRUMENT
        REDIM player.channel(0 TO 0) AS __MODPLAYERCHANNEL
        __MODPlayer_InitializeSong player
        player.initialized = _FALSE
    END IF
END SUB

''' @brief Prepares channels, initializes the audio mixer, and begins song playback.
SUB MODPlayer_Play (player AS MODPlayer)
    IF NOT player.initialized THEN EXIT SUB

    ' Initialize some important stuff
    player.song.tempoTimerValue = (SoftSynth_GetSampleRate(player.synth) * __MODPLAYER_SONG_BPM_DEFAULT) \ 50
    player.song.orderPosition = 0
    player.song.patternRow = 0
    player.song.speed = player.song.defaultSpeed
    player.song.tick = player.song.speed
    player.song.rowTickDelay = 0
    player.song.patternDelay = 0
    player.song.isPaused = _FALSE

    IF player.song.isS3M THEN
        player.song.globalVolume = player.song.defaultGlobalVolume
        SoftSynth_SetGlobalVolume player.synth, player.song.globalVolume / __MODPLAYER_S3M_GLOBAL_VOLUME_MAX
    END IF

    ' Set default BPM
    __MODPlayer_SetBPM player, player.song.defaultBPM

    Opal_Initialize player.opl, SoftSynth_GetSampleRate(player.synth)

    DIM channelIndex AS _UNSIGNED LONG
    IF player.song.channels > 0 THEN
        FOR channelIndex = 0 TO player.song.channels - 1
            player.channel(channelIndex).oplFNum = 0
            player.channel(channelIndex).oplBlock = 0
            player.channel(channelIndex).oplKeyOn = _FALSE
            player.channel(channelIndex).amStage = __MODPLAYER_AM_STAGE_IDLE
            player.channel(channelIndex).amLevel = 0
            player.channel(channelIndex).amSustainCounter = 0
            player.channel(channelIndex).amVibratoPos = 0
            player.channel(channelIndex).amPitchDelta = 0
            player.channel(channelIndex).amBasePeriod = 0
            IF player.song.isS3M THEN
                player.channel(channelIndex).channelVolume = __MODPLAYER_S3M_GLOBAL_VOLUME_MAX
                player.channel(channelIndex).panning = player.channel(channelIndex).defaultPanning
                SoftSynth_SetVoiceSurround player.synth, channelIndex, _FALSE
                player.channel(channelIndex).lastSampleOffset = 0
                player.channel(channelIndex).lastPanningSlide = 0
                player.channel(channelIndex).lastChannelVolumeSlide = 0
                player.channel(channelIndex).lastGlobalVolumeSlide = 0
                player.channel(channelIndex).lastTempo = 0
                player.channel(channelIndex).lastVolumeSlide = 0
                player.channel(channelIndex).lastPortamento = 0
                player.channel(channelIndex).retriggerVolumeSlide = 0
                player.channel(channelIndex).retriggerTickCount = 0
                player.channel(channelIndex).vibratoPosition = 0
                player.channel(channelIndex).vibratoSpeed = 0
                player.channel(channelIndex).vibratoDepth = 0
                player.channel(channelIndex).tremoloPosition = 0
                player.channel(channelIndex).tremoloSpeed = 0
                player.channel(channelIndex).tremoloDepth = 0
                player.channel(channelIndex).waveControl = 0
                player.channel(channelIndex).useGlissando = _FALSE
                player.channel(channelIndex).portamentoSpeed = 0
                player.channel(channelIndex).portamentoTo = 0
                player.channel(channelIndex).tremorOnTicks = 0
                player.channel(channelIndex).tremorOffTicks = 0
                player.channel(channelIndex).tremorPosition = 0
                player.channel(channelIndex).tremorMuted = _FALSE
                player.channel(channelIndex).panbrelloPosition = 0
                player.channel(channelIndex).panbrelloSpeed = 0
                player.channel(channelIndex).panbrelloDepth = 0
                player.channel(channelIndex).panbrelloWaveform = 0
                player.channel(channelIndex).panbrelloBasePanning = player.channel(channelIndex).panning
                player.channel(channelIndex).panbrelloActive = _FALSE
                player.channel(channelIndex).noteDelayPending = _FALSE
                player.channel(channelIndex).noteDelayTick = 0
                player.channel(channelIndex).delayedNote = __MODPLAYER_NOTE_NONE
                player.channel(channelIndex).delayedInstrument = 0
                player.channel(channelIndex).delayedHasInstrument = _FALSE
                player.channel(channelIndex).delayedVolume = __MODPLAYER_NOTE_NO_VOLUME
                player.channel(channelIndex).delayedPeriod = 0
                player.channel(channelIndex).delayedStartPosition = 0
                player.channel(channelIndex).patternLoopRow = 0
                player.channel(channelIndex).patternLoopRowCounter = 0
                player.channel(channelIndex).c2Spd = 0
                SoftSynth_SetVoiceBalance player.synth, channelIndex, player.channel(channelIndex).panning / 255! * 2! - SOFTSYNTH_VOICE_PAN_RIGHT
                IF player.channel(channelIndex).subtype >= __MODPLAYER_INSTRUMENT_FM_MELODY THEN
                    Opal_SetPan player.opl, player.channel(channelIndex).oplChannel, player.channel(channelIndex).panning \ 2
                END IF
            END IF
        NEXT channelIndex
    END IF

    player.song.isPlaying = _TRUE
END SUB

''' @brief Stops playback, mutes voices, and frees player and synthesizer resources.
SUB MODPlayer_Stop (player AS MODPlayer)
    IF NOT player.initialized THEN EXIT SUB

    SoftSynth_Finalize player.synth
    Opal_Initialize player.opl, SoftSynth_GetSampleRate(player.synth)

    player.song.isPlaying = _FALSE
END SUB

''' @brief Ticks the tracker sequencer and renders audio frames to keep the buffer filled.
''' @param bufferTimeSecs Target duration of audio buffer in seconds (e.g. 0.05).
SUB MODPlayer_Update (player AS MODPlayer, bufferTimeSecs AS SINGLE)
    IF NOT player.initialized THEN EXIT SUB

    DIM maxTicks AS LONG
    IF player.song.framesPerTick > 0 THEN
        DIM sampleRate AS _UNSIGNED LONG: sampleRate = SoftSynth_GetSampleRate(player.synth)
        IF sampleRate > 0 THEN
            DIM tickDuration AS SINGLE: tickDuration = CSNG(player.song.framesPerTick) / CSNG(sampleRate)
            IF tickDuration > 0! THEN maxTicks = INT(bufferTimeSecs / tickDuration) + 2
        END IF
    END IF
    IF maxTicks < 4 THEN maxTicks = 4

    ' Keep feeding the buffer until it is filled to our specified upper limit
    DO WHILE SoftSynth_GetBufferedSoundTime(player.synth) < bufferTimeSecs AND maxTicks > 0
        maxTicks = maxTicks - 1

        ' Check conditions for which we should just exit and not process anything
        ' 1. Song is done and we are not looping
        ' 2. Playback was not requested
        ' 3. Playback is paused
        IF _NEGATE player.song.isPlaying _ORELSE player.song.orderPosition >= player.song.orders _ORELSE player.song.isPaused THEN EXIT SUB

        IF player.song.tick >= player.song.speed + player.song.rowTickDelay THEN
            ' Reset song tick
            player.song.tick = 0

            ' Process pattern row if pattern delay is over
            IF player.song.patternDelay = 0 THEN
                ' Skip marker pattern
                WHILE __MODPLAYER_PATTERN_MARKER = player.order(player.song.orderPosition)
                    player.song.orderPosition = player.song.orderPosition + 1
                    player.song.patternRow = 0

                    ' Check if we need to loop or stop
                    IF player.song.orderPosition >= player.song.orders THEN
                        IF player.song.isLooping THEN
                            player.song.orderPosition = player.song.endJumpOrder
                            player.song.speed = player.song.defaultSpeed
                            player.song.tick = player.song.speed
                        ELSE
                            player.song.isPlaying = _FALSE
                            EXIT SUB ' bail
                        END IF
                    END IF
                WEND

                ' Check for end of song marker
                IF __MODPLAYER_PATTERN_END = player.order(player.song.orderPosition) THEN
                    IF player.song.isLooping THEN
                        player.song.orderPosition = player.song.endJumpOrder
                        player.song.speed = player.song.defaultSpeed
                        player.song.tick = player.song.speed
                    ELSE
                        player.song.isPlaying = _FALSE
                        EXIT SUB ' bail
                    END IF
                END IF

                ' Save the pattern and row for __MODPlayer_UpdateTick()
                ' The pattern that we are playing is always player.song.tickPattern
                player.song.tickPattern = player.order(player.song.orderPosition)
                player.song.tickPatternRow = player.song.patternRow

                ' Process the row
                player.song.rowTickDelay = 0
                __MODPlayer_UpdateRow player

                ' Increment the row counter
                ' Note __MODPlayer_UpdateTick() should pickup stuff using tickPattern & tickPatternRow
                ' This is because we are already at a new row not processed by __MODPlayer_UpdateRow()
                player.song.patternRow = player.song.patternRow + 1

                ' Check if we have finished the pattern and then move to the next one
                DIM currentPatternRows AS _UNSIGNED INTEGER
                IF player.song.tickPattern < player.song.patterns THEN
                    currentPatternRows = player.pattern(player.song.tickPattern).rows
                END IF
                IF currentPatternRows = 0 THEN currentPatternRows = __MODPLAYER_MOD_S3M_ROWS ' fallback safe default

                IF player.song.patternRow >= currentPatternRows THEN
                    player.song.orderPosition = player.song.orderPosition + 1
                    player.song.patternRow = 0

                    ' Check if we need to loop or stop
                    IF player.song.orderPosition >= player.song.orders THEN
                        IF player.song.isLooping THEN
                            player.song.orderPosition = player.song.endJumpOrder
                            player.song.speed = player.song.defaultSpeed
                            player.song.tick = player.song.speed
                        ELSE
                            player.song.isPlaying = _FALSE ' we'll not bail here to allow any remaining samples to mix and play below
                        END IF
                    END IF
                END IF
            ELSE
                player.song.patternDelay = player.song.patternDelay - 1
                player.song.rowTickDelay = 0
            END IF
        ELSE
            __MODPlayer_UpdateTick player
        END IF

        ' Mix the current tick
        SoftSynth_Render player.synth, player.song.framesPerTick

        IF player.song.hasFMChannels THEN
            ' Mix OPL output if we have any FM channels
            Opal_MixSamples player.opl, player.synth.soundBuffer(), player.song.framesPerTick, player.synth.globalVolume
        END IF

        ' Finally send the fully rendered buffer to the audio device
        SoftSynth_PushAudio player.synth

        ' Increment song tick on each update
        player.song.tick = player.song.tick + 1
    LOOP
END SUB

FUNCTION __MODPlayer_GetBaseFNum~% (noteIndex AS _UNSIGNED _BYTE)
    SELECT CASE noteIndex MOD 12
        CASE 0: __MODPlayer_GetBaseFNum = 343
        CASE 1: __MODPlayer_GetBaseFNum = 364
        CASE 2: __MODPlayer_GetBaseFNum = 385
        CASE 3: __MODPlayer_GetBaseFNum = 408
        CASE 4: __MODPlayer_GetBaseFNum = 432
        CASE 5: __MODPlayer_GetBaseFNum = 458
        CASE 6: __MODPlayer_GetBaseFNum = 485
        CASE 7: __MODPlayer_GetBaseFNum = 514
        CASE 8: __MODPlayer_GetBaseFNum = 544
        CASE 9: __MODPlayer_GetBaseFNum = 577
        CASE 10: __MODPlayer_GetBaseFNum = 611
        CASE ELSE: __MODPlayer_GetBaseFNum = 650
    END SELECT
END FUNCTION

FUNCTION __MODPlayer_GetOPLModOffset~% (oplChan AS _UNSIGNED _BYTE)
    __MODPlayer_GetOPLModOffset = (CLNG(oplChan \ 3) * 8) + (oplChan MOD 3)
END FUNCTION

FUNCTION __MODPlayer_GetOPLCarOffset~% (oplChan AS _UNSIGNED _BYTE)
    __MODPlayer_GetOPLCarOffset = __MODPlayer_GetOPLModOffset(oplChan) + 3
END FUNCTION

FUNCTION __MODPlayer_GetOPLDrumBit~%% (subtype AS _UNSIGNED _BYTE)
    SELECT CASE subtype
        CASE __MODPLAYER_INSTRUMENT_FM_BASSDRUM: __MODPlayer_GetOPLDrumBit = &H10
        CASE __MODPLAYER_INSTRUMENT_FM_SNAREDRUM: __MODPlayer_GetOPLDrumBit = &H08
        CASE __MODPLAYER_INSTRUMENT_FM_TOMTOM: __MODPlayer_GetOPLDrumBit = &H04
        CASE __MODPLAYER_INSTRUMENT_FM_CYMBAL: __MODPlayer_GetOPLDrumBit = &H02
        CASE __MODPLAYER_INSTRUMENT_FM_HIHAT: __MODPlayer_GetOPLDrumBit = &H01
        CASE ELSE: __MODPlayer_GetOPLDrumBit = 0
    END SELECT
END FUNCTION

SUB __MODPlayer_UpdateOPLDrumKeys (player AS MODPlayer)
    IF player.song.channels = 0 THEN EXIT SUB

    DIM drumKeys AS _UNSIGNED _BYTE
    DIM channelIndex AS _UNSIGNED LONG
    FOR channelIndex = 0 TO player.song.channels - 1
        IF player.channel(channelIndex).subtype >= __MODPLAYER_INSTRUMENT_FM_BASSDRUM _ANDALSO player.channel(channelIndex).subtype <= __MODPLAYER_INSTRUMENT_FM_HIHAT THEN
            IF player.channel(channelIndex).oplKeyOn THEN
                drumKeys = drumKeys OR __MODPlayer_GetOPLDrumBit(player.channel(channelIndex).subtype)
            END IF
        END IF
    NEXT channelIndex

    Opal_Write player.opl, &HBD, &H20 OR drumKeys
END SUB

SUB __MODPlayer_GetOPLNotePitch (player AS MODPlayer, nChannel AS _UNSIGNED _BYTE, nNote AS _UNSIGNED _BYTE, fNum AS _UNSIGNED INTEGER, oplBlock AS _UNSIGNED _BYTE)
    IF player.channel(nChannel).instrument >= player.song.instruments THEN
        fNum = 0
        oplBlock = 0
        EXIT SUB
    END IF

    DIM octave AS LONG
    octave = CLNG(nNote) \ 12
    DIM noteIdx AS _UNSIGNED _BYTE
    noteIdx = nNote MOD 12

    DIM baseFNum AS _UNSIGNED INTEGER
    baseFNum = __MODPlayer_GetBaseFNum(noteIdx)

    DIM c2Spd AS _UNSIGNED LONG
    c2Spd = player.instrument(player.channel(nChannel).instrument).c2Spd
    IF c2Spd = 0 THEN c2Spd = 8363

    DIM scaledFNum AS LONG
    scaledFNum = (CLNG(baseFNum) * c2Spd) \ 8363

    DO WHILE scaledFNum >= 1024 AND octave < 7
        scaledFNum = scaledFNum \ 2
        octave = octave + 1
    LOOP
    DO WHILE scaledFNum < 512 AND octave > 0
        scaledFNum = scaledFNum * 2
        octave = octave - 1
    LOOP
    IF scaledFNum > 1023 THEN scaledFNum = 1023
    IF octave > 7 THEN octave = 7

    fNum = scaledFNum
    oplBlock = octave
END SUB

SUB __MODPlayer_SetVoiceVolume (player AS MODPlayer, nChannel AS _UNSIGNED _BYTE, volume AS SINGLE)
    DIM outputVolume AS SINGLE
    outputVolume = _CLAMP(volume, 0!, 1!)

    IF player.song.isS3M THEN outputVolume = outputVolume * player.channel(nChannel).channelVolume / __MODPLAYER_S3M_GLOBAL_VOLUME_MAX
    IF player.channel(nChannel).tremorMuted THEN outputVolume = 0!

    SoftSynth_SetVoiceVolume player.synth, nChannel, outputVolume
END SUB

SUB __MODPlayer_ApplyChannelVolume (player AS MODPlayer, nChannel AS _UNSIGNED _BYTE)
    __MODPlayer_SetVoiceVolume player, nChannel, player.channel(nChannel).volume / __MODPLAYER_INSTRUMENT_VOLUME_MAX
END SUB

SUB __MODPlayer_SetChannelPanning (player AS MODPlayer, nChannel AS _UNSIGNED _BYTE, panning AS LONG)
    DIM safePan AS LONG
    safePan = _CLAMP(panning, 0, 255)
    player.channel(nChannel).panning = safePan
    IF NOT player.channel(nChannel).panbrelloActive THEN player.channel(nChannel).panbrelloBasePanning = safePan
    SoftSynth_SetVoiceSurround player.synth, nChannel, _FALSE
    SoftSynth_SetVoiceBalance player.synth, nChannel, safePan / 255! * 2! - SOFTSYNTH_VOICE_PAN_RIGHT
    IF player.channel(nChannel).subtype >= __MODPLAYER_INSTRUMENT_FM_MELODY THEN
        Opal_SetPan player.opl, player.channel(nChannel).oplChannel, safePan \ 2
    END IF
END SUB

SUB __MODPlayer_SetGlobalVolume (player AS MODPlayer, volume AS LONG)
    DIM safeVolume AS LONG
    safeVolume = _CLAMP(volume, 0, __MODPLAYER_S3M_GLOBAL_VOLUME_MAX)
    player.song.globalVolume = safeVolume
    SoftSynth_SetGlobalVolume player.synth, safeVolume / __MODPLAYER_S3M_GLOBAL_VOLUME_MAX
END SUB

SUB __MODPlayer_DoS3MChannelVolumeSlide (player AS MODPlayer, nChannel AS _UNSIGNED _BYTE, nOperand AS _UNSIGNED _BYTE, isRowTick AS _BYTE)
    IF nOperand THEN player.channel(nChannel).lastChannelVolumeSlide = nOperand ELSE nOperand = player.channel(nChannel).lastChannelVolumeSlide

    DIM slideUp AS _UNSIGNED _BYTE: slideUp = _SHR(nOperand, 4)
    DIM slideDown AS _UNSIGNED _BYTE: slideDown = nOperand AND &HF
    DIM delta AS LONG: delta = 0

    IF isRowTick THEN
        IF slideDown = &HF AND slideUp > 0 THEN
            delta = slideUp
        ELSEIF slideUp = &HF AND slideDown > 0 THEN
            delta = -slideDown
        END IF
    ELSE
        IF slideDown > 0 THEN
            delta = -slideDown
        ELSEIF slideUp > 0 THEN
            delta = slideUp
        END IF
    END IF

    player.channel(nChannel).channelVolume = _CLAMP(CLNG(player.channel(nChannel).channelVolume) + delta, 0, __MODPLAYER_S3M_GLOBAL_VOLUME_MAX)
    __MODPlayer_ApplyChannelVolume player, nChannel
END SUB

SUB __MODPlayer_DoS3MGlobalVolumeSlide (player AS MODPlayer, nChannel AS _UNSIGNED _BYTE, nOperand AS _UNSIGNED _BYTE, isRowTick AS _BYTE)
    IF nOperand THEN player.channel(nChannel).lastGlobalVolumeSlide = nOperand ELSE nOperand = player.channel(nChannel).lastGlobalVolumeSlide

    DIM slideUp AS _UNSIGNED _BYTE: slideUp = _SHR(nOperand, 4)
    DIM slideDown AS _UNSIGNED _BYTE: slideDown = nOperand AND &HF
    DIM delta AS LONG: delta = 0

    IF isRowTick THEN
        IF slideDown = &HF AND slideUp > 0 THEN
            delta = slideUp
        ELSEIF slideUp = &HF AND slideDown > 0 THEN
            delta = -slideDown
        END IF
    ELSE
        IF slideDown > 0 THEN
            delta = -slideDown
        ELSEIF slideUp > 0 THEN
            delta = slideUp
        END IF
    END IF

    __MODPlayer_SetGlobalVolume player, CLNG(player.song.globalVolume) + delta
END SUB

SUB __MODPlayer_DoS3MPanningSlide (player AS MODPlayer, nChannel AS _UNSIGNED _BYTE, nOperand AS _UNSIGNED _BYTE, isRowTick AS _BYTE)
    IF nOperand THEN player.channel(nChannel).lastPanningSlide = nOperand ELSE nOperand = player.channel(nChannel).lastPanningSlide

    DIM slideLeft AS _UNSIGNED _BYTE: slideLeft = _SHR(nOperand, 4)
    DIM slideRight AS _UNSIGNED _BYTE: slideRight = nOperand AND &HF
    DIM delta AS LONG: delta = 0

    IF isRowTick THEN
        IF slideRight = &HF AND slideLeft > 0 THEN
            delta = -CLNG(slideLeft) * 4
        ELSEIF slideLeft = &HF AND slideRight > 0 THEN
            delta = CLNG(slideRight) * 4
        END IF
    ELSE
        IF slideRight > 0 THEN
            delta = CLNG(slideRight) * 4
        ELSEIF slideLeft > 0 THEN
            delta = -CLNG(slideLeft) * 4
        END IF
    END IF

    __MODPlayer_SetChannelPanning player, nChannel, CLNG(player.channel(nChannel).panning) + delta
END SUB

SUB __MODPlayer_PlayPCMChannelVoice (player AS MODPlayer, nChannel AS _UNSIGNED _BYTE)
    DIM inst AS LONG: inst = player.channel(nChannel).instrument
    IF inst < 0 _ORELSE inst >= player.song.instruments THEN EXIT SUB

    SoftSynth_PlayVoice player.synth, nChannel, inst, SoftSynth_ConvertBytesToFrames(player.channel(nChannel).startPosition, player.instrument(inst).bytesPerSample, player.instrument(inst).channels), player.instrument(inst).playMode, SoftSynth_ConvertBytesToFrames(player.instrument(inst).loopStart, player.instrument(inst).bytesPerSample, player.instrument(inst).channels), SoftSynth_ConvertBytesToFrames(player.instrument(inst).loopEnd, player.instrument(inst).bytesPerSample, player.instrument(inst).channels)

    IF player.instrument(inst).subtype = __MODPLAYER_INSTRUMENT_AM_SYNTH THEN
        __MODPlayer_TriggerAMInstrument player, nChannel, inst
    END IF
END SUB

SUB __MODPlayer_TriggerAMInstrument (player AS MODPlayer, nChannel AS _UNSIGNED _BYTE, inst AS LONG)
    player.channel(nChannel).amStage = __MODPLAYER_AM_STAGE_ATTACK1
    player.channel(nChannel).amLevel = player.instrument(inst).am.startLevel
    player.channel(nChannel).amSustainCounter = 0
    player.channel(nChannel).amVibratoPos = 0
    player.channel(nChannel).amPitchDelta = 0

    DIM oct AS _UNSIGNED _BYTE: oct = player.instrument(inst).am.octave
    IF oct > 5 THEN oct = 5
    DIM basePeriod AS LONG: basePeriod = player.channel(nChannel).period
    IF oct > 0 AND basePeriod > 0 THEN
        basePeriod = _SHL(basePeriod, oct)
    END IF
    player.channel(nChannel).amBasePeriod = basePeriod

    __MODPlayer_UpdateAMChannel player, nChannel
END SUB

SUB __MODPlayer_UpdateAMChannel (player AS MODPlayer, nChannel AS _UNSIGNED _BYTE)
    DIM inst AS LONG: inst = player.channel(nChannel).instrument
    IF inst < 0 _ORELSE inst >= player.song.instruments THEN EXIT SUB
    IF player.instrument(inst).subtype <> __MODPLAYER_INSTRUMENT_AM_SYNTH THEN EXIT SUB

    DIM vol AS LONG
    vol = (CLNG(player.channel(nChannel).volume) * player.channel(nChannel).amLevel) \ 256
    IF vol < 0 THEN vol = 0
    IF vol > __MODPLAYER_INSTRUMENT_VOLUME_MAX THEN vol = __MODPLAYER_INSTRUMENT_VOLUME_MAX
    DIM finalVol AS SINGLE
    finalVol = (CSNG(vol) / CSNG(__MODPLAYER_INSTRUMENT_VOLUME_MAX)) * (CSNG(player.song.globalVolume) / CSNG(__MODPLAYER_S3M_GLOBAL_VOLUME_MAX))
    SoftSynth_SetVoiceVolume player.synth, nChannel, finalVol

    DIM vibDelta AS LONG: vibDelta = 0
    IF player.instrument(inst).am.vibAmp > 0 THEN
        DIM vPhase AS LONG: vPhase = player.channel(nChannel).amVibratoPos AND 63
        DIM sVal AS LONG
        sVal = CINT(_ROUND(SIN(vPhase * 6.283185307179586# / 64!) * 127!))
        vibDelta = (sVal * CLNG(player.instrument(inst).am.vibAmp) * 2) \ 128
    END IF

    DIM netPeriod AS LONG
    netPeriod = player.channel(nChannel).amBasePeriod + player.channel(nChannel).amPitchDelta + vibDelta
    IF netPeriod < 113 THEN netPeriod = 113
    IF netPeriod > 27392 THEN netPeriod = 27392

    IF netPeriod > 0 THEN
        SoftSynth_SetVoiceFrequency player.synth, nChannel, __MODPlayer_GetFrequencyFromPeriod(netPeriod)
    END IF
END SUB

SUB __MODPlayer_ProcessAMChannelTick (player AS MODPlayer, nChannel AS _UNSIGNED _BYTE)
    DIM inst AS LONG: inst = player.channel(nChannel).instrument
    IF inst < 0 _ORELSE inst >= player.song.instruments THEN EXIT SUB
    IF player.instrument(inst).subtype <> __MODPLAYER_INSTRUMENT_AM_SYNTH THEN EXIT SUB
    IF player.channel(nChannel).amStage = __MODPLAYER_AM_STAGE_IDLE THEN EXIT SUB

    DIM oct AS _UNSIGNED _BYTE: oct = player.instrument(inst).am.octave
    IF oct > 5 THEN oct = 5
    DIM basePeriod AS LONG: basePeriod = player.channel(nChannel).period
    IF oct > 0 AND basePeriod > 0 THEN
        basePeriod = _SHL(basePeriod, oct)
    END IF
    player.channel(nChannel).amBasePeriod = basePeriod

    IF player.instrument(inst).am.pitchFall <> 0 THEN
        player.channel(nChannel).amPitchDelta = player.channel(nChannel).amPitchDelta + player.instrument(inst).am.pitchFall
    END IF

    IF player.instrument(inst).am.vibAmp > 0 THEN
        player.channel(nChannel).amVibratoPos = (player.channel(nChannel).amVibratoPos + player.instrument(inst).am.vibSpeed) AND 63
    END IF

    DIM curLevel AS LONG: curLevel = player.channel(nChannel).amLevel
    DIM targetLevel AS LONG, speed AS LONG, stepVal AS LONG

    SELECT CASE player.channel(nChannel).amStage
        CASE __MODPLAYER_AM_STAGE_ATTACK1
            targetLevel = player.instrument(inst).am.attack1Level
            speed = player.instrument(inst).am.attack1Speed
            IF speed = 0 THEN
                ' Speed 0 holds level indefinitely (sustain)
            ELSE
                IF targetLevel > curLevel THEN
                    stepVal = (speed * (256 - curLevel)) \ 256
                    IF stepVal < 1 THEN stepVal = 1
                    curLevel = curLevel + stepVal
                    IF curLevel >= targetLevel THEN
                        curLevel = targetLevel
                        player.channel(nChannel).amStage = __MODPLAYER_AM_STAGE_ATTACK2
                    END IF
                ELSEIF targetLevel < curLevel THEN
                    stepVal = (speed * curLevel) \ 256
                    IF stepVal < 1 THEN stepVal = 1
                    curLevel = curLevel - stepVal
                    IF curLevel <= targetLevel THEN
                        curLevel = targetLevel
                        player.channel(nChannel).amStage = __MODPLAYER_AM_STAGE_ATTACK2
                    END IF
                ELSE
                    player.channel(nChannel).amStage = __MODPLAYER_AM_STAGE_ATTACK2
                END IF
            END IF

        CASE __MODPLAYER_AM_STAGE_ATTACK2
            targetLevel = player.instrument(inst).am.attack2Level
            speed = player.instrument(inst).am.attack2Speed
            IF speed = 0 THEN
                ' Speed 0 holds level indefinitely
            ELSE
                IF targetLevel > curLevel THEN
                    stepVal = (speed * (256 - curLevel)) \ 256
                    IF stepVal < 1 THEN stepVal = 1
                    curLevel = curLevel + stepVal
                    IF curLevel >= targetLevel THEN
                        curLevel = targetLevel
                        player.channel(nChannel).amStage = __MODPLAYER_AM_STAGE_DECAY
                    END IF
                ELSEIF targetLevel < curLevel THEN
                    stepVal = (speed * curLevel) \ 256
                    IF stepVal < 1 THEN stepVal = 1
                    curLevel = curLevel - stepVal
                    IF curLevel <= targetLevel THEN
                        curLevel = targetLevel
                        player.channel(nChannel).amStage = __MODPLAYER_AM_STAGE_DECAY
                    END IF
                ELSE
                    player.channel(nChannel).amStage = __MODPLAYER_AM_STAGE_DECAY
                END IF
            END IF

        CASE __MODPLAYER_AM_STAGE_DECAY
            targetLevel = player.instrument(inst).am.sustainLevel
            speed = player.instrument(inst).am.decaySpeed
            IF speed = 0 THEN
                ' Speed 0 holds level indefinitely
            ELSE
                IF targetLevel > curLevel THEN
                    stepVal = (speed * (256 - curLevel)) \ 256
                    IF stepVal < 1 THEN stepVal = 1
                    curLevel = curLevel + stepVal
                    IF curLevel >= targetLevel THEN
                        curLevel = targetLevel
                        player.channel(nChannel).amStage = __MODPLAYER_AM_STAGE_SUSTAIN
                        player.channel(nChannel).amSustainCounter = player.instrument(inst).am.sustainTime
                    END IF
                ELSEIF targetLevel < curLevel THEN
                    stepVal = (speed * curLevel) \ 256
                    IF stepVal < 1 THEN stepVal = 1
                    curLevel = curLevel - stepVal
                    IF curLevel <= targetLevel THEN
                        curLevel = targetLevel
                        player.channel(nChannel).amStage = __MODPLAYER_AM_STAGE_SUSTAIN
                        player.channel(nChannel).amSustainCounter = player.instrument(inst).am.sustainTime
                    END IF
                ELSE
                    player.channel(nChannel).amStage = __MODPLAYER_AM_STAGE_SUSTAIN
                    player.channel(nChannel).amSustainCounter = player.instrument(inst).am.sustainTime
                END IF
            END IF

        CASE __MODPLAYER_AM_STAGE_SUSTAIN
            curLevel = player.instrument(inst).am.sustainLevel
            IF player.channel(nChannel).amSustainCounter > 0 THEN
                player.channel(nChannel).amSustainCounter = player.channel(nChannel).amSustainCounter - 1
                IF player.channel(nChannel).amSustainCounter = 0 THEN
                    player.channel(nChannel).amStage = __MODPLAYER_AM_STAGE_RELEASE
                END IF
            ELSE
                player.channel(nChannel).amStage = __MODPLAYER_AM_STAGE_RELEASE
            END IF

        CASE __MODPLAYER_AM_STAGE_RELEASE
            speed = player.instrument(inst).am.releaseSpeed
            IF speed = 0 THEN
                ' Speed 0 holds level indefinitely
            ELSE
                stepVal = speed
                IF stepVal < 1 THEN stepVal = 1
                curLevel = curLevel - stepVal
                IF curLevel <= 0 THEN
                    curLevel = 0
                    player.channel(nChannel).amStage = __MODPLAYER_AM_STAGE_IDLE
                END IF
            END IF
    END SELECT

    player.channel(nChannel).amLevel = curLevel

    __MODPlayer_UpdateAMChannel player, nChannel
END SUB

SUB __MODPlayer_TriggerDelayedNote (player AS MODPlayer, nChannel AS _UNSIGNED _BYTE)
    DIM delayedPortamento AS _BYTE: delayedPortamento = _FALSE
    IF NOT player.channel(nChannel).noteDelayPending _ORELSE player.song.tick <> player.channel(nChannel).noteDelayTick THEN EXIT SUB

    player.channel(nChannel).noteDelayPending = _FALSE
    IF player.channel(nChannel).delayedHasInstrument THEN
        player.channel(nChannel).instrument = player.channel(nChannel).delayedInstrument
        player.channel(nChannel).startPosition = 0
        player.channel(nChannel).volume = player.instrument(player.channel(nChannel).instrument).volume
    END IF

    IF player.channel(nChannel).delayedNote = __MODPLAYER_NOTE_KEY_OFF THEN
        player.channel(nChannel).volume = 0
        SoftSynth_StopVoice player.synth, nChannel
        EXIT SUB
    END IF

    player.channel(nChannel).startPosition = player.channel(nChannel).delayedStartPosition
    player.channel(nChannel).note = player.channel(nChannel).delayedNote
    IF player.channel(nChannel).delayedVolume = 125 AND player.channel(nChannel).period > 0 THEN
        player.channel(nChannel).lastPeriod = player.channel(nChannel).delayedPeriod
        player.channel(nChannel).portamentoTo = player.channel(nChannel).delayedPeriod
        delayedPortamento = _TRUE
    ELSE
        player.channel(nChannel).period = player.channel(nChannel).delayedPeriod
        player.channel(nChannel).lastPeriod = player.channel(nChannel).delayedPeriod
    END IF
    IF player.channel(nChannel).delayedVolume <= __MODPLAYER_INSTRUMENT_VOLUME_MAX THEN
        player.channel(nChannel).volume = player.channel(nChannel).delayedVolume
    ELSE
        SELECT CASE player.channel(nChannel).delayedVolume
            CASE 65 TO 74
                player.channel(nChannel).volume = _CLAMP(player.channel(nChannel).volume + player.channel(nChannel).delayedVolume - 65, 0, __MODPLAYER_INSTRUMENT_VOLUME_MAX)
            CASE 75 TO 84
                player.channel(nChannel).volume = _CLAMP(player.channel(nChannel).volume - player.channel(nChannel).delayedVolume + 75, 0, __MODPLAYER_INSTRUMENT_VOLUME_MAX)
            CASE 128 TO 192
                __MODPlayer_SetChannelPanning player, nChannel, (player.channel(nChannel).delayedVolume - 128) * 4
        END SELECT
    END IF
    __MODPlayer_ApplyChannelVolume player, nChannel
    IF delayedPortamento THEN EXIT SUB
    SoftSynth_SetVoiceFrequency player.synth, nChannel, __MODPlayer_GetFrequencyFromPeriod(player.channel(nChannel).period)
    __MODPlayer_PlayPCMChannelVoice player, nChannel
END SUB

SUB __MODPlayer_DoS3MTempoSlide (player AS MODPlayer, nChannel AS _UNSIGNED _BYTE, nOperand AS _UNSIGNED _BYTE)
    IF nOperand THEN player.channel(nChannel).lastTempo = nOperand ELSE nOperand = player.channel(nChannel).lastTempo
    IF nOperand = 0 _ORELSE nOperand >= 32 THEN EXIT SUB

    DIM tempoDelta AS LONG: tempoDelta = nOperand AND &HF
    IF tempoDelta = 0 THEN EXIT SUB

    DIM targetTempo AS LONG: targetTempo = player.song.BPM
    IF _SHR(nOperand, 4) = 1 THEN
        targetTempo = targetTempo + tempoDelta
    ELSE
        targetTempo = targetTempo - tempoDelta
    END IF
    targetTempo = _CLAMP(targetTempo, 32, 255)
    __MODPlayer_SetBPM player, targetTempo
END SUB

SUB __MODPlayer_DoPanbrello (player AS MODPlayer, nChannel AS _UNSIGNED _BYTE)
    SHARED __MODPlayer_SineTable() AS _UNSIGNED _BYTE
    DIM panPos AS _UNSIGNED _BYTE: panPos = player.channel(nChannel).panbrelloPosition AND 31
    DIM waveValue AS LONG

    SELECT CASE player.channel(nChannel).panbrelloWaveform AND 3
        CASE 0
            waveValue = __MODPlayer_SineTable(panPos)
        CASE 1
            waveValue = 255 - _SHL(panPos, 3)
        CASE 2
            IF panPos < 16 THEN waveValue = 255 ELSE waveValue = 0
        CASE 3
            waveValue = RND * 255!
    END SELECT

    DIM delta AS LONG
    delta = ((waveValue - 128) * player.channel(nChannel).panbrelloDepth) \ 32
    __MODPlayer_SetChannelPanning player, nChannel, CLNG(player.channel(nChannel).panbrelloBasePanning) + delta

    player.channel(nChannel).panbrelloPosition = (player.channel(nChannel).panbrelloPosition + player.channel(nChannel).panbrelloSpeed) AND 31
END SUB

SUB __MODPlayer_UpdateFMVolume (player AS MODPlayer, nChannel AS _UNSIGNED _BYTE)
    DIM oplChan AS _UNSIGNED _BYTE
    oplChan = player.channel(nChannel).oplChannel
    DIM subtype AS _UNSIGNED _BYTE
    subtype = player.channel(nChannel).subtype
    DIM instIdx AS LONG
    instIdx = player.channel(nChannel).instrument

    DIM vol AS LONG
    vol = player.channel(nChannel).volume
    IF player.song.isS3M THEN vol = (vol * player.channel(nChannel).channelVolume) \ __MODPLAYER_S3M_GLOBAL_VOLUME_MAX
    IF player.channel(nChannel).tremorMuted THEN vol = 0
    IF vol < 0 THEN vol = 0
    IF vol > __MODPLAYER_INSTRUMENT_VOLUME_MAX THEN vol = __MODPLAYER_INSTRUMENT_VOLUME_MAX

    IF subtype = __MODPLAYER_INSTRUMENT_FM_HIHAT OR subtype = __MODPLAYER_INSTRUMENT_FM_TOMTOM THEN
        ' Hi-Hat and Tom-Tom are 1-op rhythm sounds using the MODULATOR
        DIM modOffsetHH AS _UNSIGNED INTEGER
        modOffsetHH = __MODPlayer_GetOPLModOffset(oplChan)
        DIM d02HH AS _UNSIGNED _BYTE
        d02HH = player.instrument(instIdx).adlib(2)
        DIM modVolHH AS LONG
        modVolHH = 63 - (((63 - CLNG(d02HH AND 63)) * vol) \ 64)
        IF modVolHH < 0 THEN modVolHH = 0
        IF modVolHH > 63 THEN modVolHH = 63
        Opal_Write player.opl, &H40 + modOffsetHH, (d02HH AND &HC0) OR (modVolHH AND 63)
    ELSEIF subtype = __MODPLAYER_INSTRUMENT_FM_SNAREDRUM OR subtype = __MODPLAYER_INSTRUMENT_FM_CYMBAL THEN
        ' Snare Drum and Cymbal are 1-op rhythm sounds using the CARRIER
        DIM carOffsetSC AS _UNSIGNED INTEGER
        carOffsetSC = __MODPlayer_GetOPLCarOffset(oplChan)
        DIM d03SC AS _UNSIGNED _BYTE
        d03SC = player.instrument(instIdx).adlib(3)
        DIM carVolSC AS LONG
        carVolSC = 63 - (((63 - CLNG(d03SC AND 63)) * vol) \ 64)
        IF carVolSC < 0 THEN carVolSC = 0
        IF carVolSC > 63 THEN carVolSC = 63
        DIM carTLSC AS _UNSIGNED _BYTE
        carTLSC = (d03SC AND &HC0) OR (carVolSC AND 63)
        player.channel(nChannel).oplCarrierTotalLevel = carTLSC
        Opal_Write player.opl, &H40 + carOffsetSC, carTLSC
    ELSE
        ' Melody or Bass Drum: update carrier
        DIM carOffset AS _UNSIGNED INTEGER
        carOffset = __MODPlayer_GetOPLCarOffset(oplChan)
        DIM d03 AS _UNSIGNED _BYTE
        d03 = player.instrument(instIdx).adlib(3)
        DIM carVol AS LONG
        carVol = 63 - (((63 - CLNG(d03 AND 63)) * vol) \ 64)
        IF carVol < 0 THEN carVol = 0
        IF carVol > 63 THEN carVol = 63
        DIM carTL AS _UNSIGNED _BYTE
        carTL = (d03 AND &HC0) OR (carVol AND 63)
        player.channel(nChannel).oplCarrierTotalLevel = carTL
        Opal_Write player.opl, &H40 + carOffset, carTL

        ' If additive synthesis, modulator is also a voice output
        DIM d0a AS _UNSIGNED _BYTE
        d0a = player.instrument(instIdx).adlib(10)
        IF (d0a AND 1) <> 0 THEN
            DIM modOffset AS _UNSIGNED INTEGER
            modOffset = __MODPlayer_GetOPLModOffset(oplChan)
            DIM d02 AS _UNSIGNED _BYTE
            d02 = player.instrument(instIdx).adlib(2)
            DIM modVol AS LONG
            modVol = 63 - (((63 - CLNG(d02 AND 63)) * vol) \ 64)
            IF modVol < 0 THEN modVol = 0
            IF modVol > 63 THEN modVol = 63
            Opal_Write player.opl, &H40 + modOffset, (d02 AND &HC0) OR (modVol AND 63)
        END IF
    END IF
END SUB

SUB __MODPlayer_TriggerFMPatch (player AS MODPlayer, nChannel AS _UNSIGNED _BYTE, instIdx AS LONG)
    DIM oplChan AS _UNSIGNED _BYTE
    oplChan = player.channel(nChannel).oplChannel
    DIM subtype AS _UNSIGNED _BYTE
    subtype = player.channel(nChannel).subtype
    DIM modOffset AS _UNSIGNED INTEGER
    modOffset = __MODPlayer_GetOPLModOffset(oplChan)
    DIM carOffset AS _UNSIGNED INTEGER
    carOffset = __MODPlayer_GetOPLCarOffset(oplChan)

    IF subtype = __MODPLAYER_INSTRUMENT_FM_HIHAT OR subtype = __MODPLAYER_INSTRUMENT_FM_TOMTOM THEN
        ' 1-op rhythm sounds using MODULATOR only
        Opal_Write player.opl, &H20 + modOffset, player.instrument(instIdx).adlib(0)
        Opal_Write player.opl, &H40 + modOffset, player.instrument(instIdx).adlib(2)
        Opal_Write player.opl, &H60 + modOffset, player.instrument(instIdx).adlib(4)
        Opal_Write player.opl, &H80 + modOffset, player.instrument(instIdx).adlib(6)
        Opal_Write player.opl, &HE0 + modOffset, player.instrument(instIdx).adlib(8)
    ELSEIF subtype = __MODPLAYER_INSTRUMENT_FM_SNAREDRUM OR subtype = __MODPLAYER_INSTRUMENT_FM_CYMBAL THEN
        ' 1-op rhythm sounds using CARRIER only
        Opal_Write player.opl, &H20 + carOffset, player.instrument(instIdx).adlib(1)
        Opal_Write player.opl, &H40 + carOffset, player.instrument(instIdx).adlib(3)
        Opal_Write player.opl, &H60 + carOffset, player.instrument(instIdx).adlib(5)
        Opal_Write player.opl, &H80 + carOffset, player.instrument(instIdx).adlib(7)
        Opal_Write player.opl, &HE0 + carOffset, player.instrument(instIdx).adlib(9)
    ELSE
        ' Melody or Bass Drum: 2-op sounds using BOTH modulator and carrier
        Opal_Write player.opl, &H20 + modOffset, player.instrument(instIdx).adlib(0)
        Opal_Write player.opl, &H20 + carOffset, player.instrument(instIdx).adlib(1)
        Opal_Write player.opl, &H40 + modOffset, player.instrument(instIdx).adlib(2)
        Opal_Write player.opl, &H60 + modOffset, player.instrument(instIdx).adlib(4)
        Opal_Write player.opl, &H60 + carOffset, player.instrument(instIdx).adlib(5)
        Opal_Write player.opl, &H80 + modOffset, player.instrument(instIdx).adlib(6)
        Opal_Write player.opl, &H80 + carOffset, player.instrument(instIdx).adlib(7)
        Opal_Write player.opl, &HE0 + modOffset, player.instrument(instIdx).adlib(8)
        Opal_Write player.opl, &HE0 + carOffset, player.instrument(instIdx).adlib(9)
        Opal_Write player.opl, &HC0 + oplChan, player.instrument(instIdx).adlib(10)
    END IF

    ' Update Carrier (and additive Modulator) Volume
    __MODPlayer_UpdateFMVolume player, nChannel
END SUB

SUB __MODPlayer_UpdateFMChannelRow (player AS MODPlayer, nChannel AS _UNSIGNED _BYTE, nNote AS _UNSIGNED _BYTE, nInstrument AS _UNSIGNED _BYTE, nVolume AS _UNSIGNED _BYTE)
    DIM oplChan AS _UNSIGNED _BYTE
    oplChan = player.channel(nChannel).oplChannel
    DIM oplFNum AS _UNSIGNED INTEGER
    DIM oplBlock AS _UNSIGNED _BYTE
    DIM regB0 AS _UNSIGNED _BYTE

    IF nInstrument > 0 THEN
        DIM instIdx AS LONG
        instIdx = nInstrument - 1
        IF instIdx < player.song.instruments THEN
            player.channel(nChannel).instrument = instIdx
            player.channel(nChannel).volume = player.instrument(instIdx).volume
            __MODPlayer_TriggerFMPatch player, nChannel, instIdx
        END IF
    END IF

    IF nVolume <= __MODPLAYER_INSTRUMENT_VOLUME_MAX THEN
        player.channel(nChannel).volume = nVolume
        __MODPlayer_UpdateFMVolume player, nChannel
    END IF

    IF player.channel(nChannel).subtype = __MODPLAYER_INSTRUMENT_FM_MELODY THEN
        IF nNote = __MODPLAYER_NOTE_KEY_OFF OR nNote = 254 THEN
            player.channel(nChannel).oplKeyOn = _FALSE
            regB0 = _SHL(player.channel(nChannel).oplBlock AND 7, 2) OR (_SHR(player.channel(nChannel).oplFNum, 8) AND 3)
            Opal_Write player.opl, &HB0 + oplChan, regB0
        ELSEIF nNote < __MODPLAYER_NOTE_NONE THEN
            __MODPlayer_GetOPLNotePitch player, nChannel, nNote, oplFNum, oplBlock
            IF oplFNum > 0 THEN
                player.channel(nChannel).oplFNum = oplFNum
                player.channel(nChannel).oplBlock = oplBlock
                player.channel(nChannel).oplKeyOn = -1

                Opal_Write player.opl, &HA0 + oplChan, oplFNum AND &HFF
                regB0 = &H20 OR _SHL(oplBlock AND 7, 2) OR (_SHR(oplFNum, 8) AND 3)
                Opal_Write player.opl, &HB0 + oplChan, regB0 AND (NOT &H20)
                Opal_Write player.opl, &HB0 + oplChan, regB0
            END IF
        END IF
    ELSE
        DIM drumBit AS _UNSIGNED _BYTE
        drumBit = __MODPlayer_GetOPLDrumBit(player.channel(nChannel).subtype)
        IF drumBit <> 0 THEN
            IF nNote = __MODPLAYER_NOTE_KEY_OFF OR nNote = 254 THEN
                player.channel(nChannel).oplKeyOn = _FALSE
                __MODPlayer_UpdateOPLDrumKeys player
            ELSEIF nNote < __MODPLAYER_NOTE_NONE THEN
                __MODPlayer_GetOPLNotePitch player, nChannel, nNote, oplFNum, oplBlock
                IF oplFNum > 0 THEN
                    player.channel(nChannel).oplFNum = oplFNum
                    player.channel(nChannel).oplBlock = oplBlock

                    Opal_Write player.opl, &HA0 + oplChan, oplFNum AND &HFF
                    regB0 = _SHL(oplBlock AND 7, 2) OR (_SHR(oplFNum, 8) AND 3)
                    Opal_Write player.opl, &HB0 + oplChan, regB0

                    player.channel(nChannel).oplKeyOn = _FALSE
                    __MODPlayer_UpdateOPLDrumKeys player
                    player.channel(nChannel).oplKeyOn = -1
                    __MODPlayer_UpdateOPLDrumKeys player
                END IF
            END IF
        END IF
    END IF
END SUB

SUB __MODPlayer_FMDoPortamentoUp (player AS MODPlayer, nChannel AS _UNSIGNED _BYTE, amount AS LONG)
    DIM oplChan AS _UNSIGNED _BYTE
    oplChan = player.channel(nChannel).oplChannel
    DIM fUp AS LONG
    fUp = CLNG(player.channel(nChannel).oplFNum) + amount
    IF fUp >= 1024 AND player.channel(nChannel).oplBlock < 7 THEN
        fUp = fUp \ 2
        player.channel(nChannel).oplBlock = player.channel(nChannel).oplBlock + 1
    ELSEIF fUp > 1023 THEN
        fUp = 1023
    END IF
    player.channel(nChannel).oplFNum = fUp
    Opal_Write player.opl, &HA0 + oplChan, fUp AND &HFF
    DIM regB0Up AS _UNSIGNED _BYTE
    regB0Up = _SHL(player.channel(nChannel).oplBlock AND 7, 2) OR (_SHR(fUp, 8) AND 3)
    IF player.channel(nChannel).subtype = __MODPLAYER_INSTRUMENT_FM_MELODY _ANDALSO player.channel(nChannel).oplKeyOn THEN regB0Up = regB0Up OR &H20
    Opal_Write player.opl, &HB0 + oplChan, regB0Up
END SUB

SUB __MODPlayer_FMDoPortamentoDown (player AS MODPlayer, nChannel AS _UNSIGNED _BYTE, amount AS LONG)
    DIM oplChan AS _UNSIGNED _BYTE
    oplChan = player.channel(nChannel).oplChannel
    DIM fDown AS LONG
    fDown = CLNG(player.channel(nChannel).oplFNum) - amount
    IF fDown < 512 AND player.channel(nChannel).oplBlock > 0 THEN
        fDown = fDown * 2
        player.channel(nChannel).oplBlock = player.channel(nChannel).oplBlock - 1
    ELSEIF fDown < 0 THEN
        fDown = 0
    END IF
    player.channel(nChannel).oplFNum = fDown
    Opal_Write player.opl, &HA0 + oplChan, fDown AND &HFF
    DIM regB0Down AS _UNSIGNED _BYTE
    regB0Down = _SHL(player.channel(nChannel).oplBlock AND 7, 2) OR (_SHR(fDown, 8) AND 3)
    IF player.channel(nChannel).subtype = __MODPLAYER_INSTRUMENT_FM_MELODY _ANDALSO player.channel(nChannel).oplKeyOn THEN regB0Down = regB0Down OR &H20
    Opal_Write player.opl, &HB0 + oplChan, regB0Down
END SUB

SUB __MODPlayer_UpdateFMChannelTick (player AS MODPlayer, nChannel AS _UNSIGNED _BYTE, nEffect AS _UNSIGNED _BYTE, nOperand AS _UNSIGNED _BYTE)
    DIM oplChan AS _UNSIGNED _BYTE
    oplChan = player.channel(nChannel).oplChannel
    DIM nOpX AS _UNSIGNED _BYTE: nOpX = _SHR(nOperand, 4)
    DIM nOpY AS _UNSIGNED _BYTE: nOpY = nOperand AND &HF

    SELECT CASE nEffect
        CASE __MODPLAYER_FX_PORTAMENTO_UP, __MODPLAYER_FX_PORTA_EXTRA_FINE_UP
            IF nOperand THEN player.channel(nChannel).lastPortamento = nOperand
            IF player.channel(nChannel).lastPortamento < &HE0 THEN
                __MODPlayer_FMDoPortamentoUp player, nChannel, player.channel(nChannel).lastPortamento
            END IF

        CASE __MODPLAYER_FX_PORTAMENTO_DOWN, __MODPLAYER_FX_PORTA_EXTRA_FINE_DOWN
            IF nOperand THEN player.channel(nChannel).lastPortamento = nOperand
            IF player.channel(nChannel).lastPortamento < &HE0 THEN
                __MODPlayer_FMDoPortamentoDown player, nChannel, player.channel(nChannel).lastPortamento
            END IF

        CASE __MODPLAYER_FX_PORTAMENTO, __MODPLAYER_FX_PORTA_VOL_FINE_SLIDE
            IF player.channel(nChannel).portamentoTo > 0 THEN
                DIM curPitch AS LONG
                curPitch = _SHL(CLNG(player.channel(nChannel).oplFNum), player.channel(nChannel).oplBlock)
                DIM targetPitch AS LONG
                targetPitch = player.channel(nChannel).portamentoTo
                DIM portaSpeed AS LONG
                portaSpeed = _SHL(CLNG(player.channel(nChannel).portamentoSpeed), player.channel(nChannel).oplBlock)
                IF portaSpeed < 1 THEN portaSpeed = 1
                IF curPitch < targetPitch THEN
                    curPitch = curPitch + portaSpeed
                    IF curPitch > targetPitch THEN curPitch = targetPitch
                ELSEIF curPitch > targetPitch THEN
                    curPitch = curPitch - portaSpeed
                    IF curPitch < targetPitch THEN curPitch = targetPitch
                END IF
                DIM newBlock AS LONG: newBlock = 0
                DIM tempPitch AS LONG: tempPitch = curPitch
                DO WHILE tempPitch >= 1024 AND newBlock < 7
                    tempPitch = tempPitch \ 2
                    newBlock = newBlock + 1
                LOOP
                IF tempPitch > 1023 THEN tempPitch = 1023
                player.channel(nChannel).oplFNum = tempPitch
                player.channel(nChannel).oplBlock = newBlock
                Opal_Write player.opl, &HA0 + oplChan, tempPitch AND &HFF
                DIM regB0Porta AS _UNSIGNED _BYTE
                regB0Porta = _SHL(newBlock AND 7, 2) OR (_SHR(tempPitch, 8) AND 3)
                IF player.channel(nChannel).subtype = __MODPLAYER_INSTRUMENT_FM_MELODY _ANDALSO player.channel(nChannel).oplKeyOn THEN regB0Porta = regB0Porta OR &H20
                Opal_Write player.opl, &HB0 + oplChan, regB0Porta
            END IF
    END SELECT
END SUB

''' @brief Processes the current pattern row at tick 0 and sets up note triggers and effects.
SUB __MODPlayer_UpdateRow (player AS MODPlayer)
    SHARED __MODPlayer_PeriodTable() AS _UNSIGNED INTEGER
    DIM AS _UNSIGNED _BYTE nChannel, nNote, nInstrument, nVolume, nEffect, nOperand, nOpX, nOpY
    DIM AS _UNSIGNED LONG c2Speed
    DIM AS _BYTE delayedNoteRow
    ' The effect flags below are set to true when a pattern jump effect and pattern break effect are triggered
    DIM AS _BYTE jumpEffectFlag, breakEffectFlag, noFrequency
    DIM AS LONG targetPatFM
    DIM AS _UNSIGNED _BYTE loopChannelFM

    ' Set the active channel count to zero
    player.song.activeChannels = 0

    ' Process all channels
    FOR nChannel = 0 TO player.song.channels - 1
        nNote = player.pattern(player.song.tickPattern).note(player.song.tickPatternRow, nChannel).note
        nInstrument = player.pattern(player.song.tickPattern).note(player.song.tickPatternRow, nChannel).instrument
        nVolume = player.pattern(player.song.tickPattern).note(player.song.tickPatternRow, nChannel).volume
        nEffect = player.pattern(player.song.tickPattern).note(player.song.tickPatternRow, nChannel).effect
        nOperand = player.pattern(player.song.tickPattern).note(player.song.tickPatternRow, nChannel).operand
        nOpX = _SHR(nOperand, 4)
        nOpY = nOperand AND &HF
        noFrequency = _FALSE

        IF player.channel(nChannel).subtype >= __MODPLAYER_INSTRUMENT_FM_MELODY THEN
            DIM isTonePortaFM AS _BYTE
            isTonePortaFM = (nEffect = __MODPLAYER_FX_PORTAMENTO OR nEffect = __MODPLAYER_FX_PORTA_VOL_FINE_SLIDE)

            IF isTonePortaFM AND player.channel(nChannel).oplKeyOn AND nNote < __MODPLAYER_NOTE_NONE THEN
                DIM targetFNum AS _UNSIGNED INTEGER, targetBlock AS _UNSIGNED _BYTE
                __MODPlayer_GetOPLNotePitch player, nChannel, nNote, targetFNum, targetBlock
                IF targetFNum > 0 THEN player.channel(nChannel).portamentoTo = _SHL(CLNG(targetFNum), targetBlock)
                IF nOperand THEN player.channel(nChannel).portamentoSpeed = nOperand
                __MODPlayer_UpdateFMChannelRow player, nChannel, __MODPLAYER_NOTE_NONE, nInstrument, nVolume
            ELSE
                __MODPlayer_UpdateFMChannelRow player, nChannel, nNote, nInstrument, nVolume
            END IF

            ' S3M song and channel-volume effects remain meaningful on OPL rows.
            IF player.song.isS3M THEN
                SELECT CASE nEffect
                    CASE __MODPLAYER_FX_SPEED
                        IF nOperand THEN player.song.speed = nOperand

                    CASE __MODPLAYER_FX_POSITION_JUMP
                        player.song.orderPosition = nOperand
                        IF player.song.orderPosition >= player.song.orders THEN player.song.orderPosition = player.song.endJumpOrder
                        player.song.patternRow = -1
                        jumpEffectFlag = _TRUE

                    CASE __MODPLAYER_FX_PATTERN_BREAK
                        player.song.patternRow = (nOpX * 10) + nOpY - 1
                        IF NOT breakEffectFlag _ANDALSO NOT jumpEffectFlag THEN
                            IF NOT player.song.isS3M _ORELSE (nOpX = 0 _ANDALSO nOpY = 0) THEN
                                player.song.orderPosition = player.song.orderPosition + 1
                                IF player.song.orderPosition >= player.song.orders THEN player.song.orderPosition = player.song.endJumpOrder
                            END IF
                        END IF
                        IF player.song.orderPosition < player.song.orders THEN
                            targetPatFM = player.order(player.song.orderPosition)
                            IF targetPatFM < player.song.patterns THEN
                                IF player.song.patternRow >= player.pattern(targetPatFM).rows THEN player.song.patternRow = -1
                            END IF
                        END IF
                        breakEffectFlag = _TRUE

                    CASE __MODPLAYER_FX_PORTA_EXTRA_FINE_DOWN
                        IF nOperand THEN player.channel(nChannel).lastPortamento = nOperand
                        IF nOpX = &HF THEN
                            __MODPlayer_FMDoPortamentoDown player, nChannel, nOpY
                        ELSEIF nOpX = &HE THEN
                            __MODPlayer_FMDoPortamentoDown player, nChannel, _SHL(nOpY, 2)
                        END IF

                    CASE __MODPLAYER_FX_PORTA_EXTRA_FINE_UP
                        IF nOperand THEN player.channel(nChannel).lastPortamento = nOperand
                        IF nOpX = &HF THEN
                            __MODPlayer_FMDoPortamentoUp player, nChannel, nOpY
                        ELSEIF nOpX = &HE THEN
                            __MODPlayer_FMDoPortamentoUp player, nChannel, _SHL(nOpY, 2)
                        END IF

                    CASE __MODPLAYER_FX_PORTAMENTO
                        IF nOperand THEN player.channel(nChannel).portamentoSpeed = nOperand

                    CASE __MODPLAYER_FX_PORTA_VOL_FINE_SLIDE
                        IF nOperand THEN player.channel(nChannel).lastVolumeSlide = nOperand

                    CASE __MODPLAYER_FX_PANNING_8
                        __MODPlayer_SetChannelPanning player, nChannel, nOperand

                    CASE __MODPLAYER_FX_STEREO_CONTROL
                        __MODPlayer_SetChannelPanning player, nChannel, nOperand * 17

                    CASE __MODPLAYER_FX_VOLUME_FINE_SLIDE
                        IF nOperand THEN player.channel(nChannel).lastVolumeSlide = nOperand ELSE nOperand = player.channel(nChannel).lastVolumeSlide
                        nOpX = _SHR(nOperand, 4)
                        nOpY = nOperand AND &HF
                        IF nOpY = &HF AND nOpX > 0 THEN
                            player.channel(nChannel).volume = player.channel(nChannel).volume + nOpX
                        ELSEIF nOpX = &HF AND nOpY > 0 THEN
                            player.channel(nChannel).volume = player.channel(nChannel).volume - nOpY
                        ELSEIF nOpX = 0 AND nOpY = &HF AND NOT player.song.useST300VolumeSlides THEN
                            player.channel(nChannel).volume = player.channel(nChannel).volume - 15
                        ELSEIF nOpX = &HF AND nOpY = 0 AND NOT player.song.useST300VolumeSlides THEN
                            player.channel(nChannel).volume = player.channel(nChannel).volume + 15
                        END IF
                        IF player.song.useST300VolumeSlides THEN
                            IF nOpY = 0 THEN player.channel(nChannel).volume = player.channel(nChannel).volume + nOpX
                            IF nOpX = 0 THEN player.channel(nChannel).volume = player.channel(nChannel).volume - nOpY
                        END IF
                        player.channel(nChannel).volume = _CLAMP(player.channel(nChannel).volume, 0, __MODPLAYER_INSTRUMENT_VOLUME_MAX)
                        __MODPlayer_UpdateFMVolume player, nChannel

                    CASE __MODPLAYER_FX_VIBRATO_VOL_FINE_SLIDE, __MODPLAYER_FX_PORTA_VOL_FINE_SLIDE
                        IF nOperand THEN player.channel(nChannel).lastVolumeSlide = nOperand

                    CASE __MODPLAYER_FX_TREMOR
                        IF nOperand THEN
                            player.channel(nChannel).tremorOnTicks = nOpX + 1
                            player.channel(nChannel).tremorOffTicks = nOpY + 1
                            player.channel(nChannel).tremorPosition = 0
                        END IF
                        __MODPlayer_DoS3MTremor player, nChannel
                        __MODPlayer_UpdateFMVolume player, nChannel

                    CASE __MODPLAYER_FX_CHANNEL_VOLUME
                        IF nOperand <= __MODPLAYER_S3M_GLOBAL_VOLUME_MAX THEN
                            player.channel(nChannel).channelVolume = nOperand
                            __MODPlayer_UpdateFMVolume player, nChannel
                        END IF

                    CASE __MODPLAYER_FX_CHANNEL_VOLUME_SLIDE
                        __MODPlayer_DoS3MChannelVolumeSlide player, nChannel, nOperand, _TRUE
                        __MODPlayer_UpdateFMVolume player, nChannel

                    CASE __MODPLAYER_FX_GLOBAL_VOLUME
                        IF nOperand <= __MODPLAYER_S3M_GLOBAL_VOLUME_MAX THEN __MODPlayer_SetGlobalVolume player, nOperand

                    CASE __MODPLAYER_FX_GLOBAL_VOLUME_SLIDE
                        __MODPlayer_DoS3MGlobalVolumeSlide player, nChannel, nOperand, _TRUE

                    CASE __MODPLAYER_FX_TEMPO
                        IF nOperand THEN player.channel(nChannel).lastTempo = nOperand ELSE nOperand = player.channel(nChannel).lastTempo
                        IF nOperand >= 32 THEN __MODPlayer_SetBPM player, nOperand

                    CASE __MODPLAYER_FX_PATTERN_FINE_DELAY
                        player.song.rowTickDelay = player.song.rowTickDelay + nOperand

                    CASE __MODPLAYER_FX_EXT
                        IF nOpX = __MODPLAYER_FX_EXT_PATTERN_DELAY THEN
                            IF player.song.patternDelay = 0 AND nOpY > 0 THEN player.song.patternDelay = nOpY
                        ELSEIF nOpX = __MODPLAYER_FX_EXT_PATTERN_LOOP THEN
                            loopChannelFM = 0
                            IF nOpY = 0 THEN
                                player.channel(loopChannelFM).patternLoopRow = player.song.tickPatternRow
                            ELSE
                                IF player.channel(loopChannelFM).patternLoopRowCounter = 0 THEN
                                    player.channel(loopChannelFM).patternLoopRowCounter = nOpY
                                ELSE
                                    player.channel(loopChannelFM).patternLoopRowCounter = player.channel(loopChannelFM).patternLoopRowCounter - 1
                                END IF
                                IF player.channel(loopChannelFM).patternLoopRowCounter THEN
                                    player.song.patternRow = player.channel(loopChannelFM).patternLoopRow - 1
                                ELSEIF player.song.isS3M THEN
                                    player.channel(loopChannelFM).patternLoopRow = player.song.tickPatternRow + 1
                                END IF
                            END IF
                        END IF
                END SELECT
            END IF
            _CONTINUE
        END IF

        ' Restore the steady pan and release any tremor gate from the previous row.
        IF player.channel(nChannel).panbrelloActive THEN
            player.channel(nChannel).panbrelloActive = _FALSE
            __MODPlayer_SetChannelPanning player, nChannel, player.channel(nChannel).panbrelloBasePanning
        END IF
        IF player.song.isS3M _ANDALSO player.channel(nChannel).tremorMuted _ANDALSO nEffect <> __MODPLAYER_FX_TREMOR THEN
            player.channel(nChannel).tremorMuted = _FALSE
            __MODPlayer_ApplyChannelVolume player, nChannel
        END IF

        delayedNoteRow = (nEffect = __MODPLAYER_FX_EXT _ANDALSO nOpX = __MODPLAYER_FX_EXT_NOTE_DELAY _ANDALSO nOpY > 0)
        IF player.song.isS3M _ANDALSO nEffect = __MODPLAYER_FX_EXT _ANDALSO nOpX = __MODPLAYER_FX_EXT_NOTE_DELAY THEN delayedNoteRow = _TRUE
        player.channel(nChannel).noteDelayPending = _FALSE

        IF delayedNoteRow THEN
            noFrequency = _TRUE
            IF (nNote < __MODPLAYER_NOTE_NONE OR nNote = __MODPLAYER_NOTE_KEY_OFF) _ANDALSO nOpY > 0 _ANDALSO nOpY < player.song.speed THEN
                IF nNote < __MODPLAYER_NOTE_NONE _ANDALSO nInstrument = 0 THEN player.channel(nChannel).startPosition = 0
                player.channel(nChannel).noteDelayPending = _TRUE
                player.channel(nChannel).noteDelayTick = nOpY
                player.channel(nChannel).delayedNote = nNote
                player.channel(nChannel).delayedHasInstrument = (nInstrument > 0)
                player.channel(nChannel).delayedInstrument = player.channel(nChannel).instrument
                player.channel(nChannel).delayedStartPosition = player.channel(nChannel).startPosition
                IF nInstrument THEN
                    player.channel(nChannel).delayedInstrument = nInstrument - 1
                    player.channel(nChannel).delayedStartPosition = 0
                END IF
                player.channel(nChannel).delayedVolume = nVolume
                c2Speed = player.channel(nChannel).c2Spd
                IF c2Speed = 0 THEN c2Speed = player.instrument(player.channel(nChannel).delayedInstrument).c2Spd
                IF c2Speed = 0 THEN c2Speed = 8363
                IF nNote < __MODPLAYER_NOTE_NONE THEN
                    player.channel(nChannel).delayedPeriod = (8363 * __MODPlayer_PeriodTable(nNote)) \ c2Speed
                ELSE
                    player.channel(nChannel).delayedPeriod = player.channel(nChannel).period
                END IF
            END IF
            player.channel(nChannel).restart = _FALSE
        ELSE
            ' S3M instrument numbers are 1-based in the file and 0-based in this player.
            IF nInstrument THEN
                player.channel(nChannel).instrument = nInstrument - 1
                player.channel(nChannel).startPosition = 0
                player.channel(nChannel).volume = player.instrument(player.channel(nChannel).instrument).volume
            END IF

            IF nNote < __MODPLAYER_NOTE_NONE THEN
                player.channel(nChannel).startPosition = 0
                c2Speed = player.channel(nChannel).c2Spd
                IF c2Speed = 0 THEN c2Speed = player.instrument(player.channel(nChannel).instrument).c2Spd
                IF c2Speed = 0 THEN c2Speed = 8363
                player.channel(nChannel).lastPeriod = (8363 * __MODPlayer_PeriodTable(nNote)) \ c2Speed
                player.channel(nChannel).note = nNote
                player.channel(nChannel).restart = _TRUE
                player.song.activeChannels = nChannel

                ' Retrigger tremolo and vibrato waveforms
                IF player.channel(nChannel).waveControl AND &HF < 4 THEN player.channel(nChannel).vibratoPosition = 0
                IF _SHR(player.channel(nChannel).waveControl, 4) < 4 THEN player.channel(nChannel).tremoloPosition = 0

                ' A tone-portamento volume column keeps the current note running.
                IF nEffect <> __MODPLAYER_FX_PORTAMENTO _ANDALSO nEffect <> __MODPLAYER_FX_PORTAMENTO_VOLUME_SLIDE _ANDALSO nEffect <> __MODPLAYER_FX_PORTA_VOL_FINE_SLIDE _ANDALSO NOT (player.song.isS3M _ANDALSO nVolume = 125) THEN
                    player.channel(nChannel).period = player.channel(nChannel).lastPeriod
                END IF
            ELSE
                player.channel(nChannel).restart = _FALSE
            END IF
        END IF

        IF NOT delayedNoteRow _ANDALSO nVolume <= __MODPLAYER_INSTRUMENT_VOLUME_MAX THEN
            player.channel(nChannel).volume = nVolume
        ELSEIF NOT delayedNoteRow _ANDALSO player.song.isS3M THEN
            SELECT CASE nVolume
                CASE 65 TO 74
                    player.channel(nChannel).volume = _CLAMP(player.channel(nChannel).volume + nVolume - 65, 0, __MODPLAYER_INSTRUMENT_VOLUME_MAX)
                CASE 75 TO 84
                    player.channel(nChannel).volume = _CLAMP(player.channel(nChannel).volume - nVolume + 75, 0, __MODPLAYER_INSTRUMENT_VOLUME_MAX)
                CASE 128 TO 192
                    __MODPlayer_SetChannelPanning player, nChannel, (nVolume - 128) * 4
            END SELECT
        END IF

        IF nNote = __MODPLAYER_NOTE_KEY_OFF THEN
            player.channel(nChannel).volume = 0
            IF player.song.isS3M THEN SoftSynth_StopVoice player.synth, nChannel
        END IF
        IF player.song.isS3M _ANDALSO nVolume = 125 _ANDALSO nNote < __MODPLAYER_NOTE_NONE _ANDALSO NOT delayedNoteRow THEN
            player.channel(nChannel).portamentoTo = player.channel(nChannel).lastPeriod
            player.channel(nChannel).restart = _FALSE
        END IF

        ' Process tick 0 effects
        SELECT CASE nEffect
            CASE __MODPLAYER_FX_PORTAMENTO
                IF nOperand THEN player.channel(nChannel).portamentoSpeed = nOperand
                player.channel(nChannel).portamentoTo = player.channel(nChannel).lastPeriod
                player.channel(nChannel).restart = _FALSE

            CASE __MODPLAYER_FX_PORTAMENTO_VOLUME_SLIDE
                player.channel(nChannel).portamentoTo = player.channel(nChannel).lastPeriod
                player.channel(nChannel).restart = _FALSE

            CASE __MODPLAYER_FX_VIBRATO
                IF nOpX THEN player.channel(nChannel).vibratoSpeed = nOpX
                IF nOpY THEN player.channel(nChannel).vibratoDepth = nOpY

            CASE __MODPLAYER_FX_TREMOLO
                IF nOpX THEN player.channel(nChannel).tremoloSpeed = nOpX
                IF nOpY THEN player.channel(nChannel).tremoloDepth = nOpY

            CASE __MODPLAYER_FX_PANNING_8
                ' Don't care about DMP panning BS. We are doing this Fasttracker style
                __MODPlayer_SetChannelPanning player, nChannel, nOperand

            CASE __MODPLAYER_FX_SAMPLE_OFFSET
                IF player.song.isS3M THEN
                    IF nOperand THEN player.channel(nChannel).lastSampleOffset = nOperand ELSE nOperand = player.channel(nChannel).lastSampleOffset
                END IF
                IF nNote < __MODPLAYER_NOTE_NONE THEN
                    player.channel(nChannel).startPosition = _SHL(nOperand, 8)
                    IF player.instrument(player.channel(nChannel).instrument).playMode = SOFTSYNTH_VOICE_PLAY_FORWARD_LOOP _ANDALSO player.instrument(player.channel(nChannel).instrument).loopEnd > player.instrument(player.channel(nChannel).instrument).loopStart _ANDALSO player.channel(nChannel).startPosition >= player.instrument(player.channel(nChannel).instrument).loopEnd THEN
                        player.channel(nChannel).startPosition = player.instrument(player.channel(nChannel).instrument).loopStart + ((player.channel(nChannel).startPosition - player.instrument(player.channel(nChannel).instrument).loopStart) MOD (player.instrument(player.channel(nChannel).instrument).loopEnd - player.instrument(player.channel(nChannel).instrument).loopStart))
                    ELSEIF player.channel(nChannel).startPosition > player.instrument(player.channel(nChannel).instrument).length THEN
                        player.channel(nChannel).startPosition = player.instrument(player.channel(nChannel).instrument).length
                    END IF
                END IF

            CASE __MODPLAYER_FX_POSITION_JUMP
                player.song.orderPosition = nOperand
                IF player.song.orderPosition >= player.song.orders THEN player.song.orderPosition = player.song.endJumpOrder
                player.song.patternRow = -1 ' This will increment right after & we will start at 0
                jumpEffectFlag = _TRUE

            CASE __MODPLAYER_FX_VOLUME
                player.channel(nChannel).volume = nOperand ' Operand can never be -ve cause it is unsigned. So we only clip for max below
                IF player.channel(nChannel).volume > __MODPLAYER_INSTRUMENT_VOLUME_MAX THEN player.channel(nChannel).volume = __MODPLAYER_INSTRUMENT_VOLUME_MAX

            CASE __MODPLAYER_FX_PATTERN_BREAK
                player.song.patternRow = (nOpX * 10) + nOpY - 1
                IF NOT breakEffectFlag _ANDALSO NOT jumpEffectFlag THEN
                    IF NOT player.song.isS3M _ORELSE (nOpX = 0 _ANDALSO nOpY = 0) THEN
                        player.song.orderPosition = player.song.orderPosition + 1
                        IF player.song.orderPosition >= player.song.orders THEN player.song.orderPosition = player.song.endJumpOrder
                    END IF
                END IF
                IF player.song.orderPosition < player.song.orders THEN
                    DIM targetPat AS LONG: targetPat = player.order(player.song.orderPosition)
                    IF targetPat < player.song.patterns THEN
                        IF player.song.patternRow >= player.pattern(targetPat).rows THEN player.song.patternRow = -1
                    END IF
                END IF
                breakEffectFlag = _TRUE

            CASE __MODPLAYER_FX_EXT
                SELECT CASE nOpX
                    CASE __MODPLAYER_FX_EXT_FILTER
                        player.song.useAmigaLPF = (nOpY <> _FALSE)

                    CASE __MODPLAYER_FX_EXT_PORTAMENTO_FINE_UP
                        player.channel(nChannel).period = player.channel(nChannel).period - _SHL(nOpY, 2)

                    CASE __MODPLAYER_FX_EXT_PORTAMENTO_FINE_DOWN
                        player.channel(nChannel).period = player.channel(nChannel).period + _SHL(nOpY, 2)

                    CASE __MODPLAYER_FX_EXT_GLISSANDO_CONTROL
                        player.channel(nChannel).useGlissando = (nOpY <> _FALSE)

                    CASE __MODPLAYER_FX_EXT_VIBRATO_WAVEFORM
                        player.channel(nChannel).waveControl = player.channel(nChannel).waveControl AND &HF0
                        player.channel(nChannel).waveControl = player.channel(nChannel).waveControl OR nOpY

                    CASE __MODPLAYER_FX_EXT_FINETUNE
                        player.channel(nChannel).c2Spd = __MODPlayer_GetS3MC2Spd(nOpY)
                        IF player.channel(nChannel).note < __MODPLAYER_NOTE_NONE THEN
                            player.channel(nChannel).lastPeriod = (8363 * __MODPlayer_PeriodTable(player.channel(nChannel).note)) \ player.channel(nChannel).c2Spd
                            IF player.song.isS3M THEN
                                player.channel(nChannel).period = player.channel(nChannel).lastPeriod
                            ELSEIF nNote < __MODPLAYER_NOTE_NONE _ANDALSO nEffect <> __MODPLAYER_FX_PORTAMENTO _ANDALSO nEffect <> __MODPLAYER_FX_PORTAMENTO_VOLUME_SLIDE _ANDALSO nEffect <> __MODPLAYER_FX_PORTA_VOL_FINE_SLIDE THEN
                                player.channel(nChannel).period = player.channel(nChannel).lastPeriod
                            END IF
                        END IF

                    CASE __MODPLAYER_FX_EXT_PATTERN_LOOP
                        DIM loopChannel AS _UNSIGNED _BYTE
                        loopChannel = nChannel
                        IF player.song.isS3M THEN loopChannel = 0
                        IF nOpY = 0 THEN
                            player.channel(loopChannel).patternLoopRow = player.song.tickPatternRow
                        ELSE
                            IF player.channel(loopChannel).patternLoopRowCounter = 0 THEN
                                player.channel(loopChannel).patternLoopRowCounter = nOpY
                            ELSE
                                player.channel(loopChannel).patternLoopRowCounter = player.channel(loopChannel).patternLoopRowCounter - 1
                            END IF
                            IF player.channel(loopChannel).patternLoopRowCounter THEN
                                player.song.patternRow = player.channel(loopChannel).patternLoopRow - 1
                            ELSEIF player.song.isS3M THEN
                                player.channel(loopChannel).patternLoopRow = player.song.tickPatternRow + 1
                            END IF
                        END IF

                    CASE __MODPLAYER_FX_EXT_TREMOLO_WAVEFORM
                        player.channel(nChannel).waveControl = player.channel(nChannel).waveControl AND &HF
                        player.channel(nChannel).waveControl = player.channel(nChannel).waveControl OR _SHL(nOpY, 4)

                    CASE __MODPLAYER_FX_EXT_PANNING_4
                        IF nOpY > 15 THEN nOpY = 15
                        __MODPlayer_SetChannelPanning player, nChannel, nOpY * 17

                    CASE __MODPLAYER_FX_EXT_VOL_FINE_SLIDE_UP
                        player.channel(nChannel).volume = player.channel(nChannel).volume + nOpY
                        IF player.channel(nChannel).volume > __MODPLAYER_INSTRUMENT_VOLUME_MAX THEN player.channel(nChannel).volume = __MODPLAYER_INSTRUMENT_VOLUME_MAX

                    CASE __MODPLAYER_FX_EXT_VOL_FINE_SLIDE_DOWN
                        player.channel(nChannel).volume = player.channel(nChannel).volume - nOpY
                        IF player.channel(nChannel).volume < 0 THEN player.channel(nChannel).volume = 0

                    CASE __MODPLAYER_FX_EXT_NOTE_DELAY
                        IF nOpY > 0 THEN noFrequency = _TRUE

                    CASE __MODPLAYER_FX_EXT_PATTERN_DELAY
                        IF player.song.patternDelay = 0 AND nOpY > 0 THEN player.song.patternDelay = nOpY

                    CASE __MODPLAYER_FX_EXT_INVERT_LOOP
                        player.channel(nChannel).invertLoopSpeed = nOpY
                END SELECT

            CASE __MODPLAYER_FX_SPEED_TEMPO
                IF nOperand < 32 THEN
                    player.song.speed = nOperand
                ELSE
                    __MODPlayer_SetBPM player, nOperand
                END IF

            CASE __MODPLAYER_FX_SPEED
                IF nOperand THEN player.song.speed = nOperand

            CASE __MODPLAYER_FX_VOLUME_FINE_SLIDE
                IF player.song.isS3M THEN
                    IF nOperand THEN player.channel(nChannel).lastVolumeSlide = nOperand ELSE nOperand = player.channel(nChannel).lastVolumeSlide
                    nOpX = _SHR(nOperand, 4)
                    nOpY = nOperand AND &HF
                ELSE
                    IF nOperand THEN player.channel(nChannel).lastVolumeSlide = nOperand
                END IF

                ' DxF is fine up; DFy is fine down. DFF is the special fine-up-by-15 case.
                IF nOpY = &HF AND nOpX > 0 THEN
                    player.channel(nChannel).volume = player.channel(nChannel).volume + nOpX
                ELSEIF nOpX = &HF AND nOpY > 0 THEN
                    player.channel(nChannel).volume = player.channel(nChannel).volume - nOpY
                ELSEIF nOpX = 0 AND nOpY = &HF AND NOT player.song.useST300VolumeSlides THEN
                    player.channel(nChannel).volume = player.channel(nChannel).volume - 15
                ELSEIF nOpX = &HF AND nOpY = 0 AND NOT player.song.useST300VolumeSlides THEN
                    player.channel(nChannel).volume = player.channel(nChannel).volume + 15
                END IF

                ' ST3.00 also performs ordinary Dxy slides on the row tick.
                IF player.song.useST300VolumeSlides THEN
                    IF nOpY = 0 THEN player.channel(nChannel).volume = player.channel(nChannel).volume + nOpX
                    IF nOpX = 0 THEN player.channel(nChannel).volume = player.channel(nChannel).volume - nOpY
                END IF
                player.channel(nChannel).volume = _CLAMP(player.channel(nChannel).volume, 0, __MODPLAYER_INSTRUMENT_VOLUME_MAX)

            CASE __MODPLAYER_FX_PORTA_EXTRA_FINE_DOWN
                IF nOperand THEN player.channel(nChannel).lastPortamento = nOperand
                IF player.channel(nChannel).period > 0 THEN
                    IF nOpX = &HF THEN
                        player.channel(nChannel).period = player.channel(nChannel).period + _SHL(nOpY, 2)
                    ELSEIF nOpX = &HE THEN
                        player.channel(nChannel).period = player.channel(nChannel).period + nOpY
                    END IF
                END IF

            CASE __MODPLAYER_FX_PORTA_EXTRA_FINE_UP
                IF nOperand THEN player.channel(nChannel).lastPortamento = nOperand
                IF player.channel(nChannel).period > 0 THEN
                    IF nOpX = &HF THEN
                        player.channel(nChannel).period = player.channel(nChannel).period - _SHL(nOpY, 2)
                    ELSEIF nOpX = &HE THEN
                        player.channel(nChannel).period = player.channel(nChannel).period - nOpY
                    END IF
                    IF player.channel(nChannel).period < 1 THEN player.channel(nChannel).period = 1
                END IF

            CASE __MODPLAYER_FX_TREMOR
                IF nOperand THEN
                    player.channel(nChannel).tremorOnTicks = nOpX + 1
                    player.channel(nChannel).tremorOffTicks = nOpY + 1
                    player.channel(nChannel).tremorPosition = 0
                END IF
                __MODPlayer_DoS3MTremor player, nChannel

            CASE __MODPLAYER_FX_VIBRATO_VOL_FINE_SLIDE
                IF nOperand THEN player.channel(nChannel).lastVolumeSlide = nOperand
                noFrequency = _TRUE

            CASE __MODPLAYER_FX_PORTA_VOL_FINE_SLIDE
                IF nOperand THEN player.channel(nChannel).lastVolumeSlide = nOperand
                player.channel(nChannel).portamentoTo = player.channel(nChannel).lastPeriod
                player.channel(nChannel).restart = _FALSE

            CASE __MODPLAYER_FX_CHANNEL_VOLUME
                IF nOperand <= __MODPLAYER_S3M_GLOBAL_VOLUME_MAX THEN
                    player.channel(nChannel).channelVolume = nOperand
                    __MODPlayer_ApplyChannelVolume player, nChannel
                END IF

            CASE __MODPLAYER_FX_CHANNEL_VOLUME_SLIDE
                __MODPlayer_DoS3MChannelVolumeSlide player, nChannel, nOperand, _TRUE

            CASE __MODPLAYER_FX_PANNING_FINE_SLIDE
                __MODPlayer_DoS3MPanningSlide player, nChannel, nOperand, _TRUE

            CASE __MODPLAYER_FX_NOTE_RETRIGGER_VOL_SLIDE
                IF nOperand THEN
                    player.channel(nChannel).retriggerVolumeSlide = nOpX
                    player.channel(nChannel).retriggerTickCount = nOpY
                END IF

            CASE __MODPLAYER_FX_PANBRELLO_WAVEFORM
                player.channel(nChannel).panbrelloWaveform = nOperand AND 3

            CASE __MODPLAYER_FX_PATTERN_FINE_DELAY
                player.song.rowTickDelay = player.song.rowTickDelay + nOperand

            CASE __MODPLAYER_FX_SOUND_CONTROL
                SELECT CASE nOperand
                    CASE 0
                        SoftSynth_SetVoiceSurround player.synth, nChannel, _FALSE
                        __MODPlayer_SetChannelPanning player, nChannel, player.channel(nChannel).panning
                    CASE 1
                        SoftSynth_SetVoiceBalance player.synth, nChannel, SOFTSYNTH_VOICE_PAN_CENTER
                        SoftSynth_SetVoiceSurround player.synth, nChannel, _TRUE
                END SELECT

            CASE __MODPLAYER_FX_HIGH_OFFSET
                ' Reserved by ST3.20; ignored by this PCM player.

            CASE __MODPLAYER_FX_STEREO_CONTROL
                SELECT CASE nOperand
                    CASE 0, 2
                        __MODPlayer_SetChannelPanning player, nChannel, player.channel(nChannel).defaultPanning
                    CASE 1, 3
                        __MODPlayer_SetChannelPanning player, nChannel, 255 - player.channel(nChannel).defaultPanning
                    CASE 4 TO 7
                        __MODPlayer_SetChannelPanning player, nChannel, 128
                END SELECT

            CASE __MODPLAYER_FX_TEMPO
                IF nOperand THEN player.channel(nChannel).lastTempo = nOperand ELSE nOperand = player.channel(nChannel).lastTempo
                IF nOperand >= 32 THEN __MODPlayer_SetBPM player, nOperand

            CASE __MODPLAYER_FX_VIBRATO_FINE
                IF nOpX THEN player.channel(nChannel).vibratoSpeed = nOpX
                IF nOpY THEN player.channel(nChannel).vibratoDepth = nOpY

            CASE __MODPLAYER_FX_GLOBAL_VOLUME
                ' ST3 ignores out-of-range values.
                IF nOperand <= __MODPLAYER_S3M_GLOBAL_VOLUME_MAX THEN __MODPlayer_SetGlobalVolume player, nOperand

            CASE __MODPLAYER_FX_GLOBAL_VOLUME_SLIDE
                __MODPlayer_DoS3MGlobalVolumeSlide player, nChannel, nOperand, _TRUE

            CASE __MODPLAYER_FX_PANBRELLO
                IF nOpX THEN player.channel(nChannel).panbrelloSpeed = nOpX
                IF nOpY THEN player.channel(nChannel).panbrelloDepth = nOpY
                player.channel(nChannel).panbrelloBasePanning = player.channel(nChannel).panning
                player.channel(nChannel).panbrelloActive = _TRUE

            CASE __MODPLAYER_FX_MIDI_MACRO
                ' Zxx requires a MIDI macro bank, which this PCM player does not expose.

        END SELECT

        __MODPlayer_DoInvertLoop player, nChannel ' called every row

        DIM isAMInst AS _BYTE: isAMInst = _FALSE
        DIM amCheckIdx AS LONG: amCheckIdx = player.channel(nChannel).instrument
        IF amCheckIdx >= 0 _ANDALSO amCheckIdx < player.song.instruments THEN
            IF player.instrument(amCheckIdx).subtype = __MODPLAYER_INSTRUMENT_AM_SYNTH THEN isAMInst = _TRUE
        END IF

        IF NOT isAMInst THEN
            IF NOT noFrequency THEN
                IF nEffect <> __MODPLAYER_FX_TREMOLO THEN
                    __MODPlayer_ApplyChannelVolume player, nChannel
                ELSEIF player.song.isS3M THEN
                    __MODPlayer_ApplyChannelVolume player, nChannel
                END IF
                IF player.channel(nChannel).period > 0 THEN
                    SoftSynth_SetVoiceFrequency player.synth, nChannel, __MODPlayer_GetFrequencyFromPeriod(player.channel(nChannel).period)
                END IF
            ELSEIF delayedNoteRow THEN
                __MODPlayer_ApplyChannelVolume player, nChannel
            END IF
        END IF
    NEXT

    ' Now play all samples that needs to be played
    FOR nChannel = 0 TO player.song.activeChannels
        IF player.channel(nChannel).restart THEN
            __MODPlayer_PlayPCMChannelVoice player, nChannel
        ELSE
            DIM amSustainIdx AS LONG: amSustainIdx = player.channel(nChannel).instrument
            IF amSustainIdx >= 0 _ANDALSO amSustainIdx < player.song.instruments THEN
                IF player.instrument(amSustainIdx).subtype = __MODPLAYER_INSTRUMENT_AM_SYNTH THEN
                    __MODPlayer_ProcessAMChannelTick player, nChannel
                END IF
            END IF
        END IF
    NEXT
END SUB

''' @brief Processes tick-based modulation effects (vibrato, tremolo, slides, retrigger) on ticks > 0.
SUB __MODPlayer_UpdateTick (player AS MODPlayer)
    SHARED __MODPlayer_PeriodTable() AS _UNSIGNED INTEGER
    DIM AS _UNSIGNED _BYTE nChannel, nVolume, nEffect, nOperand, nOpX, nOpY

    ' Process all channels
    FOR nChannel = 0 TO player.song.channels - 1
        IF player.channel(nChannel).subtype >= __MODPLAYER_INSTRUMENT_FM_MELODY THEN
            nVolume = player.pattern(player.song.tickPattern).note(player.song.tickPatternRow, nChannel).volume
            nEffect = player.pattern(player.song.tickPattern).note(player.song.tickPatternRow, nChannel).effect
            nOperand = player.pattern(player.song.tickPattern).note(player.song.tickPatternRow, nChannel).operand
            IF player.song.isS3M THEN
                SELECT CASE nEffect
                    CASE __MODPLAYER_FX_VOLUME_FINE_SLIDE
                        DIM fmSlideParam AS _UNSIGNED _BYTE
                        DIM fmSlideX AS _UNSIGNED _BYTE
                        DIM fmSlideY AS _UNSIGNED _BYTE
                        DIM fmIsFine AS _BYTE
                        fmSlideParam = player.channel(nChannel).lastVolumeSlide
                        IF nOperand THEN fmSlideParam = nOperand
                        fmSlideX = _SHR(fmSlideParam, 4)
                        fmSlideY = fmSlideParam AND &HF
                        fmIsFine = _FALSE
                        IF fmSlideY = &HF AND fmSlideX > 0 THEN fmIsFine = _TRUE
                        IF fmSlideX = &HF AND fmSlideY > 0 THEN fmIsFine = _TRUE
                        IF NOT fmIsFine THEN
                            IF fmSlideY > 0 THEN fmSlideX = 0
                            __MODPlayer_DoVolumeSlide player, nChannel, fmSlideX, fmSlideY, _TRUE
                            __MODPlayer_UpdateFMVolume player, nChannel
                        END IF

                    CASE __MODPLAYER_FX_VIBRATO_VOL_FINE_SLIDE, __MODPLAYER_FX_PORTA_VOL_FINE_SLIDE
                        __MODPlayer_DoVolumeSlide player, nChannel, _SHR(player.channel(nChannel).lastVolumeSlide, 4), player.channel(nChannel).lastVolumeSlide AND &HF, _TRUE
                        __MODPlayer_UpdateFMVolume player, nChannel

                    CASE __MODPLAYER_FX_CHANNEL_VOLUME_SLIDE
                        __MODPlayer_DoS3MChannelVolumeSlide player, nChannel, nOperand, _FALSE
                        __MODPlayer_UpdateFMVolume player, nChannel

                    CASE __MODPLAYER_FX_GLOBAL_VOLUME_SLIDE
                        __MODPlayer_DoS3MGlobalVolumeSlide player, nChannel, nOperand, _FALSE

                    CASE __MODPLAYER_FX_TEMPO
                        IF nOperand < 32 THEN __MODPlayer_DoS3MTempoSlide player, nChannel, nOperand

                    CASE __MODPLAYER_FX_TREMOR
                        __MODPlayer_DoS3MTremor player, nChannel
                        __MODPlayer_UpdateFMVolume player, nChannel
                END SELECT
            END IF
            __MODPlayer_UpdateFMChannelTick player, nChannel, nEffect, nOperand
            _CONTINUE
        END IF

        ' Tick effects also control S3M volume, panning, and tempo on silent channels.
        nVolume = player.pattern(player.song.tickPattern).note(player.song.tickPatternRow, nChannel).volume
        nEffect = player.pattern(player.song.tickPattern).note(player.song.tickPatternRow, nChannel).effect
        nOperand = player.pattern(player.song.tickPattern).note(player.song.tickPatternRow, nChannel).operand
        nOpX = _SHR(nOperand, 4)
        nOpY = nOperand AND &HF
        __MODPlayer_TriggerDelayedNote player, nChannel

        IF player.song.isS3M _ORELSE player.channel(nChannel).period > 0 THEN
            IF player.channel(nChannel).period > 0 THEN __MODPlayer_DoInvertLoop player, nChannel ' called every tick

            SELECT CASE nEffect
                CASE __MODPLAYER_FX_ARPEGGIO
                    IF nOperand _ANDALSO player.channel(nChannel).period > 0 THEN
                        SELECT CASE player.song.tick MOD 3
                            CASE 0
                                SoftSynth_SetVoiceFrequency player.synth, nChannel, __MODPlayer_GetFrequencyFromPeriod(player.channel(nChannel).period)
                            CASE 1
                                SoftSynth_SetVoiceFrequency player.synth, nChannel, __MODPlayer_GetFrequencyFromPeriod(__MODPlayer_PeriodTable(player.channel(nChannel).note + nOpX))
                            CASE 2
                                SoftSynth_SetVoiceFrequency player.synth, nChannel, __MODPlayer_GetFrequencyFromPeriod(__MODPlayer_PeriodTable(player.channel(nChannel).note + nOpY))
                        END SELECT
                    END IF

                CASE __MODPLAYER_FX_PORTAMENTO_UP
                    IF player.channel(nChannel).period > 0 THEN
                        player.channel(nChannel).period = player.channel(nChannel).period - _SHL(nOperand, 2)
                        IF player.channel(nChannel).period < 1 THEN player.channel(nChannel).period = 1 ' clamp to avoid division by zero
                        SoftSynth_SetVoiceFrequency player.synth, nChannel, __MODPlayer_GetFrequencyFromPeriod(player.channel(nChannel).period)
                    END IF

                CASE __MODPLAYER_FX_PORTAMENTO_DOWN
                    IF player.channel(nChannel).period > 0 THEN
                        player.channel(nChannel).period = player.channel(nChannel).period + _SHL(nOperand, 2)
                        SoftSynth_SetVoiceFrequency player.synth, nChannel, __MODPlayer_GetFrequencyFromPeriod(player.channel(nChannel).period)
                    END IF

                CASE __MODPLAYER_FX_PORTAMENTO
                    IF player.channel(nChannel).period > 0 THEN __MODPlayer_DoPortamento player, nChannel

                CASE __MODPLAYER_FX_VIBRATO
                    IF player.channel(nChannel).period > 0 THEN __MODPlayer_DoVibrato player, nChannel, _TRUE ' true here means not fine vibrato

                CASE __MODPLAYER_FX_PORTAMENTO_VOLUME_SLIDE
                    IF player.channel(nChannel).period > 0 THEN __MODPlayer_DoPortamento player, nChannel
                    __MODPlayer_DoVolumeSlide player, nChannel, nOpX, nOpY, _TRUE ' true here means not fine volume slide

                CASE __MODPLAYER_FX_VIBRATO_VOLUME_SLIDE
                    IF player.channel(nChannel).period > 0 THEN __MODPlayer_DoVibrato player, nChannel, _TRUE ' true here means not fine vibrato
                    __MODPlayer_DoVolumeSlide player, nChannel, nOpX, nOpY, _TRUE ' true here means not fine volume slide

                CASE __MODPLAYER_FX_TREMOLO
                    __MODPlayer_DoTremolo player, nChannel

                CASE __MODPLAYER_FX_VOLUME_SLIDE
                    __MODPlayer_DoVolumeSlide player, nChannel, nOpX, nOpY, _TRUE ' true here means not fine volume slide

                CASE __MODPLAYER_FX_EXT
                    SELECT CASE nOpX
                        CASE __MODPLAYER_FX_EXT_NOTE_RETRIGGER
                            IF nOpY <> 0 THEN
                                IF player.song.tick MOD nOpY = 0 THEN
                                    __MODPlayer_PlayPCMChannelVoice player, nChannel
                                END IF
                            END IF

                        CASE __MODPLAYER_FX_EXT_NOTE_CUT
                            IF player.song.tick = nOpY THEN
                                IF nOpY > 0 OR NOT player.song.isS3M THEN
                                    player.channel(nChannel).volume = 0
                                    IF player.song.isS3M THEN SoftSynth_StopVoice player.synth, nChannel
                                    __MODPlayer_ApplyChannelVolume player, nChannel
                                END IF
                            END IF

                        CASE __MODPLAYER_FX_EXT_NOTE_DELAY
                            ' Triggering is handled before effect dispatch so an initial note can be delayed too.
                    END SELECT

                CASE __MODPLAYER_FX_VOLUME_FINE_SLIDE
                    DIM slideParam AS _UNSIGNED _BYTE
                    DIM slideX AS _UNSIGNED _BYTE
                    DIM slideY AS _UNSIGNED _BYTE
                    slideParam = player.channel(nChannel).lastVolumeSlide
                    IF nOperand THEN slideParam = nOperand
                    slideX = _SHR(slideParam, 4)
                    slideY = slideParam AND &HF
                    IF slideY = &HF AND slideX > 0 THEN
                        ' Fine slide: already applied at tick 0.
                    ELSEIF slideX = &HF _ANDALSO slideY > 0 THEN
                        ' Fine slide: already applied at tick 0.
                    ELSE
                        ' In S3M, a nonzero low nibble selects the downward slide.
                        IF slideY > 0 THEN slideX = 0
                        __MODPlayer_DoVolumeSlide player, nChannel, slideX, slideY, _TRUE
                    END IF

                CASE __MODPLAYER_FX_PORTA_EXTRA_FINE_DOWN
                    IF player.channel(nChannel).period > 0 _ANDALSO player.channel(nChannel).lastPortamento < &HE0 THEN
                        player.channel(nChannel).period = player.channel(nChannel).period + _SHL(player.channel(nChannel).lastPortamento, 2)
                        SoftSynth_SetVoiceFrequency player.synth, nChannel, __MODPlayer_GetFrequencyFromPeriod(player.channel(nChannel).period)
                    END IF

                CASE __MODPLAYER_FX_PORTA_EXTRA_FINE_UP
                    IF player.channel(nChannel).period > 0 _ANDALSO player.channel(nChannel).lastPortamento < &HE0 THEN
                        player.channel(nChannel).period = player.channel(nChannel).period - _SHL(player.channel(nChannel).lastPortamento, 2)
                        IF player.channel(nChannel).period < 1 THEN player.channel(nChannel).period = 1
                        SoftSynth_SetVoiceFrequency player.synth, nChannel, __MODPlayer_GetFrequencyFromPeriod(player.channel(nChannel).period)
                    END IF

                CASE __MODPLAYER_FX_TREMOR
                    __MODPlayer_DoS3MTremor player, nChannel

                CASE __MODPLAYER_FX_VIBRATO_VOL_FINE_SLIDE
                    IF player.channel(nChannel).period > 0 THEN __MODPlayer_DoVibrato player, nChannel, _TRUE ' true here means not fine vibrato
                    __MODPlayer_DoVolumeSlide player, nChannel, _SHR(player.channel(nChannel).lastVolumeSlide, 4), player.channel(nChannel).lastVolumeSlide AND &HF, _TRUE

                CASE __MODPLAYER_FX_PORTA_VOL_FINE_SLIDE
                    IF player.channel(nChannel).period > 0 THEN __MODPlayer_DoPortamento player, nChannel
                    __MODPlayer_DoVolumeSlide player, nChannel, _SHR(player.channel(nChannel).lastVolumeSlide, 4), player.channel(nChannel).lastVolumeSlide AND &HF, _TRUE

                CASE __MODPLAYER_FX_NOTE_RETRIGGER_VOL_SLIDE
                    IF player.channel(nChannel).retriggerTickCount THEN
                        IF player.song.tick MOD player.channel(nChannel).retriggerTickCount = 0 THEN
                            IF player.channel(nChannel).retriggerVolumeSlide THEN
                                'Parameter  Effect              Parameter   Effect
                                '0          No volume change    8           No volume change
                                '1          Volume - 1          9           Volume + 1
                                '2          Volume - 2          A           Volume + 2
                                '3          Volume - 4          B           Volume + 4
                                '4          Volume - 8          C           Volume + 8
                                '5          Volume - 16         D           Volume + 16
                                '6          Volume x 2/3        E           Volume x 1.5
                                '7          Volume x 1/2        F           Volume x 2
                                SELECT CASE player.channel(nChannel).retriggerVolumeSlide
                                    CASE &H1
                                        player.channel(nChannel).volume = player.channel(nChannel).volume - 1

                                    CASE &H2
                                        player.channel(nChannel).volume = player.channel(nChannel).volume - 2

                                    CASE &H3
                                        player.channel(nChannel).volume = player.channel(nChannel).volume - 4

                                    CASE &H4
                                        player.channel(nChannel).volume = player.channel(nChannel).volume - 8

                                    CASE &H5
                                        player.channel(nChannel).volume = player.channel(nChannel).volume - 16

                                    CASE &H6
                                        player.channel(nChannel).volume = (player.channel(nChannel).volume * 2) \ 3

                                    CASE &H7
                                        player.channel(nChannel).volume = _SHR(player.channel(nChannel).volume, 1)

                                    CASE &H9
                                        player.channel(nChannel).volume = player.channel(nChannel).volume + 1

                                    CASE &HA
                                        player.channel(nChannel).volume = player.channel(nChannel).volume + 2

                                    CASE &HB
                                        player.channel(nChannel).volume = player.channel(nChannel).volume + 4

                                    CASE &HC
                                        player.channel(nChannel).volume = player.channel(nChannel).volume + 8

                                    CASE &HD
                                        player.channel(nChannel).volume = player.channel(nChannel).volume + 16

                                    CASE &HE
                                        player.channel(nChannel).volume = (player.channel(nChannel).volume * 3) \ 2

                                    CASE &HF
                                        player.channel(nChannel).volume = _SHL(player.channel(nChannel).volume, 1)

                                END SELECT

                                player.channel(nChannel).volume = _CLAMP(player.channel(nChannel).volume, 0, __MODPLAYER_INSTRUMENT_VOLUME_MAX)

                                __MODPlayer_ApplyChannelVolume player, nChannel
                            END IF

                            IF player.song.isS3M THEN player.channel(nChannel).startPosition = 0
                            __MODPlayer_PlayPCMChannelVoice player, nChannel
                        END IF
                    END IF

                CASE __MODPLAYER_FX_VIBRATO_FINE
                    IF player.channel(nChannel).period > 0 THEN __MODPlayer_DoVibrato player, nChannel, _FALSE ' false here means fine vibrato

                CASE __MODPLAYER_FX_CHANNEL_VOLUME_SLIDE
                    __MODPlayer_DoS3MChannelVolumeSlide player, nChannel, nOperand, _FALSE

                CASE __MODPLAYER_FX_PANNING_FINE_SLIDE
                    __MODPlayer_DoS3MPanningSlide player, nChannel, nOperand, _FALSE

                CASE __MODPLAYER_FX_GLOBAL_VOLUME_SLIDE
                    __MODPlayer_DoS3MGlobalVolumeSlide player, nChannel, nOperand, _FALSE

                CASE __MODPLAYER_FX_TEMPO
                    IF nOperand < 32 THEN __MODPlayer_DoS3MTempoSlide player, nChannel, nOperand

                CASE __MODPLAYER_FX_PANBRELLO
                    IF player.channel(nChannel).panbrelloActive THEN __MODPlayer_DoPanbrello player, nChannel

            END SELECT

            DIM suppressVolumeColumn AS _BYTE
            suppressVolumeColumn = player.channel(nChannel).noteDelayPending
            IF player.song.isS3M _ANDALSO nEffect = __MODPLAYER_FX_EXT _ANDALSO nOpX = __MODPLAYER_FX_EXT_NOTE_DELAY _ANDALSO (nOpY = 0 OR nOpY >= player.song.speed) THEN suppressVolumeColumn = _TRUE
            IF player.song.isS3M _ANDALSO NOT suppressVolumeColumn THEN
                SELECT CASE nVolume
                    CASE 85 TO 94
                        player.channel(nChannel).volume = _CLAMP(player.channel(nChannel).volume - nVolume + 85, 0, __MODPLAYER_INSTRUMENT_VOLUME_MAX)
                        __MODPlayer_ApplyChannelVolume player, nChannel
                    CASE 95 TO 104
                        player.channel(nChannel).volume = _CLAMP(player.channel(nChannel).volume + nVolume - 95, 0, __MODPLAYER_INSTRUMENT_VOLUME_MAX)
                        __MODPlayer_ApplyChannelVolume player, nChannel
                    CASE 105 TO 114
                        IF player.channel(nChannel).period > 0 THEN
                            player.channel(nChannel).period = player.channel(nChannel).period + _SHL(nVolume - 105, 2)
                            SoftSynth_SetVoiceFrequency player.synth, nChannel, __MODPlayer_GetFrequencyFromPeriod(player.channel(nChannel).period)
                        END IF
                    CASE 115 TO 124
                        IF player.channel(nChannel).period > 0 THEN
                            player.channel(nChannel).period = player.channel(nChannel).period - _SHL(nVolume - 115, 2)
                            IF player.channel(nChannel).period < 1 THEN player.channel(nChannel).period = 1
                            SoftSynth_SetVoiceFrequency player.synth, nChannel, __MODPlayer_GetFrequencyFromPeriod(player.channel(nChannel).period)
                        END IF
                    CASE 125
                        IF player.channel(nChannel).period > 0 THEN __MODPlayer_DoPortamento player, nChannel
                    CASE 126
                        IF player.channel(nChannel).period > 0 THEN __MODPlayer_DoVibrato player, nChannel, _TRUE
                END SELECT
            END IF
        END IF

        DIM amInstIdx AS LONG: amInstIdx = player.channel(nChannel).instrument
        IF amInstIdx >= 0 _ANDALSO amInstIdx < player.song.instruments THEN
            IF player.instrument(amInstIdx).subtype = __MODPLAYER_INSTRUMENT_AM_SYNTH THEN
                __MODPlayer_ProcessAMChannelTick player, nChannel
            END IF
        END IF
    NEXT
END SUB

''' @brief Sets sequencer tempo (Beats Per Minute) and recalculates timing parameters.
''' @param player The MOD player instance.
''' @param nBPM Tempo in BPM (32 to 255).
SUB __MODPlayer_SetBPM (player AS MODPlayer, nBPM AS _UNSIGNED _BYTE)
    IF nBPM = 0 THEN EXIT SUB

    player.song.BPM = nBPM

    IF player.song.tempoTimerValue = 0 THEN
        player.song.tempoTimerValue = (SoftSynth_GetSampleRate(player.synth) * __MODPLAYER_SONG_BPM_DEFAULT) \ 50
    END IF

    ' Calculate the number of samples we have to mix per tick
    player.song.framesPerTick = player.song.tempoTimerValue \ nBPM
END SUB

''' @brief Finds the closest period table entry to a given period value.
''' @param target Target period value.
''' @return The closest matched period.
FUNCTION __MODPlayer_GetClosestPeriod& (target AS LONG)
    SHARED __MODPlayer_PeriodTable() AS _UNSIGNED INTEGER

    DIM AS LONG startPos, endPos, midPos, leftVal, rightVal

    IF target > 27392 THEN
        __MODPlayer_GetClosestPeriod = target
        EXIT FUNCTION
    ELSEIF target < 14 THEN
        __MODPlayer_GetClosestPeriod = target
        EXIT FUNCTION
    END IF

    startPos = 0
    endPos = UBOUND(__MODPlayer_PeriodTable)
    WHILE startPos + 1 < endPos
        midPos = startPos + (endPos - startPos) \ 2
        IF __MODPlayer_PeriodTable(midPos) <= target THEN
            endPos = midPos
        ELSE
            startPos = midPos
        END IF
    WEND

    rightVal = ABS(__MODPlayer_PeriodTable(startPos) - target)
    leftVal = ABS(__MODPlayer_PeriodTable(endPos) - target)

    IF leftVal <= rightVal THEN
        __MODPlayer_GetClosestPeriod = __MODPlayer_PeriodTable(endPos)
    ELSE
        __MODPlayer_GetClosestPeriod = __MODPlayer_PeriodTable(startPos)
    END IF
END FUNCTION

''' @brief Performs tone portamento calculation towards destination note period for a channel.
''' @param chan Channel index (0-based).
SUB __MODPlayer_DoPortamento (player AS MODPlayer, chan AS _UNSIGNED _BYTE)
    ' Slide up/down and clamp to destination
    IF player.channel(chan).period < player.channel(chan).portamentoTo THEN
        player.channel(chan).period = player.channel(chan).period + _SHL(player.channel(chan).portamentoSpeed, 2)
        IF player.channel(chan).period > player.channel(chan).portamentoTo THEN
            player.channel(chan).period = player.channel(chan).portamentoTo
        END IF
    ELSEIF player.channel(chan).period > player.channel(chan).portamentoTo THEN
        player.channel(chan).period = player.channel(chan).period - _SHL(player.channel(chan).portamentoSpeed, 2)
        IF player.channel(chan).period < player.channel(chan).portamentoTo THEN
            player.channel(chan).period = player.channel(chan).portamentoTo
        END IF
    END IF

    IF player.channel(chan).useGlissando THEN
        SoftSynth_SetVoiceFrequency player.synth, chan, __MODPlayer_GetFrequencyFromPeriod(__MODPlayer_GetClosestPeriod(player.channel(chan).period))
    ELSE
        SoftSynth_SetVoiceFrequency player.synth, chan, __MODPlayer_GetFrequencyFromPeriod(player.channel(chan).period)
    END IF
END SUB

''' @brief Performs volume slide up or down calculation on a channel.
''' @param chan Channel index (0-based).
''' @param x Upward slide amount nibble.
''' @param y Downward slide amount nibble.
''' @param isNotFine _TRUE for regular volume slide, _FALSE for fine volume slide.
SUB __MODPlayer_DoVolumeSlide (player AS MODPlayer, chan AS _UNSIGNED _BYTE, x AS _UNSIGNED _BYTE, y AS _UNSIGNED _BYTE, isNotFine AS _BYTE)
    IF isNotFine THEN
        IF player.song.isS3M _ANDALSO y > 0 THEN
            player.channel(chan).volume = player.channel(chan).volume - y
        ELSE
            player.channel(chan).volume = player.channel(chan).volume + x - y
        END IF
    ELSE
        IF y = 0 THEN player.channel(chan).volume = player.channel(chan).volume + x
        IF x = 0 THEN player.channel(chan).volume = player.channel(chan).volume - y
    END IF

    IF player.channel(chan).volume > __MODPLAYER_INSTRUMENT_VOLUME_MAX THEN player.channel(chan).volume = __MODPLAYER_INSTRUMENT_VOLUME_MAX
    IF player.channel(chan).volume < 0 THEN player.channel(chan).volume = 0

    __MODPlayer_ApplyChannelVolume player, chan
END SUB

''' @brief Processes Scream Tracker 3 tremor effect on a channel.
''' @param chan Channel index (0-based).
SUB __MODPlayer_DoS3MTremor (player AS MODPlayer, chan AS _UNSIGNED _BYTE)
    DIM cycleLength AS _UNSIGNED _BYTE
    cycleLength = player.channel(chan).tremorOnTicks + player.channel(chan).tremorOffTicks
    IF cycleLength = 0 THEN EXIT SUB

    player.channel(chan).tremorPosition = player.channel(chan).tremorPosition MOD cycleLength
    player.channel(chan).tremorMuted = (player.channel(chan).tremorPosition >= player.channel(chan).tremorOnTicks)
    __MODPlayer_ApplyChannelVolume player, chan
    player.channel(chan).tremorPosition = (player.channel(chan).tremorPosition + 1) MOD cycleLength
END SUB

''' @brief Calculates and applies pitch vibrato oscillation on a channel.
''' @param chan Channel index (0-based).
''' @param isNotFine _TRUE for standard vibrato, _FALSE for fine vibrato.
SUB __MODPlayer_DoVibrato (player AS MODPlayer, chan AS _UNSIGNED _BYTE, isNotFine AS _BYTE)
    SHARED __MODPlayer_SineTable() AS _UNSIGNED _BYTE
    DIM delta AS _UNSIGNED INTEGER
    DIM temp AS _UNSIGNED _BYTE

    temp = player.channel(chan).vibratoPosition AND 31

    SELECT CASE player.channel(chan).waveControl AND 3
        CASE 0 ' Sine
            delta = __MODPlayer_SineTable(temp)

        CASE 1 ' Saw down
            temp = _SHL(temp, 3)
            IF player.channel(chan).vibratoPosition < 0 THEN temp = 255 - temp
            delta = temp

        CASE 2 ' Square
            delta = 255

        CASE 3 ' Random
            delta = RND * 255!
    END SELECT

    delta = _SHR(delta * player.channel(chan).vibratoDepth, 7)
    IF isNotFine THEN delta = _SHL(delta, 2) ' make vibrato 4 times bigger

    IF player.channel(chan).vibratoPosition >= 0 THEN
        SoftSynth_SetVoiceFrequency player.synth, chan, __MODPlayer_GetFrequencyFromPeriod(player.channel(chan).period + delta)
    ELSE
        SoftSynth_SetVoiceFrequency player.synth, chan, __MODPlayer_GetFrequencyFromPeriod(player.channel(chan).period - delta)
    END IF

    player.channel(chan).vibratoPosition = player.channel(chan).vibratoPosition + player.channel(chan).vibratoSpeed
    IF player.channel(chan).vibratoPosition > 31 THEN
        player.channel(chan).vibratoPosition = player.channel(chan).vibratoPosition - 64
    END IF
END SUB

''' @brief Calculates and applies volume tremolo oscillation on a channel.
''' @param chan Channel index (0-based).
SUB __MODPlayer_DoTremolo (player AS MODPlayer, chan AS _UNSIGNED _BYTE)
    SHARED __MODPlayer_SineTable() AS _UNSIGNED _BYTE
    DIM delta AS _UNSIGNED INTEGER
    DIM temp AS _UNSIGNED _BYTE

    temp = player.channel(chan).tremoloPosition AND 31

    SELECT CASE _SHR(player.channel(chan).waveControl, 4) AND 3
        CASE 0 ' Sine
            delta = __MODPlayer_SineTable(temp)

        CASE 1 ' Saw down
            temp = _SHL(temp, 3)
            IF player.channel(chan).tremoloPosition < 0 THEN temp = 255 - temp
            delta = temp

        CASE 2 ' Square
            delta = 255

        CASE 3 ' Random
            delta = RND * 255!
    END SELECT

    delta = _SHR(delta * player.channel(chan).tremoloDepth, 6)

    IF player.channel(chan).tremoloPosition >= 0 THEN
        IF player.channel(chan).volume + delta > __MODPLAYER_INSTRUMENT_VOLUME_MAX THEN delta = __MODPLAYER_INSTRUMENT_VOLUME_MAX - player.channel(chan).volume
        __MODPlayer_SetVoiceVolume player, chan, (player.channel(chan).volume + delta) / __MODPLAYER_INSTRUMENT_VOLUME_MAX
    ELSE
        IF player.channel(chan).volume - delta < 0 THEN delta = player.channel(chan).volume
        __MODPlayer_SetVoiceVolume player, chan, (player.channel(chan).volume - delta) / __MODPLAYER_INSTRUMENT_VOLUME_MAX
    END IF

    player.channel(chan).tremoloPosition = player.channel(chan).tremoloPosition + player.channel(chan).tremoloSpeed
    IF player.channel(chan).tremoloPosition > 31 THEN player.channel(chan).tremoloPosition = player.channel(chan).tremoloPosition - 64
END SUB

''' @brief Processes ProTracker EFx funk / invert loop effect on a channel.
''' @param chan Channel index (0-based).
SUB __MODPlayer_DoInvertLoop (player AS MODPlayer, chan AS _UNSIGNED _BYTE)
    SHARED __MODPlayer_InvertLoopSpeedTable() AS _UNSIGNED _BYTE
    player.channel(chan).invertLoopDelay = player.channel(chan).invertLoopDelay + __MODPlayer_InvertLoopSpeedTable(player.channel(chan).invertLoopSpeed)

    DIM sampleNumber AS _UNSIGNED _BYTE: sampleNumber = player.channel(chan).instrument ' cache the sample number case we'll use this often below

    IF player.channel(chan).invertLoopDelay >= 128 _ANDALSO SOFTSYNTH_VOICE_PLAY_FORWARD_LOOP = player.instrument(sampleNumber).playMode THEN
        player.channel(chan).invertLoopDelay = 0 ' reset delay
        IF player.channel(chan).invertLoopPosition < player.instrument(sampleNumber).loopStart THEN
            player.channel(chan).invertLoopPosition = player.instrument(sampleNumber).loopStart
        END IF
        player.channel(chan).invertLoopPosition = player.channel(chan).invertLoopPosition + 1 ' increment position by 1
        IF player.channel(chan).invertLoopPosition >= player.instrument(sampleNumber).loopEnd THEN
            player.channel(chan).invertLoopPosition = player.instrument(sampleNumber).loopStart
        END IF

        ' Yeah I know, this is weird. QB64 NOT is bitwise and not logical
        DIM p AS _UNSIGNED LONG: p = SoftSynth_ConvertBytesToFrames(player.channel(chan).invertLoopPosition, player.instrument(sampleNumber).bytesPerSample, player.instrument(sampleNumber).channels)
        SoftSynth_PokeSoundFrameByte player.synth, sampleNumber, p, NOT SoftSynth_PeekSoundFrameByte(player.synth, sampleNumber, p)
    END IF
END SUB

''' @brief Calculates audio playback frequency in Hertz from an Amiga period value.
''' @param period Amiga period value.
''' @return Frequency in Hertz.
FUNCTION __MODPlayer_GetFrequencyFromPeriod~& (period AS LONG)
    __MODPlayer_GetFrequencyFromPeriod = 14317056 \ period
END FUNCTION

''' @brief Gets the title name of the currently loaded tune.
''' @return Tune name string.
FUNCTION MODPlayer_GetName$ (player AS MODPlayer)
    MODPlayer_GetName = player.song.caption
END FUNCTION

''' @brief Gets the format descriptor or magic tag of the currently loaded tune.
''' @param player The MOD player instance.
''' @return Format string (e.g. "M.K.", "SCRM", "MTM1").
FUNCTION MODPlayer_GetType$ (player AS MODPlayer)
    MODPlayer_GetType = player.song.subtype
END FUNCTION

''' @brief Checks whether a song is actively playing.
''' @param player The MOD player instance.
''' @return _TRUE if playing, _FALSE otherwise.
FUNCTION MODPlayer_IsPlaying%% (player AS MODPlayer)
    MODPlayer_IsPlaying = player.song.isPlaying
END FUNCTION

''' @brief Pauses or unpauses song playback.
''' @param player The MOD player instance.
''' @param state _TRUE to pause playback, _FALSE to resume.
SUB MODPlayer_Pause (player AS MODPlayer, state AS _BYTE)
    player.song.isPaused = state
END SUB

''' @brief Checks whether song playback is currently paused.
''' @param player The MOD player instance.
''' @return _TRUE if paused, _FALSE otherwise.
FUNCTION MODPlayer_IsPaused%% (player AS MODPlayer)
    MODPlayer_IsPaused = player.song.isPaused
END FUNCTION

''' @brief Sets continuous song looping mode.
''' @param player The MOD player instance.
''' @param state _TRUE to loop continuously, _FALSE to stop at song end.
SUB MODPlayer_Loop (player AS MODPlayer, state AS _BYTE)
    player.song.isLooping = state
END SUB

''' @brief Checks whether continuous song looping is enabled.
''' @param player The MOD player instance.
''' @return _TRUE if looping is enabled, _FALSE otherwise.
FUNCTION MODPlayer_IsLooping%% (player AS MODPlayer)
    MODPlayer_IsLooping = player.song.isLooping
END FUNCTION

''' @brief Advances playback position to the next pattern order, wrapping at song end if looping.
''' @param player The MOD player instance.
SUB MODPlayer_GoToNextPosition (player AS MODPlayer)
    IF player.song.isLooping THEN ' if we are looping
        player.song.orderPosition = player.song.orderPosition + 1 ' move to the next order
        IF player.song.orderPosition >= player.song.orders THEN player.song.orderPosition = 0 ' wrap to first order if we have reached the end
        player.song.patternRow = 0 ' reset row position
    ELSEIF player.song.orderPosition < player.song.orders - 1 THEN ' else only if have not reached the last order
        player.song.orderPosition = player.song.orderPosition + 1
        player.song.patternRow = 0 ' reset row position
    END IF
END SUB

''' @brief Rewinds playback position to the previous pattern order, wrapping if looping.
''' @param player The MOD player instance.
SUB MODPlayer_GoToPreviousPosition (player AS MODPlayer)
    IF player.song.isLooping THEN ' if we are looping
        player.song.orderPosition = player.song.orderPosition - 1 ' move to the previous order
        IF player.song.orderPosition < 0 THEN player.song.orderPosition = player.song.orders - 1 ' wrap to the last order if we have crossed the beginning
        player.song.patternRow = 0 ' reset row position
    ELSEIF player.song.orderPosition > 0 THEN ' else only if have not reached the first order
        player.song.orderPosition = player.song.orderPosition - 1 ' move to the previous order
        player.song.patternRow = 0 ' reset row position
    END IF
END SUB

''' @brief Sets the current pattern order playback position.
''' @param player The MOD player instance.
''' @param position Target order position index (0-based).
SUB MODPlayer_SetPosition (player AS MODPlayer, position AS _UNSIGNED INTEGER)
    IF position < player.song.orders THEN
        player.song.orderPosition = position
        player.song.patternRow = 0
    END IF
END SUB

''' @brief Gets the current pattern order playback position index.
''' @param player The MOD player instance.
''' @return Current order position index (0-based).
FUNCTION MODPlayer_GetPosition& (player AS MODPlayer)
    MODPlayer_GetPosition = player.song.orderPosition
END FUNCTION

''' @brief Gets the total number of pattern orders in the loaded tune.
''' @param player The MOD player instance.
''' @return Total order count.
FUNCTION MODPlayer_GetOrders~% (player AS MODPlayer)
    MODPlayer_GetOrders = player.song.orders
END FUNCTION

''' @brief Gets the number of rows in a specific pattern.
''' @param player The MOD player instance.
''' @param patternIndex Pattern index (0-based).
''' @return Number of rows in the pattern (0 if invalid pattern index).
FUNCTION MODPlayer_GetPatternRows~% (player AS MODPlayer, patternIndex AS _UNSIGNED INTEGER)
    IF patternIndex < player.song.patterns THEN
        MODPlayer_GetPatternRows = player.pattern(patternIndex).rows
    END IF
END FUNCTION
