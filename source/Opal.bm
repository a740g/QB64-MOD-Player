'-----------------------------------------------------------------------------------------------------------------------
' Opal OPL2/OPL3 FM Synthesizer Emulator
' Ported from public-domain / MIT Opal C11 implementation by RealBitdancer (github.com/RealBitdancer/opal)
' Adapted for QB64-PE and multi-instance usage
'-----------------------------------------------------------------------------------------------------------------------

$INCLUDEONCE

'$INCLUDE:'Opal.bi'

$CHECKING:OFF

FUNCTION __Opal_Saturate% (sum AS LONG)
    IF sum > 32767 THEN
        __Opal_Saturate = 32767
    ELSEIF sum < -32768 THEN
        __Opal_Saturate = -32768
    ELSE
        __Opal_Saturate = sum
    END IF
END FUNCTION

FUNCTION __Opal_Interpolate% (last AS INTEGER, curr AS INTEGER, fract AS LONG)
    DIM diff AS _INTEGER64
    diff = curr - last
    __Opal_Interpolate = last + (diff * fract) \ 65536
END FUNCTION

SUB __Opal_TickTimer (self AS Opal, t AS LONG)
    IF (self.timerControl AND _SHL(1, t)) = 0 THEN EXIT SUB
    self.timerCount(t) = self.timerCount(t) + 1
    IF self.timerCount(t) > &HFF THEN
        DIM flag AS _UNSIGNED _BYTE
        flag = _SHR(&H40, t)
        self.timerCount(t) = self.timer(t)
        IF (self.timerControl AND flag) = 0 THEN
            self.status = self.status OR (flag OR &H80~%%)
        END IF
    END IF
END SUB

FUNCTION __Opal_FloorShift& (value AS LONG, bits AS _UNSIGNED LONG)
    IF value >= 0 THEN
        __Opal_FloorShift = _SHR(value, bits)
    ELSE
        __Opal_FloorShift = NOT _SHR(NOT value, bits)
    END IF
END FUNCTION

FUNCTION __Opal_ChannelIsPairTail% (ch AS _UNSIGNED LONG)
    __Opal_ChannelIsPairTail = (((ch MOD __OPAL_CHANNELS_PER_BANK) \ __OPAL_PAIRS_PER_BANK) = 1)
END FUNCTION

FUNCTION __Opal_ChannelPairBit~& (ch AS _UNSIGNED LONG)
    __Opal_ChannelPairBit = (ch \ __OPAL_CHANNELS_PER_BANK) * __OPAL_PAIRS_PER_BANK + (ch MOD __OPAL_CHANNELS_PER_BANK)
END FUNCTION

FUNCTION __Opal_ChannelIsPaired% (self AS Opal, ch AS _UNSIGNED LONG)
    IF (ch MOD __OPAL_CHANNELS_PER_BANK) >= 2 * __OPAL_PAIRS_PER_BANK THEN
        __Opal_ChannelIsPaired = 0
        EXIT FUNCTION
    END IF
    __Opal_ChannelIsPaired = ((_SHR(self.pairEnable, __Opal_ChannelPairBit(ch)) AND 1) <> 0)
END FUNCTION

FUNCTION __Opal_ChannelBorrowsPitch% (self AS Opal, ch AS _UNSIGNED LONG)
    __Opal_ChannelBorrowsPitch = (__Opal_ChannelIsPairTail(ch) AND __Opal_ChannelIsPaired(self, ch))
END FUNCTION

FUNCTION __Opal_ChannelIsRhythm% (self AS Opal, ch AS _UNSIGNED LONG)
    __Opal_ChannelIsRhythm = (self.rhythmMode <> 0 AND ch >= __OPAL_BASS_DRUM_CHANNEL AND ch < __OPAL_CHANNELS_PER_BANK)
END FUNCTION

FUNCTION __Opal_ChannelPickAlgorithm~& (self AS Opal, ch AS _UNSIGNED LONG)
    IF __Opal_ChannelIsRhythm(self, ch) THEN
        IF ch <> __OPAL_BASS_DRUM_CHANNEL THEN
            __Opal_ChannelPickAlgorithm = __OPAL_ALGORITHM_PERCUSSION
            EXIT FUNCTION
        END IF
        IF self.chan(ch).connection <> 0 THEN
            __Opal_ChannelPickAlgorithm = __OPAL_ALGORITHM_KICK_DIRECT
        ELSE
            __Opal_ChannelPickAlgorithm = __OPAL_ALGORITHM_KICK_FM
        END IF
        EXIT FUNCTION
    END IF
    IF __Opal_ChannelIsPaired(self, ch) THEN
        DIM leadConn AS _UNSIGNED LONG, tailConn AS _UNSIGNED LONG
        IF __Opal_ChannelIsPairTail(ch) THEN
            leadConn = self.chan(self.chan(ch).pairIndex).connection
            tailConn = self.chan(ch).connection
        ELSE
            leadConn = self.chan(ch).connection
            tailConn = self.chan(self.chan(ch).pairIndex).connection
        END IF
        __Opal_ChannelPickAlgorithm = __OPAL_ALGORITHM_CHAIN + 2 * leadConn + tailConn
        EXIT FUNCTION
    END IF
    IF self.chan(ch).connection <> 0 THEN
        __Opal_ChannelPickAlgorithm = __OPAL_ALGORITHM_ADDITIVE
    ELSE
        __Opal_ChannelPickAlgorithm = __OPAL_ALGORITHM_FM
    END IF
END FUNCTION

FUNCTION __Opal_ChannelSpansPair% (self AS Opal, ch AS _UNSIGNED LONG)
    __Opal_ChannelSpansPair = (__Opal_Algorithms(self.chan(ch).algorithm).operatorCount = 4)
END FUNCTION

FUNCTION __Opal_ChannelCarriesVoice% (self AS Opal, ch AS _UNSIGNED LONG)
    IF NOT __Opal_ChannelSpansPair(self, ch) THEN
        __Opal_ChannelCarriesVoice = -1
    ELSE
        __Opal_ChannelCarriesVoice = __Opal_ChannelIsPairTail(ch)
    END IF
END FUNCTION

FUNCTION __Opal_ChannelVoiceBase~& (self AS Opal, ch AS _UNSIGNED LONG)
    IF __Opal_ChannelSpansPair(self, ch) AND __Opal_ChannelIsPairTail(ch) THEN
        __Opal_ChannelVoiceBase = self.chan(self.chan(ch).pairIndex).opSlot(0)
    ELSE
        __Opal_ChannelVoiceBase = self.chan(ch).opSlot(0)
    END IF
END FUNCTION

FUNCTION __Opal_OperatorVoicePosition~& (self AS Opal, slot AS _UNSIGNED LONG)
    DIM ch AS _UNSIGNED LONG
    ch = __Opal_OperatorOwner(slot)
    DIM position AS _UNSIGNED LONG
    IF slot = self.chan(ch).opSlot(0) THEN
        position = 0
    ELSE
        position = 1
    END IF
    IF __Opal_ChannelSpansPair(self, ch) AND __Opal_ChannelIsPairTail(ch) THEN
        position = position + 2
    END IF
    __Opal_OperatorVoicePosition = position
END FUNCTION

FUNCTION __Opal_ChannelRoleView& (self AS Opal, ch AS _UNSIGNED LONG)
    IF __Opal_ChannelIsRhythm(self, ch) THEN
        __Opal_ChannelRoleView = OPAL_CHANNEL_TYPE_DRUM
    ELSEIF NOT __Opal_ChannelIsPaired(self, ch) THEN
        __Opal_ChannelRoleView = OPAL_CHANNEL_TYPE_2OP
    ELSEIF __Opal_ChannelIsPairTail(ch) THEN
        __Opal_ChannelRoleView = OPAL_CHANNEL_TYPE_4OP2
    ELSE
        __Opal_ChannelRoleView = OPAL_CHANNEL_TYPE_4OP
    END IF
END FUNCTION

SUB __Opal_PublishRouting (self AS Opal)
    DIM slot AS _UNSIGNED LONG
    FOR slot = 0 TO OPAL_OPERATOR_COUNT - 1
        DIM chOwner AS _UNSIGNED LONG
        chOwner = __Opal_OperatorOwner(slot)
        DIM algoIdx AS _UNSIGNED LONG
        algoIdx = self.chan(chOwner).algorithm
        DIM position AS _UNSIGNED LONG
        position = __Opal_OperatorVoicePosition(self, slot)
        DIM source AS _UNSIGNED _BYTE
        source = OPAL_OP_NONE
        IF position = 0 AND __Opal_Algorithms(algoIdx).selfFeedback <> 0 THEN
            source = OPAL_MOD_OWN_FB
        ELSEIF (_SHR(__Opal_Algorithms(algoIdx).chainMask, position) AND 1) <> 0 THEN
            source = slot - __OPAL_VOICE_STRIDE
        END IF
        self.op(slot).modSource = source
    NEXT slot

    DIM ch AS _UNSIGNED LONG
    FOR ch = 0 TO OPAL_CHANNEL_COUNT - 1
        self.chan(ch).chanType = __Opal_ChannelRoleView(self, ch)
        DIM k AS LONG
        FOR k = 0 TO 3
            self.chan(ch).outSource(k) = OPAL_OP_NONE
        NEXT k

        IF __Opal_ChannelCarriesVoice(self, ch) THEN
            DIM baseVal AS _UNSIGNED LONG
            baseVal = __Opal_ChannelVoiceBase(self, ch)
            DIM algoIdxCh AS _UNSIGNED LONG
            algoIdxCh = self.chan(ch).algorithm
            DIM entry AS LONG
            entry = 0
            DIM posIdx AS _UNSIGNED LONG
            FOR posIdx = 0 TO __Opal_Algorithms(algoIdxCh).operatorCount - 1
                IF (_SHR(__Opal_Algorithms(algoIdxCh).carrierMask, posIdx) AND 1) <> 0 THEN
                    DIM cpy AS LONG
                    FOR cpy = 0 TO __Opal_Algorithms(algoIdxCh).gain - 1
                        IF entry <= 3 THEN
                            self.chan(ch).outSource(entry) = baseVal + __OPAL_VOICE_STRIDE * posIdx
                            entry = entry + 1
                        END IF
                    NEXT cpy
                END IF
            NEXT posIdx
        END IF
    NEXT ch
END SUB

SUB __Opal_RefreshRouting (self AS Opal)
    DIM ch AS _UNSIGNED LONG
    FOR ch = 0 TO OPAL_CHANNEL_COUNT - 1
        self.chan(ch).algorithm = __Opal_ChannelPickAlgorithm(self, ch)
    NEXT ch
    __Opal_PublishRouting self
END SUB

SUB __Opal_ChannelKey (self AS Opal, ch AS _UNSIGNED LONG, slotCount AS _UNSIGNED LONG, keyState AS _UNSIGNED LONG)
    DIM i AS _UNSIGNED LONG
    FOR i = 0 TO slotCount - 1
        DIM slot AS _UNSIGNED _BYTE
        slot = self.chan(ch).opSlot(i)
        IF slot <> OPAL_OP_NONE THEN
            DIM prevKey AS _UNSIGNED _BYTE
            prevKey = self.op(slot).key
            self.op(slot).key = (prevKey AND 2) OR (keyState AND 1)
            IF (prevKey AND 1) <> 0 AND (keyState AND 1) = 0 THEN
                self.op(slot).envelopeStage = OPAL_ENVELOPE_STAGE_RELEASE
            END IF
        END IF
    NEXT i
END SUB

SUB __Opal_ChannelLatchKeyScale (self AS Opal, ch AS _UNSIGNED LONG)
    DIM shiftAmount AS LONG
    IF self.noteSelect <> 0 THEN shiftAmount = 8 ELSE shiftAmount = 9
    DIM noteBit AS _UNSIGNED LONG
    noteBit = _SHR(self.chan(ch).fNumber, shiftAmount) AND 1
    self.chan(ch).latchedKeyScaleNumber = 2 * self.chan(ch).block + noteBit
END SUB

SUB __Opal_ChannelWriteFrequency (self AS Opal, ch AS _UNSIGNED LONG, high AS _BYTE, valByte AS _UNSIGNED _BYTE)
    IF high THEN
        self.chan(ch).fNumber = (self.chan(ch).fNumber AND &HFF~%) OR _SHL(valByte AND 3, 8)
        self.chan(ch).block = _SHR(valByte, 2) AND 7
    ELSE
        self.chan(ch).fNumber = (self.chan(ch).fNumber AND &H300~%) OR valByte
    END IF

    IF __Opal_ChannelBorrowsPitch(self, ch) THEN EXIT SUB

    __Opal_ChannelLatchKeyScale self, ch
    IF high THEN
        DIM slotCount AS _UNSIGNED LONG
        IF __Opal_ChannelIsPaired(self, ch) THEN slotCount = 4 ELSE slotCount = 2
        __Opal_ChannelKey self, ch, slotCount, _SHR(valByte, 5) AND 1
    END IF
END SUB

SUB __Opal_ChannelWriteConnection (self AS Opal, ch AS _UNSIGNED LONG, valByte AS _UNSIGNED _BYTE)
    DIM sides AS _UNSIGNED LONG
    IF self.newMode <> 0 THEN
        sides = _SHR(valByte, 4) AND __OPAL_OUTPUT_BOTH_SIDES
    ELSE
        sides = __OPAL_OUTPUT_BOTH_SIDES
    END IF
    self.chan(ch).outputEnable = sides
    self.chan(ch).feedback = _SHR(valByte, 1) AND 7
    self.chan(ch).connection = valByte AND 1
    __Opal_RefreshRouting self
END SUB

SUB __Opal_WritePairing (self AS Opal, valByte AS _UNSIGNED _BYTE)
    DIM enabled AS _UNSIGNED LONG
    enabled = valByte AND __OPAL_PAIR_ENABLE_MASK
    DIM released AS _UNSIGNED LONG
    released = self.pairEnable AND (NOT enabled)

    self.pairEnable = enabled
    DIM ch AS _UNSIGNED LONG
    FOR ch = 0 TO OPAL_CHANNEL_COUNT - 1
        IF __Opal_ChannelIsPairTail(ch) AND ((_SHR(released, __Opal_ChannelPairBit(ch)) AND 1) <> 0) THEN
            __Opal_ChannelLatchKeyScale self, ch
        END IF
    NEXT ch
    __Opal_RefreshRouting self
END SUB

SUB __Opal_OperatorWrite (self AS Opal, slot AS _UNSIGNED LONG, group AS _UNSIGNED LONG, valByte AS _UNSIGNED _BYTE)
    SELECT CASE group
        CASE &H20
            self.op(slot).tremolo = _SHR(valByte, 7)
            self.op(slot).vibrato = _SHR(valByte, 6) AND 1
            self.op(slot).sustainHold = _SHR(valByte, 5) AND 1
            self.op(slot).keyScaleRate = _SHR(valByte, 4) AND 1
            self.op(slot).multiple = valByte AND 15
        CASE &H40
            self.op(slot).keyScaleLevel = _SHR(valByte, 6)
            self.op(slot).totalLevel = valByte AND 63
        CASE &H60
            self.op(slot).attackRate = _SHR(valByte, 4)
            self.op(slot).decayRate = valByte AND 15
        CASE &H80
            self.op(slot).sustainLevel = _SHR(valByte, 4)
            self.op(slot).releaseRate = valByte AND 15
        CASE ELSE
            DIM mask AS _UNSIGNED _BYTE
            IF self.newMode <> 0 THEN mask = __OPAL_WAVEFORM_MASK_NEW ELSE mask = __OPAL_WAVEFORM_MASK_OPL2
            self.op(slot).waveform = valByte AND mask
    END SELECT
END SUB

SUB __Opal_WriteRhythm (self AS Opal, valByte AS _UNSIGNED _BYTE)
    self.tremoloDepth = _SHR(valByte, 7)
    self.vibratoDepth = _SHR(valByte, 6) AND 1
    self.rhythmMode = _SHR(valByte, 5) AND 1

    DIM i AS _UNSIGNED LONG
    FOR i = 0 TO 5
        DIM slot AS _UNSIGNED LONG
        slot = __OPAL_RHYTHM_FIRST_SLOT + i
        DIM keyBit AS _UNSIGNED LONG
        IF self.rhythmMode <> 0 THEN
            keyBit = _SHR(valByte, __Opal_RhythmKeyBit(i)) AND 1
        ELSE
            keyBit = 0
        END IF
        DIM prevKey AS _UNSIGNED _BYTE
        prevKey = self.op(slot).key
        self.op(slot).key = (prevKey AND 1) OR _SHL(keyBit, 1)
        IF (prevKey AND 2) <> 0 AND keyBit = 0 THEN
            self.op(slot).envelopeStage = OPAL_ENVELOPE_STAGE_RELEASE
        END IF
    NEXT i
    __Opal_RefreshRouting self
END SUB

SUB __Opal_WriteTimerControl (self AS Opal, valByte AS _UNSIGNED _BYTE)
    IF (valByte AND &H80~%%) <> 0 THEN
        self.status = 0
        EXIT SUB
    END IF

    DIM started AS _UNSIGNED LONG
    started = valByte AND (NOT self.timerControl)
    IF (started AND 1) <> 0 THEN
        self.timerCount(0) = self.timer(0)
    END IF
    IF (started AND 2) <> 0 THEN
        self.timerCount(1) = self.timer(1)
    END IF
    self.timerControl = valByte
    self.status = self.status AND (NOT (valByte AND &H60~%%))
    IF (self.status AND &H60~%%) = 0 THEN
        self.status = 0
    END IF
END SUB

SUB __Opal_WriteControl (self AS Opal, reg AS _UNSIGNED LONG, valByte AS _UNSIGNED _BYTE)
    SELECT CASE reg
        CASE &H001
            self.waveSelectEnable = _SHR(valByte, 5) AND 1
        CASE &H002
            self.timer(0) = valByte
        CASE &H003
            self.timer(1) = valByte
        CASE &H004
            __Opal_WriteTimerControl self, valByte
        CASE &H008
            self.noteSelect = _SHR(valByte, 6) AND 1
            self.compositeSine = _SHR(valByte, 7)
        CASE __OPAL_FOUR_OP_REGISTER
            __Opal_WritePairing self, valByte
        CASE __OPAL_NEW_REGISTER
            self.newMode = valByte AND 1
    END SELECT
END SUB

SUB __Opal_Write (self AS Opal, regNum AS _UNSIGNED INTEGER, valByte AS _UNSIGNED _BYTE)
    DIM reg AS _UNSIGNED LONG
    reg = regNum AND &H1FF~%
    IF self.newMode = 0 AND reg <> __OPAL_NEW_REGISTER THEN
        reg = reg AND &HFF~%
    END IF

    DIM bank AS _UNSIGNED LONG
    bank = _SHR(reg, 8)
    DIM addr AS _UNSIGNED LONG
    addr = reg AND &HFF~%

    IF addr < &H20 THEN
        __Opal_WriteControl self, reg, valByte
    ELSEIF addr < &HA0 OR addr >= &HE0 THEN
        DIM row AS _UNSIGNED LONG
        row = _SHR(addr AND &H1F, 3)
        DIM column AS _UNSIGNED LONG
        column = addr AND 7
        IF row < 3 AND column < 6 THEN
            DIM slot AS _UNSIGNED LONG
            slot = bank * __OPAL_OPERATORS_PER_BANK + row * 6 + column
            __Opal_OperatorWrite self, slot, addr AND &HE0, valByte
        END IF
    ELSEIF reg = __OPAL_RHYTHM_REGISTER THEN
        __Opal_WriteRhythm self, valByte
    ELSEIF addr < &HD0 AND (addr AND &H0F) < __OPAL_CHANNELS_PER_BANK THEN
        DIM ch AS _UNSIGNED LONG
        ch = bank * __OPAL_CHANNELS_PER_BANK + (addr AND &H0F)
        DIM group AS _UNSIGNED LONG
        group = addr AND &HF0
        IF group = &HC0 THEN
            __Opal_ChannelWriteConnection self, ch, valByte
        ELSE
            DIM high AS _BYTE
            high = (group = &HB0)
            __Opal_ChannelWriteFrequency self, ch, high, valByte
        END IF
    END IF
END SUB

SUB __Opal_ApplyQueuedWrite (self AS Opal)
    DIM regNum AS _UNSIGNED INTEGER
    DIM valByte AS _UNSIGNED _BYTE
    regNum = self.queue(self.queueHead).regNum
    valByte = self.queue(self.queueHead).value
    self.queueHead = (self.queueHead + 1) MOD OPAL_WRITEBUF_SIZE
    self.queueCount = self.queueCount - 1
    __Opal_Write self, regNum, valByte
END SUB

FUNCTION __Opal_OperatorPitchChannel~& (self AS Opal, slot AS _UNSIGNED LONG)
    DIM ch AS _UNSIGNED LONG
    ch = __Opal_OperatorOwner(slot)
    IF __Opal_ChannelBorrowsPitch(self, ch) THEN
        __Opal_OperatorPitchChannel = self.chan(ch).pairIndex
    ELSE
        __Opal_OperatorPitchChannel = ch
    END IF
END FUNCTION

FUNCTION __Opal_ChannelKeyScaleAttenuation~& (self AS Opal, ch AS _UNSIGNED LONG)
    DIM attenuation AS LONG
    attenuation = 4 * CLNG(__Opal_KslRom(_SHR(self.chan(ch).fNumber, 6))) - 32 * (8 - self.chan(ch).block)
    IF attenuation > 0 THEN
        __Opal_ChannelKeyScaleAttenuation = attenuation
    ELSE
        __Opal_ChannelKeyScaleAttenuation = 0
    END IF
END FUNCTION

FUNCTION __Opal_OperatorKeyScaleLevel~& (self AS Opal, slot AS _UNSIGNED LONG, pitchCh AS _UNSIGNED LONG)
    DIM full AS _UNSIGNED LONG
    full = __Opal_ChannelKeyScaleAttenuation(self, pitchCh)

    SELECT CASE self.op(slot).keyScaleLevel
        CASE 1
            __Opal_OperatorKeyScaleLevel = full \ 2
        CASE 2
            __Opal_OperatorKeyScaleLevel = full \ 4
        CASE 3
            __Opal_OperatorKeyScaleLevel = full
        CASE ELSE
            __Opal_OperatorKeyScaleLevel = 0
    END SELECT
END FUNCTION

SUB __Opal_EnvelopeTime (self AS Opal, time AS __OpalEnvelopeTime)
    DIM pairs AS _UNSIGNED _INTEGER64
    pairs = _SHR(self.chipSamples, 1)

    time.odd = (self.chipSamples AND 1) <> 0
    IF pairs < 2 THEN
        time.count = 0
    ELSE
        time.count = ((pairs - 2) MOD __OPAL_ENVELOPE_PERIOD) + 1
    END IF
END SUB

FUNCTION __Opal_EnvelopeSlowStepDue% (count AS _UNSIGNED _INTEGER64, group AS _UNSIGNED LONG, fraction AS _UNSIGNED LONG)
    DIM period AS _UNSIGNED _INTEGER64
    period = _SHL(1~&&, 12 - group)

    IF (count MOD period) = (period \ 2) THEN
        __Opal_EnvelopeSlowStepDue = -1
        EXIT FUNCTION
    END IF
    IF (fraction AND 2) <> 0 THEN
        IF (count MOD (2 * period)) = period THEN
            __Opal_EnvelopeSlowStepDue = -1
            EXIT FUNCTION
        END IF
    END IF
    IF (fraction AND 1) <> 0 THEN
        IF (count MOD (4 * period)) = (2 * period) THEN
            __Opal_EnvelopeSlowStepDue = -1
            EXIT FUNCTION
        END IF
    END IF
    __Opal_EnvelopeSlowStepDue = 0
END FUNCTION

FUNCTION __Opal_OperatorEnvelopeSpeed~& (regRate AS _UNSIGNED LONG, actRate AS _UNSIGNED LONG, time AS __OpalEnvelopeTime)
    DIM fraction AS _UNSIGNED LONG
    fraction = actRate AND 3

    IF regRate = 0 THEN
        __Opal_OperatorEnvelopeSpeed = 0
        EXIT FUNCTION
    END IF
    IF actRate >= __OPAL_RATE_INSTANT THEN
        __Opal_OperatorEnvelopeSpeed = 4
        EXIT FUNCTION
    END IF
    IF actRate >= __OPAL_RATE_FAST THEN
        DIM pairPos AS _UNSIGNED LONG
        pairPos = time.count AND 3
        DIM spread AS _UNSIGNED LONG
        spread = _SHL(pairPos AND 1, 1) OR _SHR(pairPos, 1)
        DIM baseUnit AS _UNSIGNED LONG
        IF spread < fraction THEN baseUnit = 2 ELSE baseUnit = 1
        DIM pairUnits AS _UNSIGNED LONG
        pairUnits = _SHL(baseUnit, _SHR(actRate - __OPAL_RATE_FAST, 2))
        DIM oddBit AS _UNSIGNED LONG
        IF time.odd <> 0 THEN oddBit = pairUnits AND 1 ELSE oddBit = 0
        __Opal_OperatorEnvelopeSpeed = _SHR(pairUnits, 1) OR oddBit
        EXIT FUNCTION
    END IF
    IF time.odd <> 0 THEN
        IF __Opal_EnvelopeSlowStepDue(time.count, _SHR(actRate, 2), fraction) THEN
            __Opal_OperatorEnvelopeSpeed = 1
            EXIT FUNCTION
        END IF
    END IF
    __Opal_OperatorEnvelopeSpeed = 0
END FUNCTION

FUNCTION __Opal_OperatorEnvelope% (self AS Opal, slot AS _UNSIGNED LONG, pitchCh AS _UNSIGNED LONG, time AS __OpalEnvelopeTime)
    DIM keyActive AS _BYTE
    keyActive = (self.op(slot).key <> 0)
    DIM stage AS LONG
    stage = self.op(slot).envelopeStage
    DIM keyOn AS _BYTE
    keyOn = (keyActive AND (stage = OPAL_ENVELOPE_STAGE_RELEASE))
    DIM level AS _UNSIGNED LONG
    level = self.op(slot).envelope
    DIM rate AS _UNSIGNED LONG
    rate = self.op(slot).releaseRate

    IF keyOn OR stage = OPAL_ENVELOPE_STAGE_ATTACK THEN
        rate = self.op(slot).attackRate
    ELSEIF stage = OPAL_ENVELOPE_STAGE_DECAY THEN
        rate = self.op(slot).decayRate
    ELSEIF stage = OPAL_ENVELOPE_STAGE_SUSTAIN AND self.op(slot).sustainHold <> 0 THEN
        rate = 0
    END IF

    DIM keyScale AS _UNSIGNED LONG
    keyScale = self.chan(pitchCh).latchedKeyScaleNumber
    DIM rateOffset AS _UNSIGNED LONG
    IF self.op(slot).keyScaleRate <> 0 THEN
        rateOffset = keyScale
    ELSE
        rateOffset = _SHR(keyScale, 2)
    END IF
    DIM actualRate AS _UNSIGNED LONG
    actualRate = 4 * rate + rateOffset
    DIM instant AS _BYTE
    instant = (actualRate >= __OPAL_RATE_INSTANT)
    DIM speed AS _UNSIGNED LONG
    speed = __Opal_OperatorEnvelopeSpeed(rate, actualRate, time)
    DIM sustainBand AS _UNSIGNED LONG
    IF self.op(slot).sustainLevel = 15 THEN
        sustainBand = 31
    ELSE
        sustainBand = self.op(slot).sustainLevel
    END IF
    DIM offZone AS _BYTE
    offZone = (level >= __OPAL_ENVELOPE_OFF_ZONE)

    IF keyOn THEN
        IF instant THEN
            level = 0
        END IF
        stage = OPAL_ENVELOPE_STAGE_ATTACK
    ELSEIF stage = OPAL_ENVELOPE_STAGE_ATTACK THEN
        IF level = 0 THEN
            stage = OPAL_ENVELOPE_STAGE_DECAY
        ELSEIF keyActive AND (NOT instant) THEN
            DIM decr AS _UNSIGNED LONG
            decr = _SHR(speed * (level + 1) + 7, 3)
            IF decr > level THEN
                level = 0
            ELSE
                level = level - decr
            END IF
        END IF
    ELSEIF stage = OPAL_ENVELOPE_STAGE_DECAY AND (_SHR(level, 4) = sustainBand) THEN
        IF offZone THEN
            level = __OPAL_ENVELOPE_SILENT
        END IF
        stage = OPAL_ENVELOPE_STAGE_SUSTAIN
    ELSEIF offZone THEN
        level = __OPAL_ENVELOPE_SILENT
    ELSE
        level = level + speed
        IF level > __OPAL_ENVELOPE_SILENT THEN level = __OPAL_ENVELOPE_SILENT
    END IF

    IF NOT keyActive THEN
        stage = OPAL_ENVELOPE_STAGE_RELEASE
    END IF

    self.op(slot).envelope = level
    self.op(slot).envelopeStage = stage
    __Opal_OperatorEnvelope = keyOn
END FUNCTION

FUNCTION __Opal_OperatorIncrement~& (self AS Opal, slot AS _UNSIGNED LONG, pitchCh AS _UNSIGNED LONG)
    DIM fNum AS LONG
    fNum = self.chan(pitchCh).fNumber

    IF self.op(slot).vibrato <> 0 THEN
        DIM fNumHigh AS LONG
        fNumHigh = _SHR(fNum, 7)
        DIM depthShift AS LONG
        IF self.vibratoDepth <> 0 THEN depthShift = 0 ELSE depthShift = 1
        DIM posIdx AS _UNSIGNED LONG
        posIdx = _SHR(self.sampleCounter, 10) AND 7
        DIM magnitude AS LONG
        magnitude = _SHR(_SHR(fNumHigh * CLNG(__Opal_VibratoSteps(posIdx).halves), 1), depthShift)
        IF __Opal_VibratoSteps(posIdx).negative <> 0 THEN
            fNum = fNum - magnitude
        ELSE
            fNum = fNum + magnitude
        END IF
    END IF

    DIM baseVal AS _UNSIGNED LONG
    baseVal = _SHR(_SHL(fNum, self.chan(pitchCh).block), 1)
    __Opal_OperatorIncrement = _SHR(baseVal * __Opal_MulTimes2(self.op(slot).multiple), 1)
END FUNCTION

FUNCTION __Opal_CymbalBit~& (self AS Opal)
    DIM hat AS _UNSIGNED LONG
    hat = self.hiHatPhase
    DIM cymbal AS _UNSIGNED LONG
    cymbal = self.cymbalPhase
    DIM t1 AS _UNSIGNED LONG, t2 AS _UNSIGNED LONG, t3 AS _UNSIGNED LONG
    t1 = _SHR(hat, 2) XOR _SHR(hat, 7)
    t2 = _SHR(hat, 3) XOR _SHR(cymbal, 5)
    t3 = _SHR(cymbal, 3) XOR _SHR(cymbal, 5)
    __Opal_CymbalBit = (t1 OR t2 OR t3) AND 1
END FUNCTION

FUNCTION __Opal_RhythmPhase~& (self AS Opal, slot AS _UNSIGNED LONG, phase AS _UNSIGNED LONG, noiseBit AS _UNSIGNED LONG)
    IF slot = __OPAL_HI_HAT_SLOT THEN
        DIM cymbalBit AS _UNSIGNED LONG
        cymbalBit = __Opal_CymbalBit(self)
        DIM hiHatConst AS _UNSIGNED LONG
        IF (cymbalBit XOR noiseBit) <> 0 THEN
            hiHatConst = __OPAL_HI_HAT_PHASE_NOISY
        ELSE
            hiHatConst = __OPAL_HI_HAT_PHASE_QUIET
        END IF
        __Opal_RhythmPhase = _SHL(cymbalBit, 9) OR hiHatConst
        EXIT FUNCTION
    END IF
    IF slot = __OPAL_SNARE_SLOT THEN
        DIM hatBit AS _UNSIGNED LONG
        hatBit = _SHR(self.hiHatPhase, 8) AND 1
        __Opal_RhythmPhase = _SHL(hatBit, 9) OR _SHL(hatBit XOR noiseBit, 8)
        EXIT FUNCTION
    END IF
    IF slot = __OPAL_CYMBAL_SLOT THEN
        self.cymbalPhase = phase AND &HFFFF~%
        __Opal_RhythmPhase = _SHL(__Opal_CymbalBit(self), 9) OR __OPAL_CYMBAL_PHASE
        EXIT FUNCTION
    END IF
    __Opal_RhythmPhase = phase
END FUNCTION

SUB __Opal_OperatorWave (phase AS _UNSIGNED LONG, waveform AS _UNSIGNED LONG, wave AS __OpalWave)
    DIM secondHalf AS _BYTE
    secondHalf = ((phase AND &H200) <> 0)
    DIM secondQuarter AS _BYTE
    secondQuarter = ((phase AND &H100) <> 0)
    DIM halfPos AS _UNSIGNED LONG
    halfPos = phase AND &H1FF
    DIM quarterPos AS _UNSIGNED LONG
    quarterPos = phase AND &HFF
    DIM sineIndex AS _UNSIGNED LONG
    IF secondQuarter THEN sineIndex = &HFF - quarterPos ELSE sineIndex = quarterPos
    DIM sine AS _UNSIGNED INTEGER
    sine = __Opal_LogSinTable(sineIndex)
    DIM eighthPos AS _UNSIGNED LONG
    eighthPos = 2 * (phase AND &H7F)
    DIM fastSineIndex AS _UNSIGNED LONG
    IF (phase AND &H80) <> 0 THEN fastSineIndex = 254 - eighthPos ELSE fastSineIndex = eighthPos
    DIM fastSine AS _UNSIGNED INTEGER
    fastSine = __Opal_LogSinTable(fastSineIndex)

    wave.attenuation = 0
    wave.negative = 0
    wave.silent = 0

    SELECT CASE waveform
        CASE 0
            wave.attenuation = sine
            wave.negative = secondHalf
        CASE 1
            wave.attenuation = sine
            wave.silent = secondHalf
        CASE 2
            wave.attenuation = sine
        CASE 3
            wave.attenuation = __Opal_LogSinTable(quarterPos)
            wave.silent = secondQuarter
        CASE 4
            wave.attenuation = fastSine
            wave.negative = ((NOT secondHalf) AND secondQuarter)
            wave.silent = secondHalf
        CASE 5
            wave.attenuation = fastSine
            wave.silent = secondHalf
        CASE 6
            wave.negative = secondHalf
        CASE ELSE
            IF secondHalf THEN
                wave.attenuation = 8 * (&H1FF - halfPos)
            ELSE
                wave.attenuation = 8 * halfPos
            END IF
            wave.negative = secondHalf
    END SELECT
END SUB

FUNCTION __Opal_OperatorOutput% (wave AS __OpalWave, attenuation AS _UNSIGNED LONG)
    IF wave.silent <> 0 THEN
        __Opal_OperatorOutput = 0
        EXIT FUNCTION
    END IF

    DIM level AS _UNSIGNED LONG
    level = wave.attenuation + 8 * attenuation
    DIM magnitude AS LONG
    magnitude = 0
    IF level < __OPAL_AUDIBLE_LEVEL_LIMIT THEN
        DIM mantissa AS _UNSIGNED LONG
        mantissa = __OPAL_EXPONENT_IMPLICIT_ONE + __Opal_ExponentRom(&HFF - (level AND &HFF))
        magnitude = _SHR(2 * mantissa, _SHR(level, 8))
    END IF
    IF wave.negative <> 0 THEN
        __Opal_OperatorOutput = -magnitude - 1
    ELSE
        __Opal_OperatorOutput = magnitude
    END IF
END FUNCTION

FUNCTION __Opal_OperatorModulation& (self AS Opal, slot AS _UNSIGNED LONG)
    DIM chOwner AS _UNSIGNED LONG
    chOwner = __Opal_OperatorOwner(slot)
    DIM algoIdx AS _UNSIGNED LONG
    algoIdx = self.chan(chOwner).algorithm
    DIM position AS _UNSIGNED LONG
    position = __Opal_OperatorVoicePosition(self, slot)

    IF position = 0 AND __Opal_Algorithms(algoIdx).selfFeedback <> 0 THEN
        IF self.chan(chOwner).feedback = 0 THEN
            __Opal_OperatorModulation = 0
            EXIT FUNCTION
        END IF
        DIM sumOut AS LONG
        sumOut = CLNG(self.op(slot).out) + self.op(slot).prevOut
        __Opal_OperatorModulation = __Opal_FloorShift(sumOut, 9 - self.chan(chOwner).feedback)
        EXIT FUNCTION
    END IF
    IF (_SHR(__Opal_Algorithms(algoIdx).chainMask, position) AND 1) <> 0 THEN
        __Opal_OperatorModulation = self.op(slot - __OPAL_VOICE_STRIDE).out
        EXIT FUNCTION
    END IF
    __Opal_OperatorModulation = 0
END FUNCTION

SUB __Opal_OperatorTurn (self AS Opal, slot AS _UNSIGNED LONG, time AS __OpalEnvelopeTime)
    DIM pitchCh AS _UNSIGNED LONG
    pitchCh = __Opal_OperatorPitchChannel(self, slot)

    DIM attenuation AS _UNSIGNED LONG
    attenuation = self.op(slot).envelope + 4 * CLNG(self.op(slot).totalLevel) + __Opal_OperatorKeyScaleLevel(self, slot, pitchCh)
    IF self.op(slot).tremolo <> 0 THEN
        attenuation = attenuation + self.tremoloLevel
    END IF
    self.op(slot).egOut = attenuation AND &HFFFF~%

    DIM restart AS _BYTE
    restart = __Opal_OperatorEnvelope(self, slot, pitchCh, time)

    DIM phase AS _UNSIGNED LONG
    phase = _SHR(self.op(slot).phase, 9) AND &HFFFF~%
    DIM incr AS _UNSIGNED LONG
    incr = __Opal_OperatorIncrement(self, slot, pitchCh)
    IF restart THEN
        self.op(slot).phase = incr
    ELSE
        self.op(slot).phase = self.op(slot).phase + incr
    END IF

    DIM noiseBit AS _UNSIGNED LONG
    noiseBit = self.noise AND 1
    DIM feedbackBit AS _UNSIGNED LONG
    feedbackBit = (self.noise XOR _SHR(self.noise, 14)) AND 1
    self.noise = _SHR(self.noise, 1) OR _SHL(feedbackBit, 22)

    IF slot = __OPAL_HI_HAT_SLOT THEN
        self.hiHatPhase = phase AND &HFFFF~%
    END IF
    IF self.rhythmMode <> 0 THEN
        phase = __Opal_RhythmPhase(self, slot, phase, noiseBit)
    END IF

    DIM modulation AS LONG
    modulation = __Opal_OperatorModulation(self, slot)
    DIM finalPhase AS _UNSIGNED LONG
    finalPhase = (CLNG(phase) + modulation) AND &H3FF

    DIM wave AS __OpalWave
    __Opal_OperatorWave finalPhase, self.op(slot).waveform, wave

    self.op(slot).prevOut = self.op(slot).out
    self.op(slot).out = __Opal_OperatorOutput(wave, attenuation)
END SUB

FUNCTION __Opal_ChannelVoiceSum& (self AS Opal, ch AS _UNSIGNED LONG)
    IF NOT __Opal_ChannelCarriesVoice(self, ch) THEN
        __Opal_ChannelVoiceSum = 0
        EXIT FUNCTION
    END IF

    DIM algoIdx AS _UNSIGNED LONG
    algoIdx = self.chan(ch).algorithm
    DIM baseVal AS _UNSIGNED LONG
    baseVal = __Opal_ChannelVoiceBase(self, ch)
    DIM sum AS LONG
    sum = 0

    DIM posIdx AS _UNSIGNED LONG
    FOR posIdx = 0 TO __Opal_Algorithms(algoIdx).operatorCount - 1
        IF (_SHR(__Opal_Algorithms(algoIdx).carrierMask, posIdx) AND 1) <> 0 THEN
            sum = sum + self.op(baseVal + __OPAL_VOICE_STRIDE * posIdx).out
        END IF
    NEXT posIdx

    __Opal_ChannelVoiceSum = sum * __Opal_Algorithms(algoIdx).gain
END FUNCTION

FUNCTION __Opal_Mix& (self AS Opal, side AS _UNSIGNED LONG)
    DIM sum AS LONG
    sum = 0
    DIM ch AS _UNSIGNED LONG
    FOR ch = 0 TO OPAL_CHANNEL_COUNT - 1
        IF (_SHR(self.chan(ch).outputEnable, side) AND 1) <> 0 THEN
            DIM gain AS LONG
            IF side <> 0 THEN gain = self.chan(ch).rightPan ELSE gain = self.chan(ch).leftPan
            DIM vSum AS LONG
            vSum = __Opal_ChannelVoiceSum(self, ch)
            sum = sum + __Opal_FloorShift(vSum * gain, 8)
        END IF
    NEXT ch
    __Opal_Mix = sum
END FUNCTION

SUB __Opal_CloseSample (self AS Opal)
    self.sampleCounter = (self.sampleCounter + 1) AND &HFFFF~%
    IF (self.sampleCounter AND 63) = 0 THEN
        self.tremoloPosition = (self.tremoloPosition + 1) MOD __OPAL_TREMOLO_STEPS
    END IF
    DIM posIdx AS _UNSIGNED LONG
    posIdx = self.tremoloPosition
    DIM triangle AS _UNSIGNED LONG
    IF posIdx < __OPAL_TREMOLO_PEAK THEN
        triangle = posIdx
    ELSE
        triangle = __OPAL_TREMOLO_STEPS - posIdx
    END IF
    DIM shiftAmount AS LONG
    IF self.tremoloDepth <> 0 THEN shiftAmount = 2 ELSE shiftAmount = 4
    self.tremoloLevel = _SHR(triangle, shiftAmount)

    IF (self.sampleCounter AND 3) = 0 THEN
        __Opal_TickTimer self, 0
    END IF
    IF (self.sampleCounter AND 15) = 0 THEN
        __Opal_TickTimer self, 1
    END IF

    DO WHILE self.queueCount > 0 AND self.queue(self.queueHead).due <= self.chipSamples
        __Opal_ApplyQueuedWrite self
    LOOP
    self.chipSamples = self.chipSamples + 1
END SUB

SUB __Opal_Output (self AS Opal, left AS INTEGER, right AS INTEGER)
    DIM time_odd AS _BYTE
    DIM time_count AS _UNSIGNED _INTEGER64
    DIM pairs AS _UNSIGNED _INTEGER64
    pairs = _SHR(self.chipSamples, 1)
    time_odd = (self.chipSamples AND 1) <> 0
    IF pairs < 2 THEN
        time_count = 0
    ELSE
        time_count = ((pairs - 2) MOD __OPAL_ENVELOPE_PERIOD) + 1
    END IF

    DIM leftSum AS LONG: leftSum = 0
    DIM rightSum AS LONG: rightSum = 0

    DIM slot AS LONG
    FOR slot = 0 TO OPAL_OPERATOR_COUNT - 1
        DIM keyActive AS _BYTE: keyActive = (self.op(slot).key <> 0)
        DIM stage AS LONG: stage = self.op(slot).envelopeStage
        DIM level AS _UNSIGNED LONG: level = self.op(slot).envelope

        ' Fast path: inactive silent operator
        IF (NOT keyActive) AND (stage = OPAL_ENVELOPE_STAGE_RELEASE) AND (level >= __OPAL_ENVELOPE_SILENT) THEN
            self.op(slot).out = 0
            self.op(slot).prevOut = 0
            GOTO __Opal_SkipSlot
        END IF

        DIM chOwner AS LONG: chOwner = __Opal_OperatorOwner(slot)
        DIM pitchCh AS LONG
        IF __Opal_ChannelBorrowsPitch(self, chOwner) THEN
            pitchCh = self.chan(chOwner).pairIndex
        ELSE
            pitchCh = chOwner
        END IF

        ' Key scale level inlined
        DIM kslAtten AS LONG
        kslAtten = 4 * CLNG(__Opal_KslRom(_SHR(self.chan(pitchCh).fNumber, 6))) - 32 * (8 - self.chan(pitchCh).block)
        IF kslAtten < 0 THEN kslAtten = 0
        DIM kslLevel AS LONG
        SELECT CASE self.op(slot).keyScaleLevel
            CASE 1: kslLevel = kslAtten \ 2
            CASE 2: kslLevel = kslAtten \ 4
            CASE 3: kslLevel = kslAtten
            CASE ELSE: kslLevel = 0
        END SELECT

        DIM attenuation AS _UNSIGNED LONG
        attenuation = level + 4 * CLNG(self.op(slot).totalLevel) + kslLevel
        IF self.op(slot).tremolo <> 0 THEN attenuation = attenuation + self.tremoloLevel
        self.op(slot).egOut = attenuation AND &HFFFF~%

        ' Operator envelope inlined
        DIM keyOn AS _BYTE: keyOn = (keyActive AND (stage = OPAL_ENVELOPE_STAGE_RELEASE))
        DIM rate AS _UNSIGNED LONG: rate = self.op(slot).releaseRate

        IF keyOn OR stage = OPAL_ENVELOPE_STAGE_ATTACK THEN
            rate = self.op(slot).attackRate
        ELSEIF stage = OPAL_ENVELOPE_STAGE_DECAY THEN
            rate = self.op(slot).decayRate
        ELSEIF stage = OPAL_ENVELOPE_STAGE_SUSTAIN AND self.op(slot).sustainHold <> 0 THEN
            rate = 0
        END IF

        DIM keyScale AS _UNSIGNED LONG: keyScale = self.chan(pitchCh).latchedKeyScaleNumber
        DIM rateOffset AS _UNSIGNED LONG
        IF self.op(slot).keyScaleRate <> 0 THEN rateOffset = keyScale ELSE rateOffset = _SHR(keyScale, 2)
        DIM actualRate AS _UNSIGNED LONG: actualRate = 4 * rate + rateOffset
        DIM instant AS _BYTE: instant = (actualRate >= __OPAL_RATE_INSTANT)

        ' Envelope speed inlined
        DIM speed AS _UNSIGNED LONG: speed = 0
        IF rate > 0 THEN
            IF actualRate >= __OPAL_RATE_INSTANT THEN
                speed = 4
            ELSEIF actualRate >= __OPAL_RATE_FAST THEN
                DIM pairPos AS _UNSIGNED LONG: pairPos = time_count AND 3
                DIM spread AS _UNSIGNED LONG: spread = _SHL(pairPos AND 1, 1) OR _SHR(pairPos, 1)
                DIM baseUnit AS _UNSIGNED LONG
                IF spread < (actualRate AND 3) THEN baseUnit = 2 ELSE baseUnit = 1
                DIM pairUnits AS _UNSIGNED LONG: pairUnits = _SHL(baseUnit, _SHR(actualRate - __OPAL_RATE_FAST, 2))
                DIM oddBit AS _UNSIGNED LONG
                IF time_odd <> 0 THEN oddBit = pairUnits AND 1 ELSE oddBit = 0
                speed = _SHR(pairUnits, 1) OR oddBit
            ELSEIF time_odd <> 0 THEN
                DIM grp AS LONG: grp = _SHR(actualRate, 2)
                DIM frac AS LONG: frac = actualRate AND 3
                DIM period AS _UNSIGNED _INTEGER64: period = _SHL(1~&&, 12 - grp)
                DIM due AS _BYTE: due = 0
                IF (time_count MOD period) = (period \ 2) THEN
                    due = -1
                ELSEIF (frac AND 2) <> 0 AND (time_count MOD (2 * period)) = period THEN
                    due = -1
                ELSEIF (frac AND 1) <> 0 AND (time_count MOD (4 * period)) = (2 * period) THEN
                    due = -1
                END IF
                IF due THEN speed = 1
            END IF
        END IF

        DIM sustainBand AS _UNSIGNED LONG
        IF self.op(slot).sustainLevel = 15 THEN sustainBand = 31 ELSE sustainBand = self.op(slot).sustainLevel
        DIM offZone AS _BYTE: offZone = (level >= __OPAL_ENVELOPE_OFF_ZONE)

        IF keyOn THEN
            IF instant THEN level = 0
            stage = OPAL_ENVELOPE_STAGE_ATTACK
        ELSEIF stage = OPAL_ENVELOPE_STAGE_ATTACK THEN
            IF level = 0 THEN
                stage = OPAL_ENVELOPE_STAGE_DECAY
            ELSEIF keyActive AND (NOT instant) THEN
                DIM decr AS _UNSIGNED LONG: decr = _SHR(speed * (level + 1) + 7, 3)
                IF decr > level THEN level = 0 ELSE level = level - decr
            END IF
        ELSEIF stage = OPAL_ENVELOPE_STAGE_DECAY AND (_SHR(level, 4) >= sustainBand) THEN
            IF offZone THEN level = __OPAL_ENVELOPE_SILENT
            stage = OPAL_ENVELOPE_STAGE_SUSTAIN
        ELSEIF offZone THEN
            level = __OPAL_ENVELOPE_SILENT
        ELSE
            level = level + speed
            IF level > __OPAL_ENVELOPE_SILENT THEN level = __OPAL_ENVELOPE_SILENT
        END IF

        IF NOT keyActive THEN stage = OPAL_ENVELOPE_STAGE_RELEASE
        self.op(slot).envelope = level
        self.op(slot).envelopeStage = stage

        ' Operator increment inlined
        DIM fNum AS LONG: fNum = self.chan(pitchCh).fNumber
        IF self.op(slot).vibrato <> 0 THEN
            DIM fNumHigh AS LONG: fNumHigh = _SHR(fNum, 7)
            DIM depthShift AS LONG: IF self.vibratoDepth <> 0 THEN depthShift = 0 ELSE depthShift = 1
            DIM vibPosIdx AS _UNSIGNED LONG: vibPosIdx = _SHR(self.sampleCounter, 10) AND 7
            DIM magnitude AS LONG: magnitude = _SHR(_SHR(fNumHigh * CLNG(__Opal_VibratoSteps(vibPosIdx).halves), 1), depthShift)
            IF __Opal_VibratoSteps(vibPosIdx).negative <> 0 THEN fNum = fNum - magnitude ELSE fNum = fNum + magnitude
        END IF
        DIM baseVal AS _UNSIGNED LONG: baseVal = _SHR(_SHL(fNum, self.chan(pitchCh).block), 1)
        DIM incr AS _UNSIGNED LONG: incr = _SHR(baseVal * __Opal_MulTimes2(self.op(slot).multiple), 1)

        DIM phase AS _UNSIGNED LONG: phase = _SHR(self.op(slot).phase, 9) AND &HFFFF~%
        IF keyOn THEN self.op(slot).phase = incr ELSE self.op(slot).phase = self.op(slot).phase + incr

        DIM noiseBit AS _UNSIGNED LONG: noiseBit = self.noise AND 1
        DIM feedbackBit AS _UNSIGNED LONG: feedbackBit = (self.noise XOR _SHR(self.noise, 14)) AND 1
        self.noise = _SHR(self.noise, 1) OR _SHL(feedbackBit, 22)

        IF slot = __OPAL_HI_HAT_SLOT THEN self.hiHatPhase = phase AND &HFFFF~%

        IF self.rhythmMode <> 0 THEN
            IF slot = __OPAL_HI_HAT_SLOT THEN
                DIM cymBit AS _UNSIGNED LONG: cymBit = __Opal_CymbalBit(self)
                DIM hiHatConst AS _UNSIGNED LONG
                IF (cymBit XOR noiseBit) <> 0 THEN hiHatConst = __OPAL_HI_HAT_PHASE_NOISY ELSE hiHatConst = __OPAL_HI_HAT_PHASE_QUIET
                phase = _SHL(cymBit, 9) OR hiHatConst
            ELSEIF slot = __OPAL_SNARE_SLOT THEN
                DIM hatBit AS _UNSIGNED LONG: hatBit = _SHR(self.hiHatPhase, 8) AND 1
                phase = _SHL(hatBit, 9) OR _SHL(hatBit XOR noiseBit, 8)
            ELSEIF slot = __OPAL_CYMBAL_SLOT THEN
                self.cymbalPhase = phase AND &HFFFF~%
                phase = _SHL(__Opal_CymbalBit(self), 9) OR __OPAL_CYMBAL_PHASE
            END IF
        END IF

        ' Operator modulation inlined
        DIM modulation AS LONG: modulation = 0
        DIM modSrc AS _UNSIGNED _BYTE: modSrc = self.op(slot).modSource
        IF modSrc = OPAL_MOD_OWN_FB THEN
            IF self.chan(chOwner).feedback <> 0 THEN
                DIM sumOut AS LONG: sumOut = CLNG(self.op(slot).out) + self.op(slot).prevOut
                DIM fbShift AS LONG: fbShift = 9 - self.chan(chOwner).feedback
                IF sumOut >= 0 THEN modulation = _SHR(sumOut, fbShift) ELSE modulation = NOT _SHR(NOT sumOut, fbShift)
            END IF
        ELSEIF modSrc <> OPAL_OP_NONE THEN
            modulation = self.op(modSrc).out
        END IF

        DIM finalPhase AS _UNSIGNED LONG: finalPhase = (CLNG(phase) + modulation) AND &H3FF

        ' Operator wave and output inlined
        DIM secondHalf AS _BYTE: secondHalf = ((finalPhase AND &H200) <> 0)
        DIM secondQuarter AS _BYTE: secondQuarter = ((finalPhase AND &H100) <> 0)
        DIM halfPos AS _UNSIGNED LONG: halfPos = finalPhase AND &H1FF
        DIM quarterPos AS _UNSIGNED LONG: quarterPos = finalPhase AND &HFF
        DIM sineIndex AS _UNSIGNED LONG
        IF secondQuarter THEN sineIndex = &HFF - quarterPos ELSE sineIndex = quarterPos
        DIM sine AS _UNSIGNED INTEGER: sine = __Opal_LogSinTable(sineIndex)
        DIM eighthPos AS _UNSIGNED LONG: eighthPos = 2 * (finalPhase AND &H7F)
        DIM fastSineIndex AS _UNSIGNED LONG
        IF (finalPhase AND &H80) <> 0 THEN fastSineIndex = 254 - eighthPos ELSE fastSineIndex = eighthPos
        DIM fastSine AS _UNSIGNED INTEGER: fastSine = __Opal_LogSinTable(fastSineIndex)

        DIM waveAtten AS _UNSIGNED INTEGER: waveAtten = 0
        DIM waveNegative AS _BYTE: waveNegative = 0
        DIM waveSilent AS _BYTE: waveSilent = 0

        SELECT CASE self.op(slot).waveform
            CASE 0
                waveAtten = sine
                waveNegative = secondHalf
            CASE 1
                waveAtten = sine
                waveSilent = secondHalf
            CASE 2
                waveAtten = sine
            CASE 3
                waveAtten = __Opal_LogSinTable(quarterPos)
                waveSilent = secondQuarter
            CASE 4
                waveAtten = fastSine
                waveNegative = ((NOT secondHalf) AND secondQuarter)
                waveSilent = secondHalf
            CASE 5
                waveAtten = fastSine
                waveSilent = secondHalf
            CASE 6
                waveNegative = secondHalf
            CASE ELSE
                IF secondHalf THEN waveAtten = 8 * (&H1FF - halfPos) ELSE waveAtten = 8 * halfPos
                waveNegative = secondHalf
        END SELECT

        self.op(slot).prevOut = self.op(slot).out
        IF waveSilent <> 0 THEN
            self.op(slot).out = 0
        ELSE
            DIM outLevel AS _UNSIGNED LONG: outLevel = waveAtten + 8 * attenuation
            DIM mag AS LONG: mag = 0
            IF outLevel < __OPAL_AUDIBLE_LEVEL_LIMIT THEN
                DIM mantissa AS _UNSIGNED LONG
                mantissa = __OPAL_EXPONENT_IMPLICIT_ONE + __Opal_ExponentRom(&HFF - (outLevel AND &HFF))
                mag = _SHR(2 * mantissa, _SHR(outLevel, 8))
            END IF
            IF waveNegative <> 0 THEN self.op(slot).out = -mag - 1 ELSE self.op(slot).out = mag
        END IF

        __Opal_SkipSlot:
        ' Channel mixing inlined at designated slots
        IF slot = __OPAL_LEFT_SUM_SLOT THEN
            DIM chL AS LONG
            FOR chL = 0 TO OPAL_CHANNEL_COUNT - 1
                IF (self.chan(chL).outputEnable AND 1) <> 0 THEN
                    DIM vSumL AS LONG: vSumL = 0
                    DIM algoIdxL AS LONG: algoIdxL = self.chan(chL).algorithm
                    DIM kL AS LONG
                    FOR kL = 0 TO 3
                        DIM srcL AS _UNSIGNED _BYTE: srcL = self.chan(chL).outSource(kL)
                        IF srcL = OPAL_OP_NONE THEN EXIT FOR
                        vSumL = vSumL + self.op(srcL).out
                    NEXT kL
                    vSumL = vSumL * __Opal_Algorithms(algoIdxL).gain
                    DIM prodL AS LONG: prodL = vSumL * self.chan(chL).leftPan
                    IF prodL >= 0 THEN leftSum = leftSum + _SHR(prodL, 8) ELSE leftSum = leftSum + (NOT _SHR(NOT prodL, 8))
                END IF
            NEXT chL
        ELSEIF slot = __OPAL_RIGHT_SUM_SLOT THEN
            DIM chR AS LONG
            FOR chR = 0 TO OPAL_CHANNEL_COUNT - 1
                IF (self.chan(chR).outputEnable AND 2) <> 0 THEN
                    DIM vSumR AS LONG: vSumR = 0
                    DIM algoIdxR AS LONG: algoIdxR = self.chan(chR).algorithm
                    DIM kR AS LONG
                    FOR kR = 0 TO 3
                        DIM srcR AS _UNSIGNED _BYTE: srcR = self.chan(chR).outSource(kR)
                        IF srcR = OPAL_OP_NONE THEN EXIT FOR
                        vSumR = vSumR + self.op(srcR).out
                    NEXT kR
                    vSumR = vSumR * __Opal_Algorithms(algoIdxR).gain
                    DIM prodR AS LONG: prodR = vSumR * self.chan(chR).rightPan
                    IF prodR >= 0 THEN rightSum = rightSum + _SHR(prodR, 8) ELSE rightSum = rightSum + (NOT _SHR(NOT prodR, 8))
                END IF
            NEXT chR
        END IF
    NEXT slot

    IF leftSum > 32767 THEN
        left = 32767
    ELSEIF leftSum < -32768 THEN
        left = -32768
    ELSE
        left = leftSum
    END IF
    IF self.pendingRight > 32767 THEN
        right = 32767
    ELSEIF self.pendingRight < -32768 THEN
        right = -32768
    ELSE
        right = self.pendingRight
    END IF
    self.pendingRight = rightSum

    __Opal_CloseSample self
END SUB

SUB Opal_MixSamples (self AS Opal, buffer() AS SINGLE, frames AS _UNSIGNED LONG, volume AS SINGLE)
    CONST __OPAL_MULTIPLIER_16_TO_32! = 1! / 32768!

    DIM AS SINGLE l, r
    DIM samples AS _UNSIGNED LONG: samples = frames * 2
    DIM scale AS SINGLE: scale = __OPAL_MULTIPLIER_16_TO_32 * volume

    DIM i AS _UNSIGNED LONG
    WHILE i < samples
        DO WHILE self.sampleAccum >= self.sampleRate
            self.lastOutput(0) = self.currOutput(0)
            self.lastOutput(1) = self.currOutput(1)
            __Opal_Output self, self.currOutput(0), self.currOutput(1)
            self.sampleAccum = self.sampleAccum - self.sampleRate
        LOOP

        DIM numer AS _INTEGER64: numer = self.sampleAccum * 65536~&& + (self.sampleRate \ 2)
        DIM fract AS LONG: fract = numer \ self.sampleRate
        DIM diff0 AS _INTEGER64: diff0 = self.currOutput(0) - self.lastOutput(0)
        DIM diff1 AS _INTEGER64: diff1 = self.currOutput(1) - self.lastOutput(1)
        l = self.lastOutput(0) + (diff0 * fract) \ 65536
        r = self.lastOutput(1) + (diff1 * fract) \ 65536

        self.sampleAccum = self.sampleAccum + OPAL_OPL3_SAMPLE_RATE

        buffer(i) = buffer(i) + l * scale
        buffer(i + 1) = buffer(i + 1) + r * scale

        i = i + 2
    WEND
END SUB

SUB Opal_SetSampleRate (self AS Opal, sampleRate AS LONG)
    IF sampleRate <= 0 THEN
        sampleRate = OPAL_OPL3_SAMPLE_RATE
    ELSEIF sampleRate > 2147483647 - OPAL_OPL3_SAMPLE_RATE THEN
        sampleRate = 2147483647 - OPAL_OPL3_SAMPLE_RATE
    END IF

    self.sampleRate = sampleRate
    self.sampleAccum = 0
END SUB

FUNCTION Opal_ReadStatus~%% (self AS Opal)
    Opal_ReadStatus = self.status
END FUNCTION

SUB Opal_SetPan (self AS Opal, channel AS _UNSIGNED INTEGER, pan AS _UNSIGNED _BYTE)
    DIM chanNum AS _UNSIGNED LONG
    IF (channel AND &H100) <> 0 THEN
        chanNum = (channel AND &HFF) + 9
    ELSE
        chanNum = channel AND &HFF
    END IF
    IF chanNum >= OPAL_CHANNEL_COUNT THEN EXIT SUB

    IF pan > 127 THEN pan = 127

    IF pan <= 64 THEN
        self.chan(chanNum).leftPan = 256
    ELSE
        self.chan(chanNum).leftPan = (256 * CLNG(127 - pan)) \ 63
    END IF

    IF pan >= 64 THEN
        self.chan(chanNum).rightPan = 256
    ELSE
        self.chan(chanNum).rightPan = (256 * CLNG(pan)) \ 64
    END IF
END SUB

SUB Opal_Initialize (self AS Opal, sampleRate AS LONG)
    __Opal_InitTables

    DIM empty AS Opal
    self = empty

    DIM ch AS _UNSIGNED LONG
    FOR ch = 0 TO OPAL_CHANNEL_COUNT - 1
        DIM bank AS _UNSIGNED LONG
        bank = ch \ __OPAL_CHANNELS_PER_BANK
        DIM localCh AS _UNSIGNED LONG
        localCh = ch MOD __OPAL_CHANNELS_PER_BANK
        DIM first AS _UNSIGNED LONG
        first = bank * __OPAL_OPERATORS_PER_BANK + (localCh \ 3) * 6 + (localCh MOD 3)
        DIM leads AS _BYTE
        leads = (localCh < 3)

        self.chan(ch).opSlot(0) = first
        self.chan(ch).opSlot(1) = first + 3
        IF leads THEN
            self.chan(ch).opSlot(2) = first + 6
            self.chan(ch).opSlot(3) = first + 9
            self.chan(ch).pairIndex = ch + 3
        ELSE
            self.chan(ch).opSlot(2) = OPAL_OP_NONE
            self.chan(ch).opSlot(3) = OPAL_OP_NONE
            IF localCh < 6 THEN
                self.chan(ch).pairIndex = ch - 3
            ELSE
                self.chan(ch).pairIndex = OPAL_CH_NONE
            END IF
        END IF
        self.chan(ch).leftPan = __OPAL_FULL_GAIN
        self.chan(ch).rightPan = __OPAL_FULL_GAIN
        self.chan(ch).outputEnable = __OPAL_OUTPUT_BOTH_SIDES
    NEXT ch

    DIM slot AS _UNSIGNED LONG
    FOR slot = 0 TO OPAL_OPERATOR_COUNT - 1
        self.op(slot).envelopeStage = OPAL_ENVELOPE_STAGE_RELEASE
        self.op(slot).egOut = __OPAL_ENVELOPE_SILENT
        self.op(slot).envelope = __OPAL_ENVELOPE_SILENT
    NEXT slot

    self.noise = 1
    __Opal_RefreshRouting self
    Opal_SetSampleRate self, sampleRate
END SUB

SUB Opal_Write (self AS Opal, regNum AS _UNSIGNED INTEGER, valByte AS _UNSIGNED _BYTE)
    __Opal_Write self, regNum, valByte
END SUB

SUB Opal_FlushWriteBuffer (self AS Opal)
    DO WHILE self.queueCount > 0
        __Opal_ApplyQueuedWrite self
    LOOP
    self.lastDue = self.chipSamples
END SUB

SUB Opal_WriteBuffered (self AS Opal, regNum AS _UNSIGNED INTEGER, valByte AS _UNSIGNED _BYTE)
    IF self.queueCount >= OPAL_WRITEBUF_SIZE - 1 THEN
        Opal_FlushWriteBuffer self
    END IF

    DIM due AS _UNSIGNED _INTEGER64
    due = self.lastDue + OPAL_WRITEBUF_DELAY
    IF due < self.chipSamples THEN
        due = self.chipSamples
    END IF

    DIM idx AS _UNSIGNED LONG
    idx = (self.queueHead + self.queueCount) MOD OPAL_WRITEBUF_SIZE
    self.queue(idx).due = due
    self.queue(idx).regNum = regNum
    self.queue(idx).value = valByte
    self.queueCount = self.queueCount + 1
    self.lastDue = due
END SUB

$CHECKING:ON

SUB __Opal_InitTables
    IF __Opal_TablesReady THEN EXIT SUB

    DIM i AS LONG

    RESTORE __Opal_LogSinData
    FOR i = 0 TO 255
        READ __Opal_LogSinTable(i)
    NEXT i

    RESTORE __Opal_ExponentData
    FOR i = 0 TO 255
        READ __Opal_ExponentRom(i)
    NEXT i

    RESTORE __Opal_MulData
    FOR i = 0 TO 15
        READ __Opal_MulTimes2(i)
    NEXT i

    RESTORE __Opal_OwnerData
    FOR i = 0 TO 35
        READ __Opal_OperatorOwner(i)
    NEXT i

    RESTORE __Opal_RhythmKeyData
    FOR i = 0 TO 5
        READ __Opal_RhythmKeyBit(i)
    NEXT i

    RESTORE __Opal_VibratoData
    FOR i = 0 TO 7
        READ __Opal_VibratoSteps(i).halves
        READ __Opal_VibratoSteps(i).negative
    NEXT i

    RESTORE __Opal_AlgorithmData
    FOR i = 0 TO 8
        READ __Opal_Algorithms(i).operatorCount
        READ __Opal_Algorithms(i).chainMask
        READ __Opal_Algorithms(i).carrierMask
        READ __Opal_Algorithms(i).gain
        READ __Opal_Algorithms(i).selfFeedback
    NEXT i

    RESTORE __Opal_KslData
    FOR i = 0 TO 15
        READ __Opal_KslRom(i)
    NEXT i

    __Opal_TablesReady = -1

    ' ============================================================================================================
    ' DATA STATEMENTS FOR LOOKUP TABLES
    ' ============================================================================================================

    __Opal_LogSinData:
